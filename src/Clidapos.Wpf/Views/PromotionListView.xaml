<Window x:Class="Clidapos.Wpf.Views.PromotionListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Promotions"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

	<Window.Resources>
		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="SearchInput" TargetType="TextBox">
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#F3A123"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#2A2A32"/>
			<Setter Property="Foreground" Value="#F3A123"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="BorderBrush" Value="#3A3A42"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>

		<Style x:Key="ActionBtn" TargetType="Button">
			<Setter Property="Height" Value="42"/>
			<Setter Property="Background" Value="#F3A123"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource AppOverlay}">
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
				</Button>

				<TextBlock Grid.Column="1" Text="PROMOTIONS" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,0,0,8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="12"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBox Grid.Column="0" x:Name="SearchBox" Style="{StaticResource SearchInput}"
                         TextChanged="SearchBox_TextChanged" Tag="Search promotions..."/>
				<Button Grid.Column="2" Content="➕ New Promotion" Click="NewPromotion_Click"
                        Style="{StaticResource ActionBtn}" Width="170"/>
			</Grid>

			<TextBlock Grid.Row="1" Text="Double-click a promotion to open it for editing."
                       Foreground="#999999" FontSize="12" Margin="2,0,0,12"/>

			<Border Grid.Row="2" Background="#1A1A1F" CornerRadius="8" Padding="16">
				<DataGrid x:Name="PromotionGrid" AutoGenerateColumns="False"
                          Background="#1A1A1F" Foreground="White" BorderThickness="0"
                          RowBackground="#1A1A1F" AlternatingRowBackground="#22222A"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          IsReadOnly="True" SelectionMode="Single"
                          MouseDoubleClick="PromotionGrid_MouseDoubleClick">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Item" Binding="{Binding Dish}" Width="*"/>
						<DataGridTextColumn Header="Special Rate" Binding="{Binding Rate, StringFormat=N2}" Width="130"/>
						<DataGridTextColumn Header="Day" Binding="{Binding PDay}" Width="120"/>
						<DataGridTextColumn Header="From" Binding="{Binding TimeFrom, StringFormat='HH:mm'}" Width="90"/>
						<DataGridTextColumn Header="To" Binding="{Binding TimeTo, StringFormat='HH:mm'}" Width="90"/>
						<DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="80"/>
					</DataGrid.Columns>
				</DataGrid>
			</Border>
		</Grid>
	</Grid>
</Window>