<Window x:Class="Clidapos.Wpf.Views.CustomerAccountPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Customer"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Width="440" Height="520">

	<Border Background="White" CornerRadius="12" BorderBrush="#178E86" BorderThickness="2">
		<Grid Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,0,0,14">
				<TextBlock Text="TRACK CUSTOMER" FontSize="16" FontWeight="Bold" Foreground="#0E5E5A"/>
				<Button Click="Close_Click" HorizontalAlignment="Right" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
					<TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#6B6B72"/>
				</Button>
			</Grid>

			<TextBox Grid.Row="1" x:Name="SearchBox" Background="White" Foreground="Black"
                     BorderBrush="#178E86" BorderThickness="2" Padding="10" FontSize="14"
                     Margin="0,0,0,12" TextChanged="SearchBox_TextChanged"/>

			<ListBox Grid.Row="2" x:Name="ResultsList" Background="#F5F8F8" BorderThickness="1"
                     BorderBrush="#D3DEDE" SelectionChanged="ResultsList_SelectionChanged">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="8,6">
							<StackPanel>
								<TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="Black"/>
								<TextBlock Text="{Binding ContactNo}" FontSize="11" Foreground="#6B6B72"/>
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#C0392B" FontSize="12" FontWeight="Bold"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
		</Grid>
	</Border>
</Window>
