<Window x:Class="Clidapos.Wpf.Views.VoucherDetailPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voucher Detail"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="520" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="Foreground" Value="#4A4A50"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="VoucherNoText" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Width="30" Height="30" Background="Transparent" Foreground="#888888"
                        FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock x:Name="SummaryText" Foreground="#6B6B72" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock Text="LINE ITEMS" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" Height="160"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                          FontSize="12" Foreground="#1C1C1F">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Particulars" Binding="{Binding Particulars}" Width="*"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid>
                <TextBlock Text="GRAND TOTAL" Foreground="#8A8A92" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="GrandTotalText" FontSize="22" FontWeight="Bold"
                           Foreground="#1C1C1F" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>