<Window x:Class="Clidapos.Wpf.Views.BackupSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Setting"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<!-- Local to this popup - the actions here (Backup Now, Save Schedule,
                 Restore) aren't a New/Save/Update/Delete/Get Data set, so they get
                 their own plain colored buttons instead of the floating icon column. -->
			<Style x:Key="ActionBtn" TargetType="Button">
				<Setter Property="Height" Value="42"/>
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="FontSize" Value="13"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="HistoryGridHeader" TargetType="DataGridColumnHeader">
				<Setter Property="Background" Value="#1E1E24"/>
				<Setter Property="Foreground" Value="#F3A123"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="FontSize" Value="11.5"/>
				<Setter Property="Padding" Value="8,8"/>
				<Setter Property="HorizontalContentAlignment" Value="Left"/>
			</Style>

			<Style x:Key="HistoryCellText" TargetType="TextBlock">
				<Setter Property="Padding" Value="8,0"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="Foreground" Value="Black"/>
				<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			</Style>

			<Style x:Key="HistoryGridRow" TargetType="DataGridRow">
				<Setter Property="Background" Value="White"/>
				<Style.Triggers>
					<Trigger Property="AlternationIndex" Value="1">
						<Setter Property="Background" Value="#F7F7F9"/>
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="520">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="BACKUP SETTING" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="90"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Backup Folder" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="FolderInput" Style="{StaticResource PopupInput}" Text="C:\ClidaPos_Backups" Margin="0,0,8,0"/>
							<Button Grid.Column="2" Content="Browse..." Click="Browse_Click" Style="{StaticResource ActionBtn}" Background="#6B6B72" Height="38"/>
						</Grid>
						<TextBlock Text="Must be a folder the SQL Server service itself can write to, not just your Windows account."
                                   Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="130,2,0,14"/>

						<Button Click="BackupNow_Click" Style="{StaticResource ActionBtn}" Background="#28A745" Margin="0,0,0,18">
							<StackPanel Orientation="Horizontal">
								<Image Source="pack://application:,,,/Assets/backup.png" Width="20" Height="20" Margin="0,0,8,0"/>
								<TextBlock x:Name="BackupButtonText" Text="Backup Now"/>
							</StackPanel>
						</Button>

						<!-- SCHEDULE -->
						<Border Background="#F7F7F9" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
							<StackPanel>
								<CheckBox x:Name="AutoEnabledCheck" Content="Enable Automatic Backup"
                                          FontSize="14" FontWeight="Bold" Foreground="#1C1C1F"
                                          Checked="ScheduleChanged" Unchecked="ScheduleChanged" Margin="0,0,0,12"/>

								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="12"/>
										<ColumnDefinition Width="100"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Repeat every (minutes)" Foreground="#4A4A50"
                                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
									<TextBox Grid.Column="2" x:Name="IntervalInput" Style="{StaticResource PopupInput}"
                                             Text="240" TextChanged="ScheduleChanged"/>
								</Grid>
								<TextBlock Text="Minimum 30 minutes - a full database backup takes real time and disk space, and running it too often can slow down checkout during busy hours."
                                           Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>

								<TextBlock x:Name="LastAutoRunText" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,10"/>

								<Button Content="Save Schedule" Click="SaveSchedule_Click" Style="{StaticResource ActionBtn}" Background="#2D6CDF"/>
							</StackPanel>
						</Border>

						<!-- RESTORE -->
						<Border Background="#FFF3F0" BorderBrush="#E8B4A8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
							<StackPanel>
								<TextBlock Text="Restore From Backup" FontSize="14" FontWeight="Bold" Foreground="#8A2E1F" Margin="0,0,0,8"/>
								<TextBlock TextWrapping="Wrap" Foreground="#8A2E1F" FontSize="12" Margin="0,0,0,12">
									This <Run FontWeight="Bold">completely replaces</Run> all current data with whatever is in the selected backup file. Anything saved after that backup was made will be lost. This cannot be undone.
								</TextBlock>

								<Grid Margin="0,0,0,10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="8"/>
										<ColumnDefinition Width="90"/>
									</Grid.ColumnDefinitions>
									<TextBox Grid.Column="0" x:Name="RestoreFileInput" Style="{StaticResource PopupInput}" IsReadOnly="True"/>
									<Button Grid.Column="2" Content="Choose..." Click="BrowseRestoreFile_Click" Style="{StaticResource ActionBtn}" Background="#6B6B72" Height="38"/>
								</Grid>

								<Button x:Name="RestoreBtn" Content="Restore Database" Click="Restore_Click"
                                        Style="{StaticResource ActionBtn}" Background="#B23A2E" IsEnabled="False"/>
							</StackPanel>
						</Border>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>

						<TextBlock Text="Recent Backups" Style="{StaticResource PopupFieldLabel}" Margin="0,4,0,4"/>
						<Border BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
							<DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False"
                                      Background="White" BorderThickness="0"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EDEDF0"
                                      RowHeaderWidth="0" MaxHeight="200"
                                      RowStyle="{StaticResource HistoryGridRow}"
                                      AlternationCount="2"
                                      RowHeight="32" ColumnHeaderHeight="34"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Single" FontSize="12.5">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Date" Binding="{Binding BackupDate, StringFormat='dd MMM yyyy, hh:mm tt'}" Width="150"
                                                         HeaderStyle="{StaticResource HistoryGridHeader}" ElementStyle="{StaticResource HistoryCellText}"/>
									<DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMb, StringFormat=N1}" Width="80"
                                                         HeaderStyle="{StaticResource HistoryGridHeader}" ElementStyle="{StaticResource HistoryCellText}"/>
									<DataGridTextColumn Header="Location" Binding="{Binding PhysicalPath}" Width="*"
                                                         HeaderStyle="{StaticResource HistoryGridHeader}" ElementStyle="{StaticResource HistoryCellText}"/>
								</DataGrid.Columns>
							</DataGrid>
						</Border>

					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

		</StackPanel>
	</Grid>
</Window>
