<Window x:Class="Clidapos.Wpf.Views.BackupSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Setting"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="520" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtnText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="Foreground" Value="#4A4A50"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="BACKUP SETTING" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Width="30" Height="30" Background="Transparent" Foreground="#888888"
                        FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="Backup Folder" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="FolderInput" Style="{StaticResource PopupInput}"
                         Text="C:\ClidaPos_Backups"/>
                <Button Grid.Column="2" Content="Browse..." Click="Browse_Click"
                        Padding="14,0" Background="#6B6B72" Foreground="White" FontWeight="Bold"
                        FontSize="13" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <TextBlock Text="The folder must be writable by the SQL Server service, not just your Windows account."
                       Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <Button Style="{StaticResource IconActionButton}" Background="#F3A123" Click="BackupNow_Click" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="18"/>
                    <TextBlock x:Name="BackupButtonText" Text="Backup Now" Style="{StaticResource IconBtnText}"/>
                </StackPanel>
            </Button>

            <Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="AutoEnabledCheck" Content="Enable Automatic Backup"
                              FontSize="14" FontWeight="Bold" Foreground="#1C1C1F"
                              Checked="ScheduleChanged" Unchecked="ScheduleChanged" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Repeat every (hours)" Foreground="#6B6B72"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="IntervalInput" Style="{StaticResource PopupInput}"
                                 Text="24" TextChanged="ScheduleChanged"/>
                    </Grid>

                    <TextBlock x:Name="LastAutoRunText" Foreground="#8A8A92" FontSize="12" Margin="0,4,0,0"/>

                    <Button Content="Save Schedule" Click="SaveSchedule_Click" Margin="0,10,0,0"
                            Height="36" Background="#2D6CDF" Foreground="White" FontWeight="Bold"
                            FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>

            <TextBlock Text="RECENT BACKUPS" Foreground="#8A8A92" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

            <Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="10">
                <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" Height="200"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                          FontSize="12" Foreground="#1C1C1F">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding BackupDate, StringFormat='dd MMM yyyy, hh:mm tt'}" Width="150"/>
                        <DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMb, StringFormat=N1}" Width="80"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding PhysicalPath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </Border>
</Window>