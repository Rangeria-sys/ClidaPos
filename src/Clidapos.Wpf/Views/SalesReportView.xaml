<Window x:Class="Clidapos.Wpf.Views.SalesReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Sales Report"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

	<Window.Resources>
		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="DateBox" TargetType="DatePicker">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="8"/>
		</Style>

		<Style x:Key="QuickRangeBtn" TargetType="Button">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="Margin" Value="0,0,8,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#E4E4E8"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RunBtn" TargetType="Button">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Background" Value="#F3A123"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#D98F1C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="CardBorder" TargetType="Border">
			<Setter Property="Background" Value="#FAFAFB"/>
			<Setter Property="BorderBrush" Value="#E4E4E8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="20"/>
		</Style>

		<Style x:Key="CardTitle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#8A8A92"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>

		<Style x:Key="RowLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#4A4A50"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="RowValue" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<TextBlock Text="SALES REPORT" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,15,0">

					<Button Click="Back_Click" Style="{StaticResource RoundTopButton}"
                            Margin="0,0,10,0" ToolTip="Back">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Ellipse>
										<Ellipse.Fill>
											<RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
												<GradientStop Color="#FFD98F" Offset="0"/>
												<GradientStop Color="#F3A123" Offset="0.5"/>
												<GradientStop Color="#B5741A" Offset="1"/>
											</RadialGradientBrush>
										</Ellipse.Fill>
										<Ellipse.Effect>
											<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
										</Ellipse.Effect>
									</Ellipse>
									<TextBlock Text="⌂" FontSize="18" FontWeight="Bold" Foreground="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button Click="Minimize_Click" Style="{StaticResource RoundTopButton}" Margin="0,0,10,0"
                            ToolTip="Minimize">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Ellipse>
										<Ellipse.Fill>
											<RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
												<GradientStop Color="#FFE9A6" Offset="0"/>
												<GradientStop Color="#E8B830" Offset="0.4"/>
												<GradientStop Color="#B8860B" Offset="0.85"/>
												<GradientStop Color="#8A6408" Offset="1"/>
											</RadialGradientBrush>
										</Ellipse.Fill>
										<Ellipse.Effect>
											<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
										</Ellipse.Effect>
									</Ellipse>
									<TextBlock Text="—" FontSize="16" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button Click="Exit_Click" Style="{StaticResource RoundTopButton}" ToolTip="Exit">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Ellipse>
										<Ellipse.Fill>
											<RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
												<GradientStop Color="#FF7B8C" Offset="0"/>
												<GradientStop Color="#DC143C" Offset="0.5"/>
												<GradientStop Color="#8F0C25" Offset="1"/>
											</RadialGradientBrush>
										</Ellipse.Fill>
										<Ellipse.Effect>
											<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
										</Ellipse.Effect>
									</Ellipse>
									<Viewbox Width="16" Height="16">
										<Canvas Width="24" Height="24">
											<Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="White" StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
										</Canvas>
									</Viewbox>
								</Grid>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel x:Name="ReportContent" HorizontalAlignment="Center" Margin="0,24,0,30" Width="640">

				<!-- DATE RANGE -->
				<Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="DATE RANGE" Style="{StaticResource CardTitle}"/>
						<Grid Margin="0,6,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="From" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,3"/>
								<DatePicker x:Name="FromDate" Style="{StaticResource DateBox}"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="To" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,3"/>
								<DatePicker x:Name="ToDate" Style="{StaticResource DateBox}"/>
							</StackPanel>
						</Grid>

						<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
							<Button Content="Today" Style="{StaticResource QuickRangeBtn}" Click="Today_Click"/>
							<Button Content="This Week" Style="{StaticResource QuickRangeBtn}" Click="ThisWeek_Click"/>
							<Button Content="This Month" Style="{StaticResource QuickRangeBtn}" Click="ThisMonth_Click"/>
							<Button Content="Run Report" Style="{StaticResource RunBtn}" Click="RunReport_Click"/>
							<Button x:Name="PrintButton" Content="🖨 Print" Style="{StaticResource QuickRangeBtn}"
                                    Margin="0" Click="Print_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<TextBlock x:Name="EmptyText" Text="No sales found for this date range."
                           Foreground="#8A8A92" FontSize="14" HorizontalAlignment="Center"
                           Margin="0,20,0,0" Visibility="Collapsed"/>

				<!-- RESULTS -->
				<StackPanel x:Name="ResultsPanel" Visibility="Collapsed">

					<Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
						<StackPanel>
							<TextBlock Text="TOTAL TAKINGS" Style="{StaticResource CardTitle}"/>
							<TextBlock x:Name="GrandTotalText" Text="0.00" Foreground="#1B8A3D"
                                       FontSize="42" FontWeight="Bold"/>

							<Border Height="1" Background="#E4E4E8" Margin="0,16,0,14"/>

							<Grid Margin="0,0,0,8">
								<TextBlock Text="Sales (bills)" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="BillCountText" Style="{StaticResource RowValue}"/>
							</Grid>
							<Grid Margin="0,0,0,8">
								<TextBlock Text="Items sold" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="ItemCountText" Style="{StaticResource RowValue}"/>
							</Grid>
							<Grid>
								<TextBlock Text="Average sale" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="AverageText" Style="{StaticResource RowValue}"/>
							</Grid>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
						<StackPanel>
							<TextBlock Text="BY PAYMENT METHOD" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
							<Grid Margin="0,0,0,8">
								<TextBlock Text="Cash" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="CashText" Style="{StaticResource RowValue}" Foreground="#1B8A3D"/>
							</Grid>
							<Grid Margin="0,0,0,8">
								<TextBlock Text="M-Pesa" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="MpesaText" Style="{StaticResource RowValue}"/>
							</Grid>
							<Grid Margin="0,0,0,8">
								<TextBlock Text="Card" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="CardText" Style="{StaticResource RowValue}"/>
							</Grid>
							<Grid x:Name="OtherRow" Visibility="Collapsed">
								<TextBlock Text="Other" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="OtherText" Style="{StaticResource RowValue}"/>
							</Grid>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
						<StackPanel>
							<TextBlock Text="TAX" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
							<Grid Margin="0,0,0,8">
								<TextBlock Text="Net of VAT" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="TaxableText" Style="{StaticResource RowValue}"/>
							</Grid>
							<Grid>
								<TextBlock x:Name="VatLabel" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="VatText" Style="{StaticResource RowValue}" Foreground="#F3A123"/>
							</Grid>
						</StackPanel>
					</Border>

					<Border x:Name="TopItemsCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
						<StackPanel>
							<TextBlock Text="TOP SELLERS" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
							<ItemsControl x:Name="TopItemsList">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid Margin="0,6">
											<StackPanel Orientation="Horizontal">
												<TextBlock Text="{Binding Qty, StringFormat=N0}" Foreground="#F3A123"
                                                           FontSize="14" FontWeight="Bold" Width="40"/>
												<TextBlock Text="{Binding Name}" Foreground="#4A4A50" FontSize="14"/>
											</StackPanel>
											<TextBlock Text="{Binding Value, StringFormat=N2}" Foreground="#1C1C1F"
                                                       FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>