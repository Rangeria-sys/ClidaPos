<Window x:Class="Clidapos.Wpf.Views.EmailSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email Server" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Width="440" SizeToContent="Height"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PopupCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,16">
                <TextBlock Text="EMAIL SERVER" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
                </Button>
            </Grid>

            <TextBlock Text="Server Name (label)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ServerNameInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

            <TextBlock Text="From Email Address" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SMTPAddressInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UsernameInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="PasswordInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PortInput" Style="{StaticResource PopupInput}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TLS/SSL Required" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TlsInput" Style="{StaticResource PopupCombo}">
                        <ComboBoxItem Content="Y"/>
                        <ComboBoxItem Content="N"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Default" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="IsDefaultInput" Style="{StaticResource PopupCombo}">
                        <ComboBoxItem Content="Y"/>
                        <ComboBoxItem Content="N"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Active" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="IsActiveInput" Style="{StaticResource PopupCombo}">
                        <ComboBoxItem Content="Y"/>
                        <ComboBoxItem Content="N"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="New" Click="New_Click" Style="{StaticResource ActionBtn}" Background="#6B6B72"/>
                <Button Grid.Column="2" Content="Save" Click="Save_Click" Style="{StaticResource ActionBtn}" Background="#F3A123"/>
                <Button Grid.Column="4" Content="Update" Click="Update_Click" Style="{StaticResource ActionBtn}" Background="#2D6CDF"/>
                <Button Grid.Column="6" Content="Delete" Click="Delete_Click" Style="{StaticResource ActionBtn}" Background="#DC143C"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>