<Window x:Class="Clidapos.Wpf.Views.AccountingReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Accounting Reports"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

	<Window.Resources>
		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="SearchInput" TargetType="TextBox">
			<Setter Property="Background" Value="#F5F5F7"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="Foreground" Value="#4A4A50"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>

		<Style x:Key="ActionBtn" TargetType="Button">
			<Setter Property="Height" Value="42"/>
			<Setter Property="Background" Value="#F3A123"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
				</Button>

				<TextBlock Grid.Column="1" Text="ACCOUNTING REPORTS" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="30,20,30,20" MaxWidth="900" HorizontalAlignment="Stretch">

				<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBox Grid.Column="0" x:Name="SearchBox" Style="{StaticResource SearchInput}"
                                 TextChanged="SearchBox_TextChanged" Tag="Search accounts..."/>
						<Button Grid.Column="2" Content="➕ New Journal Entry" Click="NewEntry_Click"
                                Style="{StaticResource ActionBtn}" Width="190"/>
						<Button Grid.Column="4" Content="📋 All Entries" Click="AllEntries_Click"
                                Style="{StaticResource ActionBtn}" Width="140" Background="#6B6B72"/>
					</Grid>
				</Border>

				<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="10" Padding="20">
					<StackPanel>
						<TextBlock Text="ACCOUNT BALANCES" Foreground="#8A8A92" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
						<TextBlock Text="Double-click an account to see its full ledger activity."
                                   Foreground="#999999" FontSize="12" Margin="0,0,0,14"/>

						<DataGrid x:Name="AccountGrid" AutoGenerateColumns="False"
                                  Background="White" BorderThickness="0"
                                  RowBackground="White" AlternatingRowBackground="#F5F5F7"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeaderWidth="0" Foreground="#1C1C1F"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  IsReadOnly="True" SelectionMode="Single"
                                  MouseDoubleClick="AccountGrid_MouseDoubleClick"
                                  MinHeight="300">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="*"/>
								<DataGridTextColumn Header="Total Debit" Binding="{Binding TotalDebit, StringFormat=N2}" Width="150"/>
								<DataGridTextColumn Header="Total Credit" Binding="{Binding TotalCredit, StringFormat=N2}" Width="150"/>
								<DataGridTextColumn Header="Net Balance" Binding="{Binding NetBalance, StringFormat=N2}" Width="150"/>
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>