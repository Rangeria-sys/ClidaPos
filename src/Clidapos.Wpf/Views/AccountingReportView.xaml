<Window x:Class="Clidapos.Wpf.Views.AccountingReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounting Reports"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F7">

    <Window.Resources>
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#178E86"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3A123"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="Margin" Value="0,0,32,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel>
                            <ContentPresenter HorizontalAlignment="Left" Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="Underline" Height="3" Background="Transparent" CornerRadius="2"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#F3A123"/>
                                <Setter TargetName="Underline" Property="Background" Value="#F3A123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0E5E5A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Back_Click" ToolTip="Back" Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <TextBlock Text="Accounting Reports" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Minimize_Click" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Exit_Click" ToolTip="Exit">
                        <TextBlock Text="✕" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,30" Width="1100">

                <!-- TOOLBAR -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="SearchBox" Height="44" Padding="12" FontSize="14"
                                 Background="#F5F5F7" BorderBrush="#D8D8DE" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" Tag="Search accounts…"/>

                        <DatePicker Grid.Column="2" x:Name="AsOfDate" Width="160" Height="44"/>

                        <Button Grid.Column="4" Content="All Entries" Style="{StaticResource ToolBtn}" Click="AllEntries_Click"/>

                        <Button Grid.Column="6" Content="New Journal Entry" Style="{StaticResource RunBtn}" Click="NewEntry_Click"/>
                    </Grid>
                </Border>

                <!-- SUMMARY BAR -->
                <Border Background="#0E5E5A" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ASSETS" Foreground="#9FE1CB" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="AssetsText" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LIABILITIES" Foreground="#9FE1CB" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="LiabilitiesText" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EQUITY" Foreground="#9FE1CB" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="EquityText" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="INCOME" Foreground="#9FE1CB" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="IncomeText" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="EXPENSES" Foreground="#9FE1CB" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="ExpensesText" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="5" x:Name="BalancedPill" Background="#1E7A75" CornerRadius="8" Padding="16,10" VerticalAlignment="Center">
                            <TextBlock x:Name="BalancedText" Foreground="#9FE1CB" FontWeight="Bold" FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- TABS -->
                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <ToggleButton x:Name="TabTrialBtn" Content="Trial Balance" Style="{StaticResource TabBtn}" IsChecked="True" Click="TabTrial_Click"/>
                    <ToggleButton x:Name="TabLedgerBtn" Content="General Ledger" Style="{StaticResource TabBtn}" Click="TabLedger_Click"/>
                    <ToggleButton x:Name="TabIncomeBtn" Content="Income Statement" Style="{StaticResource TabBtn}" Click="TabIncome_Click"/>
                    <ToggleButton x:Name="TabBalanceBtn" Content="Balance Sheet" Style="{StaticResource TabBtn}" Click="TabBalance_Click"/>
                </StackPanel>
                <Border Height="1" Background="#E4E4E8" Margin="0,0,0,16"/>

                <!-- TAB 1: TRIAL BALANCE -->
                <StackPanel x:Name="TrialBalanceTab">
                    <Border Background="White" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="ACCOUNT BALANCES" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Double-click an account to see its full ledger activity."
                                       Foreground="#8A8A94" FontSize="13" Margin="0,0,0,14"/>

                            <Border Background="#FAFAFB" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Account" Foreground="#8A8A94" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Total Debit" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="Total Credit" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="Net Balance" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="TrialBalanceList"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 2: GENERAL LEDGER -->
                <StackPanel x:Name="GeneralLedgerTab" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="GENERAL LEDGER" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Pick an account to see every transaction posted against it." Foreground="#8A8A94" FontSize="13" Margin="0,0,0,14"/>

                            <ComboBox x:Name="LedgerAccountPicker" Width="320" Height="42" HorizontalAlignment="Left"
                                      Margin="0,0,0,16" SelectionChanged="LedgerAccountPicker_SelectionChanged"/>

                            <Border Background="#FAFAFB" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date" Foreground="#8A8A94" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Ledger No" Foreground="#8A8A94" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="Particulars" Foreground="#8A8A94" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="Debit" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="Credit" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="GeneralLedgerList"/>
                            <TextBlock x:Name="LedgerEmptyText" Text="Pick an account above to see its transactions."
                                       Foreground="#8A8A94" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 3: INCOME STATEMENT -->
                <StackPanel x:Name="IncomeStatementTab" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="INCOME STATEMENT" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Income minus Expenses for all recorded activity." Foreground="#8A8A94" FontSize="13" Margin="0,0,0,16"/>

                            <TextBlock Text="INCOME" Foreground="#1B8A3D" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel x:Name="IncomeList" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Total Income" Foreground="#1C1C1F" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="TotalIncomeText" Foreground="#1B8A3D" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="EXPENSES" Foreground="#C0392B" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel x:Name="ExpenseList" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Total Expenses" Foreground="#1C1C1F" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="TotalExpensesText" Foreground="#C0392B" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="#E4E4E8" Margin="0,0,0,14"/>
                            <Grid>
                                <TextBlock Text="NET INCOME" Foreground="#1C1C1F" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="NetIncomeText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB 4: BALANCE SHEET -->
                <StackPanel x:Name="BalanceSheetTab" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24">
                            <StackPanel>
                                <TextBlock Text="ASSETS" Foreground="#1B8A3D" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <StackPanel x:Name="BsAssetsList" Margin="0,0,0,14"/>
                                <Border Height="1" Background="#E4E4E8" Margin="0,0,0,10"/>
                                <Grid>
                                    <TextBlock Text="Total Assets" Foreground="#1C1C1F" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock x:Name="BsTotalAssetsText" Foreground="#1B8A3D" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="LIABILITIES" Foreground="#B8860B" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="BsLiabilitiesList" Margin="0,0,0,14"/>
                                    <Border Height="1" Background="#E4E4E8" Margin="0,0,0,10"/>
                                    <Grid>
                                        <TextBlock Text="Total Liabilities" Foreground="#1C1C1F" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock x:Name="BsTotalLiabilitiesText" Foreground="#B8860B" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="EQUITY" Foreground="#5B4EA6" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="BsEquityList" Margin="0,0,0,14"/>
                                    <Border Height="1" Background="#E4E4E8" Margin="0,0,0,10"/>
                                    <Grid>
                                        <TextBlock Text="Total Equity" Foreground="#1C1C1F" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock x:Name="BsTotalEquityText" Foreground="#5B4EA6" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="BsCheckCard" Background="#FAFAFB" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Liabilities + Equity" Foreground="#6B6B72" FontSize="13"/>
                                    <TextBlock x:Name="BsLiabPlusEquityText" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
