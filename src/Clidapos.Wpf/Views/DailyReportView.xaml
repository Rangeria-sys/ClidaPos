<Window x:Class="Clidapos.Wpf.Views.DailyReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Day End Summary"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F7">

    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#178E86"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0E5E5A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Back_Click" ToolTip="Back" Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="DAY END SUMMARY" Foreground="#9FE1CB" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="StoreText" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ComboBox x:Name="PeriodPicker" Width="360" Margin="0,6,0,0"
                                  Background="White" Foreground="Black" FontSize="12" Padding="8,5"
                                  DisplayMemberPath="Label" SelectionChanged="PeriodPicker_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Minimize_Click" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <Button x:Name="PrintButton" Style="{StaticResource HeaderIconBtn}" Click="Print_Click"
                            Margin="0,0,10,0" ToolTip="Print">
                        <TextBlock Text="🖨" FontSize="22" Foreground="White"/>
                    </Button>
                    <Button x:Name="DownloadButton" Style="{StaticResource HeaderIconBtn}" Click="DownloadPdf_Click"
                            Margin="0,0,10,0" ToolTip="Download PDF">
                        <TextBlock Text="↓" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Close_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,30" Width="820">

                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="TOTAL TAKINGS" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="GrandTotalText" Text="KSh 0.00" Foreground="#0E5E5A" FontSize="40" FontWeight="Bold"/>
                        <Border Height="1" Background="#E4E4E8" Margin="0,16,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sales (bills)" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="BillCountText" Foreground="#1C1C1F" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Items sold" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="ItemCountText" Foreground="#1C1C1F" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Average sale" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="AverageText" Foreground="#1C1C1F" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="BY PAYMENT METHOD" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Cash" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="CashText" Style="{StaticResource RowValue}" Foreground="#1B8A3D"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="M-Pesa" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="MpesaText" Style="{StaticResource RowValue}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Card" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="CardText" Style="{StaticResource RowValue}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="ADJUSTMENTS" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Discounts given" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="DiscountsText" Style="{StaticResource RowValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Voided sales" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="VoidedCountText" Style="{StaticResource RowValue}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Tax collected (VAT)" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="VatText" Style="{StaticResource RowValue}" Foreground="#F3A123"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="CashierCard" Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CASHIER BREAKDOWN" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cashier" Foreground="#8A8A94" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Bills" Foreground="#8A8A94" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="Takings" Foreground="#8A8A94" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="Voids" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="1" Background="#E4E4E8" Margin="0,0,0,8"/>
                        <StackPanel x:Name="CashierList"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="TOP ITEMS SOLD" Style="{StaticResource CardTitle}"/>
                            <StackPanel x:Name="TopItemsList"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CASH DRAWER RECONCILIATION" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Opening float" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="OpeningCashText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Expected in drawer" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="ExpectedCashText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Counted cash" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="ClosingCashText" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <Border x:Name="VarianceCard" Background="#FCF3E3" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <TextBlock x:Name="VarianceLabel" Text="Variance" Foreground="#B8860B" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="VarianceText" Foreground="#B8860B" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="20,16">
                    <TextBlock x:Name="SignOffText" Foreground="#8A8A94" FontSize="13"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
