<Window x:Class="Clidapos.Wpf.Views.BillPaymentPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Bill Payment"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="460" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PopupCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="RECORD BILL PAYMENT" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Width="30" Height="30" Background="Transparent" Foreground="#888888"
                        FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="Bill" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="BillInput" Style="{StaticResource PopupCombo}"
                      DisplayMemberPath="ExpenseName" Margin="0,0,0,12"/>

            <TextBlock Text="Paid To (e.g. supplier / provider name)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="PaidToInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Amount" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AmountInput" Style="{StaticResource PopupInput}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Payment Mode" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PaymentModeInput" Style="{StaticResource PopupCombo}">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="M-Pesa"/>
                        <ComboBoxItem Content="Bank Transfer"/>
                        <ComboBoxItem Content="Cheque"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NotesInput" Style="{StaticResource PopupInput}" Margin="0,0,0,16"/>

            <Button Content="💾  Record Payment" Click="Save_Click"
                    Style="{StaticResource ActionBtn}" Background="#F3A123"/>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>