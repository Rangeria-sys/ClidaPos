<Window x:Class="Clidapos.Wpf.Views.BackOfficeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Back Office"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

	<Window.Resources>
		<Style x:Key="TileButton" TargetType="Button">
			<Setter Property="Width" Value="115"/>
			<Setter Property="Height" Value="115"/>
			<Setter Property="Margin" Value="7"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="#17171C"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Base" Background="{TemplateBinding Background}" CornerRadius="12">
							<Grid>
								<ContentPresenter/>
								<!-- Colour-agnostic hover feedback: a white wash that fades in,
                                     rather than swapping to a fixed hover colour, so it reads
                                     correctly no matter which accent this particular tile uses. -->
								<Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="12"/>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="HoverOverlay" Property="Opacity" Value="0.14"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="HoverOverlay" Property="Opacity" Value="0.24"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Same bold font + clean shadow treatment used on Gateway and Front Office,
             so every screen in the app reads consistently. -->
		<Style x:Key="StylishBoldText" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontWeight" Value="Black"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" BlurRadius="4" Opacity="0.65"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="HeaderPanel" TargetType="Border">
			<Setter Property="Background" Value="#A6141414"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="16,10"/>
		</Style>

		<!-- A solid near-black bar behind every tile label, so the text stays high
             contrast no matter what color that particular tile happens to be -
             more reliable than a shadow/glow, which can wash out on light tiles. -->
		<Style x:Key="TileLabelBar" TargetType="Border">
			<Setter Property="Background" Value="#D6000000"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Padding" Value="5,3"/>
			<Setter Property="Margin" Value="0,7,0,0"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="TileLabel" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontWeight" Value="Black"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="10.5"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<Style x:Key="SectionPill" TargetType="Border">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="26,7"/>
			<Setter Property="Margin" Value="0,4,0,8"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="BorderBrush" Value="#33FFFFFF"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="Black" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SectionPillText" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="19"/>
			<Setter Property="FontWeight" Value="Black"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>

		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource AppOverlay}">

		<Button Click="BackToGateway_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="56" Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                Margin="15,10,0,0" ToolTip="Back to Gateway">
			<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="42" Height="42"/>
		</Button>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,20,0">
			<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
				<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="42" Height="42"/>
			</Button>
			<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" ToolTip="Exit">
				<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform" Width="42" Height="42"/>
			</Button>
		</StackPanel>

		<Border Style="{StaticResource HeaderPanel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="CLIDA POS - BACK OFFICE" Style="{StaticResource StylishBoldText}" FontSize="18"/>
				<TextBlock x:Name="WelcomeText" Foreground="#E8E8E8" FontFamily="Segoe UI Semibold" FontSize="14"
                           VerticalAlignment="Center" Margin="18,0,0,0"/>
			</StackPanel>
		</Border>

		<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,70,0,0">
			<StackPanel Orientation="Horizontal" Margin="30,0,30,8" VerticalAlignment="Top" HorizontalAlignment="Center">

				<!-- GENERAL SETTING column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#4A7FE8">
						<TextBlock Text="GENERAL SETTING" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="260">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="MasterSetting" Background="#4A7FE8">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/mastersetting.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Master Setting" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Profile" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/profile.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Business Profile" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="UserRoles" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/userroles.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="User Security Roles" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Backup" Background="#E67E22">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/backup.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Backup Setting" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="CategoryUnit" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/categoryunit.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Category Setup" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Loyalty" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/loyalty.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Loyalty &amp; Membership" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Vouchers" Background="#C0392B">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/vouchers.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Vouchers &amp; Promotions" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- INVENTORY column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#17A398">
						<TextBlock Text="INVENTORY" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="260">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Items" Background="#2ECC71">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/items.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Items" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="PurchaseEntry" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/purchaseentry.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Purchase Entry" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockLevels" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stocklevels.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Stock Levels" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockAdjustment" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stockadjustment.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Stock Adjustment" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button x:Name="StockTransferTile" Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockTransfer" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stocktransfer.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Stock Transfer" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Warehouse" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/warehouse.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Warehouse Management" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- HR & ACCOUNTS column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#DC143C">
						<TextBlock Text="HR &amp; ACCOUNTS" Style="{StaticResource SectionPillText}" Foreground="White"/>
					</Border>
					<WrapPanel Width="260">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="EmployeeRegistration" Background="#29B6F6">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/employee.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Employee Registration" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="HR" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/hr.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="HR &amp; Payroll" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Customers" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/customers.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Credit Customer" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="CustomerLedger" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/cusledger.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Credit Customer Ledger" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Supplier" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/supplier.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Supplier" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="SupplierLedger" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/supplierledger.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Supplier Ledger" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="ExpenseMaster" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expensemaster.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Expense" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Expenses" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expenses.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Expense Ledger" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Finance" Background="#7B241C">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/finance.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Finance &amp; Banking" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- REPORTS column -->
				<StackPanel>
					<Border Style="{StaticResource SectionPill}" Background="#F3A123">
						<TextBlock Text="REPORTS" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="260">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="SalesReports" Background="#4A7FE8">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/salesreports.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Sales Reports" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockReports" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stockreports.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Stock / Item Reports" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="PurchaseReports" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/purchasereports.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Purchase Reports" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="ExpenseReports" Background="#C0392B">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expensereports.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Expense Reports" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="AccountingReports" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/accountingreports.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="Accounting Reports" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Logs" Background="#1A1A1F">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/logs.png" Width="52" Height="52"/>
								<Border Style="{StaticResource TileLabelBar}">
									<TextBlock Text="System Logs" Style="{StaticResource TileLabel}"/>
								</Border>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>