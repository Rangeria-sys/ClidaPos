<Window x:Class="Clidapos.Wpf.Views.BackOfficeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Back Office"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

	<Window.Resources>
		<Style x:Key="TileButton" TargetType="Button">
			<Setter Property="Width" Value="150"/>
			<Setter Property="Height" Value="150"/>
			<Setter Property="Margin" Value="10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Base" Background="#17171C" CornerRadius="12">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Base" Property="Background" Value="#222228"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TileLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Margin" Value="0,12,0,0"/>
		</Style>

		<Style x:Key="SectionPill" TargetType="Border">
			<Setter Property="CornerRadius" Value="20"/>
			<Setter Property="Padding" Value="24,10"/>
			<Setter Property="Margin" Value="0,20,0,14"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="SectionPillText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>

		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource AppOverlay}">
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="BackToGateway_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back to Gateway">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
				</Button>

				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="CLIDA POS - BACK OFFICE" Foreground="#F3A123" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
					<TextBlock x:Name="WelcomeText" Foreground="#CCCCCC" FontSize="13"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
			<StackPanel Orientation="Horizontal" Margin="30,10,30,20" VerticalAlignment="Top">

				<!-- GENERAL SETTING column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#4A7FE8">
						<TextBlock Text="GENERAL SETTING" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="MasterSetting">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/mastersetting.png" Width="72" Height="72"/>
								<TextBlock Text="Master Setting" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Profile">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/profile.png" Width="72" Height="72"/>
								<TextBlock Text="Business Profile" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="UserRoles">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/userroles.png" Width="72" Height="72"/>
								<TextBlock Text="User Security Roles" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Backup">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/backup.png" Width="72" Height="72"/>
								<TextBlock Text="Backup Setting" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="CategoryUnit">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/categoryunit.png" Width="72" Height="72"/>
								<TextBlock Text="Category Setup" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- INVENTORY column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#17A398">
						<TextBlock Text="INVENTORY" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Items">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/items.png" Width="72" Height="72"/>
								<TextBlock Text="Items" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="PurchaseEntry">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/purchaseentry.png" Width="72" Height="72"/>
								<TextBlock Text="Purchase Entry" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockLevels">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stocklevels.png" Width="72" Height="72"/>
								<TextBlock Text="Stock Levels" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockAdjustment">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stockadjustment.png" Width="72" Height="72"/>
								<TextBlock Text="Stock Adjustment" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button x:Name="StockTransferTile" Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockTransfer">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stocktransfer.png" Width="72" Height="72"/>
								<TextBlock Text="Stock Transfer" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Supplier">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/supplier.png" Width="72" Height="72"/>
								<TextBlock Text="Supplier" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Warehouse">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/warehouse.png" Width="72" Height="72"/>
								<TextBlock Text="Warehouse Management" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- HR & ACCOUNTS column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#DC143C">
						<TextBlock Text="HR &amp; ACCOUNTS" Style="{StaticResource SectionPillText}" Foreground="White"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="EmployeeRegistration">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<TextBlock Text="👥" FontSize="40" Foreground="#F3A123" HorizontalAlignment="Center"/>
								<TextBlock Text="Employee Registration" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="HR">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/hr.png" Width="72" Height="72"/>
								<TextBlock Text="HR &amp; Payroll" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Customers">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/customers.png" Width="72" Height="72"/>
								<TextBlock Text="Customers" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="CustomerLedger">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<TextBlock Text="📒" FontSize="40" Foreground="#F3A123" HorizontalAlignment="Center"/>
								<TextBlock Text="Customer Ledger" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="SupplierLedger">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/supplierledger.png" Width="72" Height="72"/>
								<TextBlock Text="Supplier Ledger" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Expenses">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expenses.png" Width="72" Height="72"/>
								<TextBlock Text="Expense Log" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="ExpenseMaster">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expensemaster.png" Width="72" Height="72"/>
								<TextBlock Text="Expense" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Finance">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/finance.png" Width="72" Height="72"/>
								<TextBlock Text="Finance &amp; Banking" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Loyalty">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/loyalty.png" Width="72" Height="72"/>
								<TextBlock Text="Loyalty &amp; Membership" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Vouchers">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/vouchers.png" Width="72" Height="72"/>
								<TextBlock Text="Vouchers &amp; Promotions" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- REPORTS column -->
				<StackPanel>
					<Border Style="{StaticResource SectionPill}" Background="#F3A123">
						<TextBlock Text="REPORTS" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="SalesReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/salesreports.png" Width="72" Height="72"/>
								<TextBlock Text="Sales Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stockreports.png" Width="72" Height="72"/>
								<TextBlock Text="Stock / Item Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="PurchaseReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/purchasereports.png" Width="72" Height="72"/>
								<TextBlock Text="Purchase Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="ExpenseReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expensereports.png" Width="72" Height="72"/>
								<TextBlock Text="Expense Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="AccountingReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/accountingreports.png" Width="72" Height="72"/>
								<TextBlock Text="Accounting Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Logs">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/logs.png" Width="72" Height="72"/>
								<TextBlock Text="System Logs" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>