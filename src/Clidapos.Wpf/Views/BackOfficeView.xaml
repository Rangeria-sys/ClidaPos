<Window x:Class="Clidapos.Wpf.Views.BackOfficeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Back Office"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

	<Window.Resources>
		<Style x:Key="TileButton" TargetType="Button">
			<Setter Property="Width" Value="150"/>
			<Setter Property="Height" Value="150"/>
			<Setter Property="Margin" Value="10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Base" Background="#17171C" CornerRadius="12">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Base" Property="Background" Value="#222228"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TileLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Margin" Value="0,12,0,0"/>
		</Style>

		<Style x:Key="SectionPill" TargetType="Border">
			<Setter Property="CornerRadius" Value="20"/>
			<Setter Property="Padding" Value="24,10"/>
			<Setter Property="Margin" Value="0,20,0,14"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="SectionPillText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>

		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource AppOverlay}">
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
					<TextBlock Text="CLIDA POS - BACK OFFICE" Foreground="#F3A123" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
					<TextBlock x:Name="WelcomeText" Foreground="#CCCCCC" FontSize="13"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,15,0">

					<Button Click="BackToGateway_Click" Style="{StaticResource RoundTopButton}"
                            Margin="0,0,10,0" ToolTip="Back to Gateway">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Ellipse>
										<Ellipse.Fill>
											<RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
												<GradientStop Color="#FFD98F" Offset="0"/>
												<GradientStop Color="#F3A123" Offset="0.5"/>
												<GradientStop Color="#B5741A" Offset="1"/>
											</RadialGradientBrush>
										</Ellipse.Fill>
										<Ellipse.Effect>
											<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
										</Ellipse.Effect>
									</Ellipse>
									<TextBlock Text="⌂" FontSize="18" FontWeight="Bold" Foreground="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button Click="Minimize_Click" Style="{StaticResource RoundTopButton}" Margin="0,0,10,0"
                            ToolTip="Minimize">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Ellipse>
										<Ellipse.Fill>
											<RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
												<GradientStop Color="#FFE9A6" Offset="0"/>
												<GradientStop Color="#E8B830" Offset="0.4"/>
												<GradientStop Color="#B8860B" Offset="0.85"/>
												<GradientStop Color="#8A6408" Offset="1"/>
											</RadialGradientBrush>
										</Ellipse.Fill>
										<Ellipse.Effect>
											<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
										</Ellipse.Effect>
									</Ellipse>
									<TextBlock Text="—" FontSize="16" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button Click="Exit_Click" Style="{StaticResource RoundTopButton}" ToolTip="Exit">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Ellipse>
										<Ellipse.Fill>
											<RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
												<GradientStop Color="#FF7B8C" Offset="0"/>
												<GradientStop Color="#DC143C" Offset="0.5"/>
												<GradientStop Color="#8F0C25" Offset="1"/>
											</RadialGradientBrush>
										</Ellipse.Fill>
										<Ellipse.Effect>
											<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
										</Ellipse.Effect>
									</Ellipse>
									<Viewbox Width="16" Height="16">
										<Canvas Width="24" Height="24">
											<Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="White" StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
										</Canvas>
									</Viewbox>
								</Grid>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
			<StackPanel Orientation="Horizontal" Margin="30,10,30,20" VerticalAlignment="Top">

				<!-- GENERAL SETTING column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#4A7FE8">
						<TextBlock Text="GENERAL SETTING" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="MasterSetting">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/mastersetting.png" Width="64" Height="64"/>
								<TextBlock Text="Master Setting" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Profile">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/profile.png" Width="64" Height="64"/>
								<TextBlock Text="Profile Setting" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="UserRoles">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/userroles.png" Width="64" Height="64"/>
								<TextBlock Text="User Security Roles" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Backup">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/backup.png" Width="64" Height="64"/>
								<TextBlock Text="Backup Setting" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="CategoryUnit">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/categoryunit.png" Width="64" Height="64"/>
								<TextBlock Text="Category Setup" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- INVENTORY column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#17A398">
						<TextBlock Text="INVENTORY" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Items">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/items.png" Width="64" Height="64"/>
								<TextBlock Text="Items" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="PurchaseEntry">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/purchaseentry.png" Width="64" Height="64"/>
								<TextBlock Text="Purchase Entry" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockLevels">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stocklevels.png" Width="64" Height="64"/>
								<TextBlock Text="Stock Levels" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockAdjustment">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stockadjustment.png" Width="64" Height="64"/>
								<TextBlock Text="Stock Adjustment" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Warehouse">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/warehouse.png" Width="64" Height="64"/>
								<TextBlock Text="Warehouse Management" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockTransfer">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stocktransfer.png" Width="64" Height="64"/>
								<TextBlock Text="Stock Transfer" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Supplier">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/supplier.png" Width="64" Height="64"/>
								<TextBlock Text="Supplier" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- HR & ACCOUNTS column -->
				<StackPanel Margin="0,0,24,0">
					<Border Style="{StaticResource SectionPill}" Background="#DC143C">
						<TextBlock Text="HR &amp; ACCOUNTS" Style="{StaticResource SectionPillText}" Foreground="White"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="HR">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/hr.png" Width="64" Height="64"/>
								<TextBlock Text="HR &amp; Payroll" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Customers">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/customers.png" Width="64" Height="64"/>
								<TextBlock Text="Customer Ledger" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="SupplierLedger">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/supplierledger.png" Width="64" Height="64"/>
								<TextBlock Text="Supplier Ledger" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Expenses">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expenses.png" Width="64" Height="64"/>
								<TextBlock Text="Expense Log" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="ExpenseMaster">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expensemaster.png" Width="64" Height="64"/>
								<TextBlock Text="Expense" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Finance">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/finance.png" Width="64" Height="64"/>
								<TextBlock Text="Finance &amp; Banking" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Loyalty">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/loyalty.png" Width="64" Height="64"/>
								<TextBlock Text="Loyalty &amp; Membership" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Vouchers">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/vouchers.png" Width="64" Height="64"/>
								<TextBlock Text="Vouchers &amp; Promotions" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

				<!-- REPORTS column -->
				<StackPanel>
					<Border Style="{StaticResource SectionPill}" Background="#F3A123">
						<TextBlock Text="REPORTS" Style="{StaticResource SectionPillText}"/>
					</Border>
					<WrapPanel Width="340">

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="SalesReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/salesreports.png" Width="64" Height="64"/>
								<TextBlock Text="Sales Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="StockReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/stockreports.png" Width="64" Height="64"/>
								<TextBlock Text="Stock / Item Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="PurchaseReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/purchasereports.png" Width="64" Height="64"/>
								<TextBlock Text="Purchase Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="ExpenseReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/expensereports.png" Width="64" Height="64"/>
								<TextBlock Text="Expense Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="AccountingReports">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/accountingreports.png" Width="64" Height="64"/>
								<TextBlock Text="Accounting Reports" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource TileButton}" Click="Nav_Click" Tag="Logs">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/logs.png" Width="64" Height="64"/>
								<TextBlock Text="System Logs" Style="{StaticResource TileLabel}"/>
							</StackPanel>
						</Button>

					</WrapPanel>
				</StackPanel>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>