<Window x:Class="Clidapos.Wpf.Views.VoidReasonPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Void Sale"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="420" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#DC143C" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="VOID SALE" FontSize="18" FontWeight="Bold" Foreground="#DC143C"/>
                <Button Click="Cancel_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
                </Button>
            </Grid>

            <TextBlock x:Name="SummaryText" Foreground="#4A4A50" FontSize="13"
                       Margin="0,0,0,16" TextWrapping="Wrap"/>

            <TextBlock Text="REASON (required)" Foreground="#6B6B72" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="ReasonInput" Style="{StaticResource PopupInput}" Height="70"
                     TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,0,0,12" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource ActionBtn}" Background="#6B6B72"/>
                <Button Grid.Column="2" Content="Void Sale" Click="Confirm_Click"
                        Style="{StaticResource ActionBtn}" Background="#DC143C"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>