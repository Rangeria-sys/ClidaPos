<Window x:Class="Clidapos.Wpf.Views.ExpenseReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Expense Report"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

	<Window.Resources>
		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="DateInput" TargetType="DatePicker">
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="QuickBtn" TargetType="Button">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RunBtn" TargetType="Button" BasedOn="{StaticResource QuickBtn}">
			<Setter Property="Background" Value="#F3A123"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<Style x:Key="SectionLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#8A8A92"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>

		<Style x:Key="RowLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="RowValue" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>

		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="Foreground" Value="#4A4A50"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
						Background="Transparent" BorderThickness="0" Cursor="Hand"
						Margin="15,0,0,0" ToolTip="Back">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
						   Width="42" Height="42"/>
				</Button>

				<TextBlock Grid.Column="1" Text="EXPENSE REPORT" Foreground="#F3A123" FontSize="16"
						   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
							Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
							BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
							   Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
							BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
							   Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="30,20,30,20" MaxWidth="900" HorizontalAlignment="Stretch">

				<!-- DATE RANGE -->
				<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="DATE RANGE" Style="{StaticResource SectionLabel}"/>
						<Grid Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="From" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
								<DatePicker x:Name="FromDateInput" Style="{StaticResource DateInput}"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="To" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
								<DatePicker x:Name="ToDateInput" Style="{StaticResource DateInput}"/>
							</StackPanel>
						</Grid>
						<StackPanel Orientation="Horizontal">
							<Button Content="Today" Click="Today_Click" Style="{StaticResource QuickBtn}" Margin="0,0,8,0"/>
							<Button Content="This Week" Click="ThisWeek_Click" Style="{StaticResource QuickBtn}" Margin="0,0,8,0"/>
							<Button Content="This Month" Click="ThisMonth_Click" Style="{StaticResource QuickBtn}" Margin="0,0,8,0"/>
							<Button Content="Run Report" Click="RunReport_Click" Style="{StaticResource RunBtn}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- TOTAL -->
				<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="TOTAL SPENT" Style="{StaticResource SectionLabel}"/>
						<TextBlock x:Name="TotalSpentText" Text="KSh 0.00" FontSize="40" FontWeight="Bold" Foreground="#B23A3A" Margin="0,0,0,10"/>
						<Separator Margin="0,0,0,10"/>
						<Grid>
							<TextBlock Text="Vouchers" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
							<TextBlock x:Name="VoucherCountText" Style="{StaticResource RowValue}" HorizontalAlignment="Right"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- BY PAYMENT MODE -->
				<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="BY PAYMENT MODE" Style="{StaticResource SectionLabel}"/>
						<ItemsControl x:Name="PaymentModeList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid Margin="0,0,0,8">
										<TextBlock Text="{Binding Mode}" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
										<TextBlock Text="{Binding Total, StringFormat='KSh {0:N2}'}" Style="{StaticResource RowValue}" HorizontalAlignment="Right"/>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- TOP CATEGORIES -->
				<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="TOP SPENDING CATEGORIES" Style="{StaticResource SectionLabel}"/>
						<ItemsControl x:Name="ParticularsList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid Margin="0,0,0,8">
										<TextBlock Text="{Binding Particulars}" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
										<TextBlock Text="{Binding Total, StringFormat='KSh {0:N2}'}" Style="{StaticResource RowValue}" HorizontalAlignment="Right"/>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- VOUCHER LIST -->
				<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="10" Padding="20">
					<StackPanel>
						<TextBlock Text="VOUCHERS IN RANGE" Style="{StaticResource SectionLabel}"/>
						<DataGrid x:Name="VoucherGrid" AutoGenerateColumns="False"
                                  Background="White" BorderThickness="0"
                                  RowBackground="White" AlternatingRowBackground="#F5F5F7"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  RowHeaderWidth="0" Foreground="#1C1C1F"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  IsReadOnly="True" SelectionMode="Single" MinHeight="200">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Voucher No" Binding="{Binding VoucherNo}" Width="130"/>
								<DataGridTextColumn Header="Paid To" Binding="{Binding Name}" Width="*"/>
								<DataGridTextColumn Header="Payment Mode" Binding="{Binding PaymentMode}" Width="140"/>
								<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="120"/>
								<DataGridTextColumn Header="Amount" Binding="{Binding GrandTotal, StringFormat=N2}" Width="130"/>
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>