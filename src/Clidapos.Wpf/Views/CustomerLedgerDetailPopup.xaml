<Window x:Class="Clidapos.Wpf.Views.CustomerLedgerDetailPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Ledger"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="660" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<Style x:Key="PopupInput" TargetType="TextBox">
			<Setter Property="Background" Value="#F5F5F7"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="Foreground" Value="#4A4A50"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>

		<Style x:Key="ActionBtn" TargetType="Button">
			<Setter Property="Height" Value="42"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
		<Border.Effect>
			<DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
		</Border.Effect>
		<StackPanel Margin="24">

			<Grid Margin="0,0,0,4">
				<TextBlock x:Name="CustomerNameText" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
				<Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
					<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
				</Button>
			</Grid>

			<Grid Margin="0,0,0,16">
				<TextBlock Text="OWES US" Foreground="#8A8A92" FontSize="11" FontWeight="Bold"/>
				<TextBlock x:Name="BalanceText" Text="0.00" Foreground="#B23A3A"
                           FontSize="28" FontWeight="Bold" HorizontalAlignment="Right"/>
			</Grid>

			<Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,16">
				<DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" Height="220"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                          FontSize="12" Foreground="#1C1C1F">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="100"/>
						<DataGridTextColumn Header="Description" Binding="{Binding Label}" Width="*"/>
						<DataGridTextColumn Header="Debit (Owes More)" Binding="{Binding Debit, StringFormat=N2}" Width="140"/>
						<DataGridTextColumn Header="Credit (Paid)" Binding="{Binding Credit, StringFormat=N2}" Width="120"/>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<Grid Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="12"/>
					<ColumnDefinition Width="120"/>
				</Grid.ColumnDefinitions>
				<TextBox Grid.Column="0" x:Name="LabelInput" Style="{StaticResource PopupInput}" Tag="Description"/>
				<TextBox Grid.Column="2" x:Name="AmountInput" Style="{StaticResource PopupInput}" Tag="Amount"/>
			</Grid>

			<Grid Margin="0,0,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" Content="Record Credit Given (owes more)" Click="RecordCredit_Click"
                        Style="{StaticResource ActionBtn}" Background="#B23A3A"/>
				<Button Grid.Column="2" Content="Record Payment Received (owes less)" Click="RecordPayment_Click"
                        Style="{StaticResource ActionBtn}" Background="#2D6CDF"/>
			</Grid>

			<TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12" TextWrapping="Wrap"/>
		</StackPanel>
	</Border>
</Window>