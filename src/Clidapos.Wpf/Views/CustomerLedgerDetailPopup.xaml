<Window x:Class="Clidapos.Wpf.Views.CustomerLedgerDetailPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credit Customer Ledger"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="LedgerGridHeader" TargetType="DataGridColumnHeader">
				<Setter Property="Background" Value="#1E1E24"/>
				<Setter Property="Foreground" Value="#F3A123"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="FontSize" Value="11.5"/>
				<Setter Property="Padding" Value="10,8"/>
				<Setter Property="HorizontalContentAlignment" Value="Left"/>
			</Style>

			<Style x:Key="LedgerGridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LedgerGridHeader}">
				<Setter Property="HorizontalContentAlignment" Value="Right"/>
			</Style>

			<Style x:Key="LedgerCellLeft" TargetType="TextBlock">
				<Setter Property="Padding" Value="10,0"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Foreground" Value="#1C1C1F"/>
			</Style>

			<Style x:Key="LedgerCellRight" TargetType="TextBlock" BasedOn="{StaticResource LedgerCellLeft}">
				<Setter Property="HorizontalAlignment" Value="Right"/>
				<Setter Property="TextAlignment" Value="Right"/>
			</Style>

			<Style x:Key="LedgerGridRow" TargetType="DataGridRow">
				<Setter Property="Background" Value="White"/>
				<Style.Triggers>
					<Trigger Property="AlternationIndex" Value="1">
						<Setter Property="Background" Value="#F7F7F9"/>
					</Trigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="LedgerActionBtn" TargetType="Button">
				<Setter Property="Height" Value="46"/>
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="FontSize" Value="13"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<Border Style="{StaticResource PopupCard}" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
			<StackPanel>

				<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
					<Grid>
						<TextBlock x:Name="CustomerNameText" Style="{StaticResource PopupTitle}" FontSize="17"/>
						<Button Click="Close_Click" HorizontalAlignment="Right"
                                Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
							<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                   Width="26" Height="26"/>
						</Button>
					</Grid>
				</Border>

				<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
				<StackPanel Margin="20">

					<Border Background="#1A1A1F" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
						<Grid>
							<TextBlock Text="BALANCE (positive = owes us)" Foreground="#B8B8C0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
							<TextBlock x:Name="BalanceText" Text="0.00" Foreground="#FF6B6B" FontSize="24" FontWeight="Black"
                                       HorizontalAlignment="Right"/>
						</Grid>
					</Border>

					<Border BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,16">
						<DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False"
                                  Background="White" BorderThickness="0"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDEDF0"
                                  RowHeaderWidth="0" MaxHeight="260"
                                  RowStyle="{StaticResource LedgerGridRow}"
                                  AlternationCount="2"
                                  RowHeight="34" ColumnHeaderHeight="36"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  SelectionMode="Single" FontSize="13">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="110"
                                                     HeaderStyle="{StaticResource LedgerGridHeader}" ElementStyle="{StaticResource LedgerCellLeft}"/>
								<DataGridTextColumn Header="Description" Binding="{Binding Label}" Width="*"
                                                     HeaderStyle="{StaticResource LedgerGridHeader}" ElementStyle="{StaticResource LedgerCellLeft}"/>
								<DataGridTextColumn Header="Credit Given (Owes More)" Binding="{Binding Debit, StringFormat=N2}" Width="160"
                                                     HeaderStyle="{StaticResource LedgerGridHeaderRight}" ElementStyle="{StaticResource LedgerCellRight}"/>
								<DataGridTextColumn Header="Payment Received (Paid)" Binding="{Binding Credit, StringFormat=N2}" Width="160"
                                                     HeaderStyle="{StaticResource LedgerGridHeaderRight}" ElementStyle="{StaticResource LedgerCellRight}"/>
							</DataGrid.Columns>
						</DataGrid>
					</Border>

					<Grid Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="1*"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0">
							<TextBlock Text="Note (e.g. paid in cash, M-Pesa, cheque...)" Style="{StaticResource PopupFieldLabel}" Margin="0,0,0,4"/>
							<TextBox x:Name="LabelInput" Style="{StaticResource PopupInput}"/>
						</StackPanel>
						<StackPanel Grid.Column="2">
							<TextBlock Text="Amount" Style="{StaticResource PopupFieldLabel}" Margin="0,0,0,4"/>
							<TextBox x:Name="AmountInput" Style="{StaticResource PopupInput}" PreviewTextInput="NumericOnly_PreviewTextInput"/>
						</StackPanel>
					</Grid>

					<Grid Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" Content="Record Credit Given (owes more)" Click="RecordCredit_Click"
                                Style="{StaticResource LedgerActionBtn}" Background="#DC143C"/>
						<Button Grid.Column="2" Content="Record Payment Received (owes less)" Click="RecordPayment_Click"
                                Style="{StaticResource LedgerActionBtn}" Background="#34C759"/>
					</Grid>

					<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
				</StackPanel>
				</ScrollViewer>
			</StackPanel>
		</Border>
	</Grid>
</Window>
