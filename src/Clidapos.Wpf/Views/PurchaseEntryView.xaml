<Window x:Class="Clidapos.Wpf.Views.PurchaseEntryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clidapos.Wpf.Views"
        Title="Clidapos - Purchase Entry"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

	<Window.Resources>
		<local:ComboDisplayNameConverter x:Key="ComboDisplayNameConverter"/>

		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="SearchInput" TargetType="TextBox">
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#F3A123"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="15"/>
		</Style>

		<Style x:Key="PanelInput" TargetType="TextBox">
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#3A3A42"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="PanelCombo" TargetType="ComboBox">
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#3A3A42"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="ItemContainerStyle">
				<Setter.Value>
					<Style TargetType="ComboBoxItem">
						<Setter Property="Background" Value="#1E1E24"/>
						<Setter Property="Foreground" Value="White"/>
						<Setter Property="Padding" Value="8,6"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ComboBoxItem">
									<Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
										<ContentPresenter/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsHighlighted" Value="True">
											<Setter TargetName="ItemBd" Property="Background" Value="#F3A123"/>
											<Setter Property="Foreground" Value="Black"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>

							<ContentPresenter x:Name="ContentSite"
                                     Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ComboDisplayNameConverter}}"
                                     Margin="{TemplateBinding Padding}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>

							<ToggleButton Background="Transparent" BorderThickness="0" ClickMode="Press"
                                     IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="Transparent">
											<Path Data="M0,0 L8,0 L4,6 Z" Fill="#F3A123" HorizontalAlignment="Right" Margin="0,0,12,0"/>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
								<Border Background="#1E1E24" BorderBrush="#F3A123" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220"
                                        Margin="0,2,0,0">
									<ScrollViewer Margin="2" SnapsToDevicePixels="True">
										<ItemsPresenter/>
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A64"/>
							</Trigger>
							<Trigger Property="IsDropDownOpen" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SidebarTile" TargetType="Button">
			<Setter Property="Height" Value="72"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#2A2A32"/>
			<Setter Property="Foreground" Value="#F3A123"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="BorderBrush" Value="#3A3A42"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>

		<Style x:Key="RemoveRowBtn" TargetType="Button">
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="#3A2226" CornerRadius="6">
							<TextBlock Text="✕" Foreground="#FF6B6B" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="QtyStepBtn" TargetType="Button">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="#2A2A32" CornerRadius="5">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#3A3A44"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="ActionBtn" TargetType="Button">
			<Setter Property="Height" Value="52"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="B" Property="Opacity" Value="0.85"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource AppOverlay}">
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="BackToOffice_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
				</Button>

				<TextBlock Grid.Column="1" Text="PURCHASE ENTRY" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="260"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="230"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- DETAILS PANEL -->
			<Border Grid.Column="0" Background="#1A1A1F" CornerRadius="10" Padding="16">
				<DockPanel>

					<UniformGrid DockPanel.Dock="Bottom" Rows="1" Columns="3" Margin="0,14,0,0">
						<Button Style="{StaticResource SidebarTile}" Background="#4A4A52" Margin="0,0,4,0" Click="NewEntry_Click">
							<StackPanel HorizontalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/newentry.png" Width="26" Height="26"/>
								<TextBlock Text="New Entry" FontSize="10.5" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button Style="{StaticResource SidebarTile}" Background="#4A4A52" Margin="4,0" Click="GetData_Click">
							<StackPanel HorizontalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/get.png" Width="26" Height="26"/>
								<TextBlock Text="Get Data" FontSize="10.5" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button Style="{StaticResource SidebarTile}" Background="#4A4A52" Margin="4,0,0,0" Click="History_Click">
							<StackPanel HorizontalAlignment="Center">
								<Image Source="pack://application:,,,/Assets/historypurchase.png" Width="26" Height="26"/>
								<TextBlock Text="History" FontSize="10.5" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>
					</UniformGrid>

					<StackPanel>
						<TextBlock Text="DETAILS" Foreground="#F3A123" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

						<TextBlock Text="Invoice No" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
						<TextBox x:Name="InvoiceInput" Style="{StaticResource PanelInput}" Margin="0,0,0,14"/>

						<TextBlock Text="Supplier" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
						<ComboBox x:Name="SupplierCombo" Style="{StaticResource PanelCombo}"
                              DisplayMemberPath="Name" Margin="0,0,0,14"/>

						<TextBlock Text="Warehouse" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
						<ComboBox x:Name="WarehouseCombo" Style="{StaticResource PanelCombo}"
                              DisplayMemberPath="WarehouseName" Margin="0,0,0,14"/>

						<TextBlock Text="Discount %" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
						<TextBox x:Name="DiscountInput" Style="{StaticResource PanelInput}"
                             TextChanged="Totals_TextChanged" Margin="0,0,0,14"/>

						<TextBlock Text="Freight Charges" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
						<TextBox x:Name="FreightInput" Style="{StaticResource PanelInput}"
                             TextChanged="Totals_TextChanged" Margin="0,0,0,14"/>

						<TextBlock Text="Other Charges" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
						<TextBox x:Name="OtherChargesInput" Style="{StaticResource PanelInput}"
                             TextChanged="Totals_TextChanged"/>
					</StackPanel>
				</DockPanel>
			</Border>

			<!-- SEARCH -->
			<Border Grid.Column="2" Background="#1A1A1F" CornerRadius="10" Padding="14">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="ADD ITEM" Foreground="#F3A123" FontSize="13"
                               FontWeight="Bold" Margin="0,0,0,8"/>
					<TextBox DockPanel.Dock="Top" x:Name="SearchBox" Style="{StaticResource SearchInput}"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
					<TextBlock DockPanel.Dock="Top" Text="Type a name or code, or scan a barcode. Click a result, or scan/press Enter, to add it."
                               Foreground="#888888" FontSize="11" Margin="0,6,0,8" TextWrapping="Wrap"/>

					<ListBox x:Name="ResultsList" Background="#141419" Foreground="White"
                             BorderThickness="0" SelectionChanged="ResultsList_SelectionChanged">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid Margin="6,6">
									<TextBlock Text="{Binding ProductName}" Foreground="White" FontSize="14"
                                               TextWrapping="Wrap"/>
									<TextBlock Text="{Binding Price, StringFormat=N2}" Foreground="#F3A123"
                                               FontSize="13" HorizontalAlignment="Right"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</Border>

			<!-- LINE GRID + TOTALS -->
			<Border Grid.Column="4" Background="#1A1A1F" CornerRadius="10" Padding="16">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="ITEMS RECEIVED" Foreground="#F3A123" FontSize="18"
                               FontWeight="Bold" Margin="0,0,0,4"/>
					<TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,12">
						Cost Price starts blank every time - type what you actually paid. "Last Paid" is shown for reference only, in case this delivery's price is different. Expiry format: yyyy-MM-dd (e.g. 2026-12-31) - leave blank if not applicable.
					</TextBlock>

					<TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

					<Border DockPanel.Dock="Bottom" Background="#141419" CornerRadius="8" Padding="18" Margin="0,12,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="220"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock Foreground="#CCCCCC" FontSize="13">
									<Run Text="Subtotal: "/>
									<Run x:Name="SubtotalText" Text="0.00"/>
								</TextBlock>
								<TextBlock Foreground="#CCCCCC" FontSize="13">
									<Run Text="Discount: "/>
									<Run x:Name="DiscountAmountText" Text="0.00"/>
								</TextBlock>
								<TextBlock Foreground="#CCCCCC" FontSize="13">
									<Run Text="Freight + Other: "/>
									<Run x:Name="ChargesText" Text="0.00"/>
								</TextBlock>
							</StackPanel>

							<StackPanel Grid.Column="1" HorizontalAlignment="Right">
								<TextBlock Text="GRAND TOTAL" Foreground="#888888" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Right"/>
								<TextBlock x:Name="GrandTotalText" Text="0.00" Foreground="#34C759"
                                           FontSize="40" FontWeight="Bold" HorizontalAlignment="Right"/>
								<Button x:Name="SaveButton" Content="SAVE PURCHASE" Background="#34C759"
                                        Style="{StaticResource ActionBtn}" Margin="0,10,0,0"
                                        Click="SavePurchase_Click"/>
							</StackPanel>
						</Grid>
					</Border>

					<Border DockPanel.Dock="Bottom" Background="White" CornerRadius="10" BorderBrush="#E4E4E8" BorderThickness="1">
						<Border.Effect>
							<DropShadowEffect Color="#000000" ShadowDepth="2" BlurRadius="10" Opacity="0.08"/>
						</Border.Effect>
						<DataGrid x:Name="LineGrid" AutoGenerateColumns="False" FontSize="15"
                              Background="White" Foreground="Black" BorderThickness="0"
                              RowBackground="White" AlternatingRowBackground="#F7F7F9"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDEDF0" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CanUserAddRows="False" SelectionMode="Single"
                              CellEditEnding="LineGrid_CellEditEnding">
						<DataGrid.RowStyle>
							<Style TargetType="DataGridRow">
								<Setter Property="MinHeight" Value="46"/>
							</Style>
						</DataGrid.RowStyle>
						<DataGrid.Columns>
							<DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" IsReadOnly="True">
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="TextBlock">
										<Setter Property="FontWeight" Value="Bold"/>
										<Setter Property="Padding" Value="10,0"/>
										<Setter Property="VerticalAlignment" Value="Center"/>
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
							<DataGridTextColumn Header="Expiry (optional)" Binding="{Binding ExpiryDate}" Width="120">
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="TextBlock">
										<Setter Property="FontWeight" Value="SemiBold"/>
										<Setter Property="Padding" Value="10,0"/>
										<Setter Property="VerticalAlignment" Value="Center"/>
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
							<DataGridTemplateColumn Header="Qty" Width="150">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
											<Button Content="−" Style="{StaticResource QtyStepBtn}" Foreground="White" FontWeight="Bold"
                                                    Click="QtyMinus_Click" Tag="{Binding}"/>
											<TextBox Text="{Binding Qty, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                      Width="55" Margin="6,0" TextAlignment="Center"
                                                      Background="#F0F0F3" Foreground="Black" BorderBrush="#B0B0B8"
                                                      PreviewTextInput="NumericOnly_PreviewTextInput"
                                                      TextChanged="Totals_TextChanged"
                                                      LostFocus="QtyTextBox_LostFocus"/>
											<Button Content="+" Style="{StaticResource QtyStepBtn}" Foreground="White" FontWeight="Bold"
                                                    Click="QtyPlus_Click" Tag="{Binding}"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Last Paid" Binding="{Binding LastKnownPrice, StringFormat=N2, TargetNullValue='—'}" Width="100" IsReadOnly="True">
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="TextBlock">
										<Setter Property="FontWeight" Value="SemiBold"/>
										<Setter Property="Foreground" Value="#6B6B72"/>
										<Setter Property="Padding" Value="10,0"/>
										<Setter Property="VerticalAlignment" Value="Center"/>
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
							<DataGridTemplateColumn Header="Cost Price (editable)" Width="150">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                                 TextChanged="Totals_TextChanged"
                                                 TextAlignment="Center" BorderThickness="1.3">
											<TextBox.Style>
												<Style TargetType="TextBox">
													<Setter Property="Background" Value="#F0F0F3"/>
													<Setter Property="Foreground" Value="Black"/>
													<Setter Property="BorderBrush" Value="#B0B0B8"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding NeedsPrice}" Value="True">
															<Setter Property="Background" Value="#FFF3C4"/>
															<Setter Property="Foreground" Value="#1C1C1F"/>
															<Setter Property="BorderBrush" Value="#E0B84D"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBox.Style>
										</TextBox>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120" IsReadOnly="True">
								<DataGridTextColumn.ElementStyle>
									<Style TargetType="TextBlock">
										<Setter Property="FontWeight" Value="Bold"/>
										<Setter Property="Padding" Value="10,0"/>
										<Setter Property="VerticalAlignment" Value="Center"/>
									</Style>
								</DataGridTextColumn.ElementStyle>
							</DataGridTextColumn>
							<DataGridTemplateColumn Header="" Width="50" CanUserResize="False">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Button Style="{StaticResource RemoveRowBtn}" Click="RemoveLine_Click" Tag="{Binding}"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
						</DataGrid>
					</Border>
				</DockPanel>
			</Border>
		</Grid>
	</Grid>
</Window>