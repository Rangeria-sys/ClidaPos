<Window x:Class="Clidapos.Wpf.Views.FrontOfficeHubView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Front Office"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <RadialGradientBrush x:Key="BadgeAmber" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFD98F" Offset="0"/>
            <GradientStop Color="#F3A123" Offset="0.55"/>
            <GradientStop Color="#B5741A" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeGreen" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#7DF0AE" Offset="0"/>
            <GradientStop Color="#34C759" Offset="0.55"/>
            <GradientStop Color="#1B7C38" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeBlue" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#9CC9FF" Offset="0"/>
            <GradientStop Color="#2D6CDF" Offset="0.55"/>
            <GradientStop Color="#16437F" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeTeal" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#84E7D8" Offset="0"/>
            <GradientStop Color="#17A398" Offset="0.55"/>
            <GradientStop Color="#0A5A54" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeRed" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FF8C9B" Offset="0"/>
            <GradientStop Color="#DC143C" Offset="0.55"/>
            <GradientStop Color="#8F0C25" Offset="1"/>
        </RadialGradientBrush>

        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconBadge" TargetType="Ellipse">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="6" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- Same look as the Gateway tiles: rounded card, soft drop shadow, dims
             slightly on hover regardless of which color the tile uses. -->
        <Style x:Key="HubTile" TargetType="Button">
            <Setter Property="Width" Value="270"/>
            <Setter Property="Height" Value="240"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same bold font + clean shadow treatment as the Gateway screen. -->
        <Style x:Key="StylishBoldText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" BlurRadius="4" Opacity="0.65"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderPanel" TargetType="Border">
            <Setter Property="Background" Value="#A6141414"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource StylishBoldText}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppOverlay}">

        <Button Click="Back_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="56" Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                Margin="15,10,0,0" ToolTip="Back">
            <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="42" Height="42"/>
        </Button>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,20,0">
            <Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
                <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="42" Height="42"/>
            </Button>
            <Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" ToolTip="Exit">
                <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform" Width="42" Height="42"/>
            </Button>
        </StackPanel>

        <Border Style="{StaticResource HeaderPanel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="FRONT OFFICE" Style="{StaticResource StylishBoldText}" FontSize="20"/>
                    <TextBlock x:Name="OperatorText" Foreground="#E8E8E8" FontFamily="Segoe UI Semibold" FontSize="15"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="DateTimeText" Foreground="#CCCCCC" FontFamily="Segoe UI Semibold" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="920">

            <Button x:Name="WorkPeriodTile" Style="{StaticResource HubTile}" Background="#17A398" Click="WorkPeriod_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/workp.png" Width="120" Height="120" Stretch="Uniform"/>
                    <TextBlock Text="Work Period" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="PosTile" Style="{StaticResource HubTile}" Background="#28A745" Click="Pos_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/pos.png" Width="120" Height="120" Stretch="Uniform"/>
                    <TextBlock Text="POS" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="KitchenTile" Style="{StaticResource HubTile}" Background="#DC143C" Click="KitchenDisplay_Click"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{StaticResource BadgeRed}" Style="{StaticResource IconBadge}"/>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,10 L12,4 L20,10 V20 H4 Z M10,20 V14 H14 V20" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="Kitchen Display" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="ReportTile" Style="{StaticResource HubTile}" Background="#7C4DCE" Click="Report_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/report.png" Width="120" Height="120" Stretch="Uniform"/>
                    <TextBlock Text="Report" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="ClockTile" Style="{StaticResource HubTile}" Background="#2D6CDF" Click="ClockInOut_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/clockin.png" Width="120" Height="120" Stretch="Uniform"/>
                    <TextBlock Text="Clock IN and OUT" Style="{StaticResource TileLabel}"/>
                    <TextBlock x:Name="ClockStatusText" Foreground="#D6E4F5" FontFamily="Segoe UI Semibold" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Button>

            <Button x:Name="LogoutTile" Style="{StaticResource HubTile}" Background="#DC143C" Click="Logout_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logout.png" Width="120" Height="120" Stretch="Uniform"/>
                    <TextBlock Text="Logout" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

        </WrapPanel>
    </Grid>
</Window>
