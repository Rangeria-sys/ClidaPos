<Window x:Class="Clidapos.Wpf.Views.FrontOfficeHubView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Front Office"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <RadialGradientBrush x:Key="BadgeAmber" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFD98F" Offset="0"/>
            <GradientStop Color="#F3A123" Offset="0.55"/>
            <GradientStop Color="#B5741A" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeGreen" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#7DF0AE" Offset="0"/>
            <GradientStop Color="#34C759" Offset="0.55"/>
            <GradientStop Color="#1B7C38" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeBlue" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#9CC9FF" Offset="0"/>
            <GradientStop Color="#2D6CDF" Offset="0.55"/>
            <GradientStop Color="#16437F" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeTeal" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#84E7D8" Offset="0"/>
            <GradientStop Color="#17A398" Offset="0.55"/>
            <GradientStop Color="#0A5A54" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BadgeRed" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FF8C9B" Offset="0"/>
            <GradientStop Color="#DC143C" Offset="0.55"/>
            <GradientStop Color="#8F0C25" Offset="1"/>
        </RadialGradientBrush>

        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconBadge" TargetType="Ellipse">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="6" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <Style x:Key="HubTile" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="#1A1A1F" CornerRadius="14"
                                BorderBrush="#3A3A42" BorderThickness="1.5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#24242C"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#F3A123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppOverlay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
                    <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
                </Button>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="FRONT OFFICE" Foreground="#F3A123" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="OperatorText" Foreground="#CCCCCC" FontSize="14"
                                   VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="DateTimeText" Foreground="#888888" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>

                    <Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
                        <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">

            <Button x:Name="WorkPeriodTile" Style="{StaticResource HubTile}" Click="WorkPeriod_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{StaticResource BadgeAmber}" Style="{StaticResource IconBadge}"/>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,5 H20 V20 H4 Z M4,9 H20 M8,3 V7 M16,3 V7" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="Work Period" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="PosTile" Style="{StaticResource HubTile}" Click="Pos_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{StaticResource BadgeGreen}" Style="{StaticResource IconBadge}"/>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,4 H20 V16 H4 Z M4,9 H20 M8,20 H16" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="POS" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="KitchenTile" Style="{StaticResource HubTile}" Click="KitchenDisplay_Click"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{StaticResource BadgeRed}" Style="{StaticResource IconBadge}"/>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,10 L12,4 L20,10 V20 H4 Z M10,20 V14 H14 V20" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="Kitchen Display" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="ReportTile" Style="{StaticResource HubTile}" Click="Report_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{StaticResource BadgeBlue}" Style="{StaticResource IconBadge}"/>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,20 H20 M7,20 V13 M12,20 V9 M17,20 V16" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="Report" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="ClockTile" Style="{StaticResource HubTile}" Click="ClockInOut_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{StaticResource BadgeTeal}" Style="{StaticResource IconBadge}"/>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,4 A8,8 0 1 0 12.01,4 Z M12,7 V12 L16,14" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="Clock IN and OUT" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

            <Button x:Name="LogoutTile" Style="{StaticResource HubTile}" Click="Logout_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="68" Height="68">
                        <Ellipse Fill="{StaticResource BadgeRed}" Style="{StaticResource IconBadge}"/>
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="M9,4 H6 V20 H9 M9,4 V20 M13,8 L17,12 L13,16 M17,12 H9" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="Logout" Style="{StaticResource TileLabel}"/>
                </StackPanel>
            </Button>

        </WrapPanel>
    </Grid>
</Window>