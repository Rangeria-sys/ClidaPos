<Window x:Class="Clidapos.Wpf.Views.HeldSalesPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Held Sales"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="620" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="Foreground" Value="#4A4A50"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="HELD SALES" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
                </Button>
            </Grid>

            <TextBlock Text="Double-click a held sale to resume it into your current cart."
                       Foreground="#8A8A92" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <TextBlock x:Name="EmptyText" Text="No sales are currently on hold."
                       Foreground="#8A8A92" FontSize="14" HorizontalAlignment="Center"
                       Margin="0,20,0,20" Visibility="Collapsed"/>

            <Border x:Name="ListBorder" Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
                <DataGrid x:Name="HeldGrid" AutoGenerateColumns="False" Height="260"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                          FontSize="13" Foreground="#1C1C1F"
                          MouseDoubleClick="HeldGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Held At" Binding="{Binding Sale.HeldDate, StringFormat='hh:mm tt'}" Width="90"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Sale.Label}" Width="*"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Sale.CustomerName}" Width="140"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Button x:Name="DeleteButton" Content="Discard Selected Held Sale" Click="Delete_Click"
                    Style="{StaticResource ActionBtn}" Background="#DC143C"/>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>