<Window x:Class="Clidapos.Wpf.Views.UserSecurityRolesPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Security Roles"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<!-- Editable checkbox grid, local to this popup - Module Permissions is
                 the one place in the app where the grid itself is data entry, not a
                 read-only list. -->
			<Style x:Key="RightsGridHeader" TargetType="DataGridColumnHeader">
				<Setter Property="Background" Value="#1E1E24"/>
				<Setter Property="Foreground" Value="#F3A123"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="FontSize" Value="11.5"/>
				<Setter Property="Padding" Value="8,8"/>
				<Setter Property="HorizontalContentAlignment" Value="Center"/>
			</Style>

			<Style x:Key="RightsGridHeaderLeft" TargetType="DataGridColumnHeader" BasedOn="{StaticResource RightsGridHeader}">
				<Setter Property="HorizontalContentAlignment" Value="Left"/>
			</Style>

			<Style x:Key="RightsModuleText" TargetType="TextBlock">
				<Setter Property="Padding" Value="10,0"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Foreground" Value="#1C1C1F"/>
			</Style>

			<Style x:Key="RightsCheckBox" TargetType="CheckBox">
				<Setter Property="HorizontalAlignment" Value="Center"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
			</Style>

			<Style x:Key="RightsGridRow" TargetType="DataGridRow">
				<Setter Property="Background" Value="White"/>
				<Style.Triggers>
					<Trigger Property="AlternationIndex" Value="1">
						<Setter Property="Background" Value="#F7F7F9"/>
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="520">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="USER SECURITY ROLES" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="30" Height="30"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="User ID "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="UserIdInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Name "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="NameInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="PIN / Password "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<PasswordBox Grid.Column="1" x:Name="PasswordInput" Style="{StaticResource PopupPasswordRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="User Type "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<ComboBox Grid.Column="1" x:Name="UserTypeInput" Style="{StaticResource PopupCombo}" IsEditable="True"
                                      SelectionChanged="UserTypeInput_SelectionChanged">
								<ComboBoxItem Content="Admin"/>
								<ComboBoxItem Content="Manager"/>
								<ComboBoxItem Content="Cashier"/>
							</ComboBox>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Active" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" x:Name="ActiveInput" Style="{StaticResource PopupCombo}">
								<ComboBoxItem Content="Y"/>
								<ComboBoxItem Content="N"/>
							</ComboBox>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Joining Date" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<DatePicker Grid.Column="1" x:Name="JoiningDateInput"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Contact No" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="ContactInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Email" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="EmailInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<StackPanel x:Name="ModulePermissionsSection">
							<TextBlock Text="Module Permissions" Style="{StaticResource PopupFieldLabel}" Margin="0,16,0,4"
                                   FontSize="14" Foreground="#1E1E24"/>

							<Border BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
								<DataGrid x:Name="RightsGrid" AutoGenerateColumns="False"
                                      Background="White" BorderThickness="0"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EDEDF0"
                                      RowHeaderWidth="0" MaxHeight="260"
                                      RowStyle="{StaticResource RightsGridRow}"
                                      AlternationCount="2"
                                      RowHeight="34" ColumnHeaderHeight="36"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False"
                                      SelectionMode="Single" SelectionUnit="Cell"
                                      FontSize="13">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="*"
                                                         HeaderStyle="{StaticResource RightsGridHeaderLeft}"
                                                         ElementStyle="{StaticResource RightsModuleText}"/>
									<DataGridTemplateColumn Header="Save" Width="70" HeaderStyle="{StaticResource RightsGridHeader}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<CheckBox IsChecked="{Binding UR_Save, UpdateSourceTrigger=PropertyChanged}"
                                                          IsThreeState="False" Style="{StaticResource RightsCheckBox}"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTemplateColumn Header="Update" Width="70" HeaderStyle="{StaticResource RightsGridHeader}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<CheckBox IsChecked="{Binding UR_Update, UpdateSourceTrigger=PropertyChanged}"
                                                          IsThreeState="False" Style="{StaticResource RightsCheckBox}"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTemplateColumn Header="Delete" Width="70" HeaderStyle="{StaticResource RightsGridHeader}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<CheckBox IsChecked="{Binding UR_Delete, UpdateSourceTrigger=PropertyChanged}"
                                                          IsThreeState="False" Style="{StaticResource RightsCheckBox}"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTemplateColumn Header="View" Width="70" HeaderStyle="{StaticResource RightsGridHeader}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<CheckBox IsChecked="{Binding UR_View, UpdateSourceTrigger=PropertyChanged}"
                                                          IsThreeState="False" Style="{StaticResource RightsCheckBox}"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
						</StackPanel>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button x:Name="NewBtn" Style="{StaticResource PopupIconButton}" Click="New_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/new.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="New" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="SaveBtn" Style="{StaticResource PopupIconButton}" Click="Save_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="UpdateBtn" Style="{StaticResource PopupIconButton}" Click="Update_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/edit.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Update" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="DeleteBtn" Style="{StaticResource PopupIconButton}" Click="Delete_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/delete.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Delete" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="GetData_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/get.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Get Data" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
