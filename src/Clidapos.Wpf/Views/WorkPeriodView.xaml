<Window x:Class="Clidapos.Wpf.Views.WorkPeriodView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Work Period"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppOverlay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
                    <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
                </Button>

                <TextBlock Grid.Column="1" Text="WORK PERIOD" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>

                    <Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
                        <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <Border Background="#1A1A1F" CornerRadius="14" Padding="30">
                <StackPanel>
                    <TextBlock Text="PERIOD STATUS" Foreground="#888888" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Checking..." Foreground="White" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,4"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailText" Foreground="#888888" FontSize="13"
                               HorizontalAlignment="Center" TextAlignment="Center"/>

                    <Button x:Name="StartButton" Content="START PERIOD" Background="#34C759"
                            Style="{StaticResource ActionBtn}" Margin="0,24,0,0" Click="StartPeriod_Click"
                            Visibility="Collapsed"/>

                    <Button x:Name="SummaryButton" Content="VIEW SUMMARY / END PERIOD" Background="#DC143C"
                            Style="{StaticResource ActionBtn}" Margin="0,24,0,0" Click="GoToSummary_Click"
                            Visibility="Collapsed"/>

                    <Button Content="BACK TO FRONT OFFICE" Background="#3A3A42"
                            Style="{StaticResource ActionBtn}" Margin="0,12,0,0" Click="Back_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>