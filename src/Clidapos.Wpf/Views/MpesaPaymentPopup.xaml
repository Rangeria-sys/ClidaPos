<Window x:Class="Clidapos.Wpf.Views.MpesaPaymentPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M-Pesa Payment"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Width="420" SizeToContent="Height" Background="Transparent"
        AllowsTransparency="True" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="M-PESA PAYMENT" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button x:Name="CloseButton" Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
                </Button>
            </Grid>

            <!-- ENTRY STATE -->
            <StackPanel x:Name="EntryPanel">
                <Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="AMOUNT DUE" Foreground="#8A8A92" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="AmountText" FontSize="24" FontWeight="Bold" Foreground="#1C1C1F" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <TextBlock Text="Customer Phone Number" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PhoneInput" Style="{StaticResource PopupInput}" Tag="e.g. 0712345678" Margin="0,0,0,12"/>

                <TextBlock Text="Customer Email (optional, for an email receipt)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EmailInput" Style="{StaticResource PopupInput}" Tag="e.g. customer@email.com" Margin="0,0,0,16"/>

                <Button x:Name="SendPushButton" Content="📱  Send Payment Prompt" Click="SendPush_Click"
                        Style="{StaticResource ActionBtn}" Background="#17A398"/>
            </StackPanel>

            <!-- WAITING STATE -->
            <StackPanel x:Name="WaitingPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                <TextBlock Text="Waiting for customer to complete payment on their phone…"
                           Foreground="#1C1C1F" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,20"/>
                <TextBlock x:Name="ElapsedText" Text="0s" Foreground="#8A8A92" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <Button Content="Cancel" Click="CancelWait_Click" Style="{StaticResource ActionBtn}" Background="#6B6B72" Width="140"/>
            </StackPanel>

            <!-- RESULT STATE -->
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                <TextBlock x:Name="ResultIcon" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="ResultText" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#1C1C1F" Margin="0,0,0,20"/>
                <Button x:Name="DoneButton" Content="Close" Click="Close_Click" Style="{StaticResource ActionBtn}" Background="#F3A123" Width="140"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>