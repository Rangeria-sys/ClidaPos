<Window x:Class="Clidapos.Wpf.Views.MpesaManualPaymentPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M-Pesa Payment"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Width="440" Height="480">

	<Border Background="White" CornerRadius="12" BorderBrush="#178E86" BorderThickness="2">
		<Grid Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,0,0,18">
				<TextBlock Text="M-PESA PAYMENT" FontSize="16" FontWeight="Bold" Foreground="#0E5E5A"/>
				<Button Click="Close_Click" HorizontalAlignment="Right" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
					<TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#6B6B72"/>
				</Button>
			</Grid>

			<TextBlock Grid.Row="1" Text="Read this out to the customer:" Foreground="#6B6B72" FontSize="13" Margin="0,0,0,10"/>

			<Border Grid.Row="2" Background="#F5F8F8" CornerRadius="8" Padding="18" Margin="0,0,0,16">
				<StackPanel>
					<Grid Margin="0,0,0,10">
						<TextBlock Text="Till / Paybill No" Foreground="#6B6B72" FontSize="12" FontWeight="Bold"/>
						<TextBlock x:Name="ShortcodeText" Foreground="#0E5E5A" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
					</Grid>
					<Grid x:Name="AccountRow" Margin="0,0,0,10">
						<TextBlock Text="Account No" Foreground="#6B6B72" FontSize="12" FontWeight="Bold"/>
						<TextBlock x:Name="AccountText" Foreground="#0E5E5A" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
					</Grid>
					<Grid>
						<TextBlock Text="Amount" Foreground="#6B6B72" FontSize="12" FontWeight="Bold"/>
						<TextBlock x:Name="AmountText" Foreground="Black" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
					</Grid>
				</StackPanel>
			</Border>

			<StackPanel Grid.Row="3" VerticalAlignment="Top">
				<TextBlock Text="M-Pesa Reference (optional)" Foreground="#6B6B72" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
				<TextBox x:Name="ReferenceInput" Background="White" Foreground="Black"
                         BorderBrush="#D3DEDE" BorderThickness="1" Padding="10" FontSize="14"/>
				<TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12" FontWeight="Bold"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
			</StackPanel>

			<Button Grid.Row="4" Content="Customer Has Paid - Confirm" Click="Confirm_Click"
                    Height="52" Background="#34C759" Foreground="White" FontWeight="Bold" FontSize="15"
                    BorderThickness="0" Cursor="Hand"/>
		</Grid>
	</Border>
</Window>
