<Window x:Class="Clidapos.Wpf.Views.SupplierPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<!-- Everything (the dark backdrop AND the white card) lives in this one
         window now, instead of a separate always-on-top overlay window fighting
         with the popup for Z-order. Clicking anywhere on screen necessarily
         lands on this window since it covers the whole screen, so the tile grid
         behind it can't be reached or interacted with - no manual Topmost/
         ShowActivated tricks needed to make that true. -->
	<Grid>
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="460">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="SUPPLIER" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="30" Height="30"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Supplier Code" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="CodeInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Supplier Name "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="NameInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Contact No "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="ContactInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Email "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="EmailInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="City" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="CityInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Bank" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="BankInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Branch" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="BranchInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Account Name" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="AccountNameInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Account Number" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="AccountNumberInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Opening Balance" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="OpeningBalanceInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Balance Type" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" x:Name="OpeningBalanceTypeInput" Style="{StaticResource PopupCombo}">
								<ComboBoxItem Content="Cr (We Owe Them)" IsSelected="True"/>
								<ComboBoxItem Content="Dr (Advance Paid)"/>
							</ComboBox>
						</Grid>

						<TextBlock Text="Address" Style="{StaticResource PopupFieldLabel}" Margin="0,4,0,4"/>
						<TextBox x:Name="AddressInput" Style="{StaticResource PopupInputMultiline}"/>

						<TextBlock Text="Remarks" Style="{StaticResource PopupFieldLabel}" Margin="0,10,0,4"/>
						<TextBox x:Name="RemarksInput" Style="{StaticResource PopupInputMultiline}"/>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button Style="{StaticResource PopupIconButton}" Click="New_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/new.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="New" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="Save_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="Update_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/edit.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Update" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="Delete_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/delete.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Delete" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="GetData_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/get.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Get Data" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
