<Window x:Class="Clidapos.Wpf.Views.MpesaSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M-Pesa API Settings"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="480">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="M-PESA API SETTINGS" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<TextBlock Text="Consumer Key, Consumer Secret and Pass Key are stored encrypted. Only the last 4 characters ever show - clear the field and retype to change one."
                                   Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Consumer Key "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="ConsumerKeyInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Consumer Secret "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="ConsumerSecretInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Shortcode (Till/Paybill)" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="ShortcodeInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Environment &amp; Account Type" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" x:Name="EnvironmentInput" Style="{StaticResource PopupCombo}">
								<ComboBoxItem Content="Sandbox - Paybill"/>
								<ComboBoxItem Content="Sandbox - Till Number"/>
								<ComboBoxItem Content="Production - Paybill"/>
								<ComboBoxItem Content="Production - Till Number"/>
							</ComboBox>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Pass Key "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="PassKeyInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Account Number" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="AccountNumberInput" Style="{StaticResource PopupInput}"/>
						</Grid>
						<TextBlock Text="Shared bank Paybills only, e.g. KCB - leave blank for Till/Buy Goods." Foreground="#8A8A92" FontSize="11" Margin="150,-12,0,14"/>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button Style="{StaticResource PopupIconButton}" Click="Save_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
