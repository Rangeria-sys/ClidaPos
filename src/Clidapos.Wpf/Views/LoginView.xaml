<Window x:Class="Clidapos.Wpf.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clidapos.Wpf.ViewModels"
        Title="Clidapos - Login" Height="560" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8FDD8F" Offset="0"/>
                        <GradientStop Color="#4F9E4F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3"
                                       BlurRadius="4" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="0"
                                               BlurRadius="2" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#3C8D3C" BorderThickness="2"
                    CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center"
                    Height="440">
                <Image Source="pack://application:,,,/Assets/login.jpg" Stretch="UniformToFill"/>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#3C8D3C" BorderThickness="2"
                    CornerRadius="8" Padding="20" VerticalAlignment="Center" Height="440">
                <StackPanel VerticalAlignment="Center">
                    <TextBox Text="{Binding MaskedPin, Mode=OneWay}" IsReadOnly="True" FontSize="22"
                             Padding="10" TextAlignment="Center" Margin="0,0,0,12"
                             Background="White" BorderBrush="#3C8D3C"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D93838"
                               TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                    <UniformGrid Columns="3" Rows="4">
                        <Button Content="1" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="2" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="3" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="4" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="5" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="6" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="7" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="8" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="9" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="Clear" Click="Clear_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="0" Click="Digit_Click" Style="{StaticResource PinButton}"/>
                        <Button Content="Login" Click="Login_Click" Background="#A9D6E5"/>
                    </UniformGrid>

                    <Button Content="Exit" Click="Exit_Click" Background="#E07B39"
                            Foreground="White" Margin="0,16,0,0" Padding="8"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Version 1.0.0" FontSize="11" Foreground="#DDDDDD"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="© 2026 Clidapos. All rights reserved." FontSize="11"
                       Foreground="#DDDDDD" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>