<Window x:Class="Clidapos.Wpf.Views.SalesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clidapos.Wpf.Views"
        Title="Clidapos - Counter Sale"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize">

	<Window.Resources>
		<local:RowNumberConverter x:Key="RowNumberConverter"/>

		<SolidColorBrush x:Key="ChromeBg" Color="#EDF1F1"/>
		<SolidColorBrush x:Key="ChromeBorder" Color="#D3DEDE"/>
		<SolidColorBrush x:Key="TealDark" Color="#0E5E5A"/>
		<SolidColorBrush x:Key="TealMid" Color="#178E86"/>
		<SolidColorBrush x:Key="TealLight" Color="#E4F4F2"/>
		<SolidColorBrush x:Key="AccentOrange" Color="#F3A123"/>

		<Style x:Key="SearchInput" TargetType="TextBox">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="Black"/>
			<Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,10"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		</Style>

		<Style x:Key="PanelInput" TargetType="TextBox">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="Black"/>
			<Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="{StaticResource TealLight}"/>
			<Setter Property="Foreground" Value="{StaticResource TealDark}"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="8,8"/>
			<Setter Property="BorderBrush" Value="{StaticResource TealMid}"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>

		<Style x:Key="ActionBtn" TargetType="Button">
			<Setter Property="Height" Value="44"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="B" Property="Opacity" Value="0.85"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RemoveRowBtn" TargetType="Button">
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="#FBE4E4" CornerRadius="5">
							<TextBlock Text="✕" Foreground="#C0392B" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Left/right column 2-wide compact buttons, toggle-capable for payment mode -->
		<Style x:Key="ColumnToggleBtn" TargetType="RadioButton">
			<Setter Property="Height" Value="96"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{StaticResource TealDark}"/>
			<Setter Property="FontSize" Value="19"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="B" Background="{StaticResource TealLight}" CornerRadius="6"
                                BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="B" Property="Background" Value="{StaticResource AccentOrange}"/>
								<Setter TargetName="B" Property="BorderBrush" Value="#D6890A"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Softer, refined action button - white with a subtle border, left-aligned
             text, matching Design 2. Background/Foreground overridden per-instance
             for the colored variants (Loyalty's light green, Remove/Void's light red). -->
		<Style x:Key="SoftActionBtn" TargetType="Button">
			<Setter Property="Height" Value="50"/>
			<Setter Property="Margin" Value="0,0,0,7"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#2C2C2A"/>
			<Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="13.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="B" Property="Opacity" Value="0.85"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="KeypadBtn" TargetType="Button">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="{StaticResource TealDark}"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}"/>
			<Setter Property="Margin" Value="3"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="B" Property="Background" Value="{StaticResource TealLight}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource ChromeBg}">
		<Grid.RowDefinitions>
			<RowDefinition Height="72"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- TOP BAR - search is top-middle, matching the reference exactly -->
		<Border Grid.Row="0" Background="{StaticResource TealDark}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="BackToGateway_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back to Front Office">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="36" Height="36"/>
				</Button>

				<Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
					<TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
					<TextBlock Text="🔍  Search or scan an item..." Foreground="#9A9AA2" FontSize="13"
                               Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<Popup x:Name="ResultsPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom" Width="560" StaysOpen="True">
						<Border Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1"
                                CornerRadius="0,0,8,8" MaxHeight="280">
							<ListBox x:Name="ResultsList" Background="White" Foreground="Black"
                                     BorderThickness="0" SelectionChanged="ResultsList_SelectionChanged">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid Margin="10,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="{Binding ProductName}" Foreground="Black" FontSize="14" FontWeight="Bold"
                                                       TextWrapping="Wrap"/>
											<TextBlock Grid.Column="1" Text="{Binding Price, StringFormat=N2}" Foreground="{StaticResource TealMid}"
                                                       FontSize="13" FontWeight="Bold" Margin="16,0,0,0"/>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Border>
					</Popup>
				</Grid>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
					<TextBlock x:Name="CashierText" Foreground="#B9E4E0" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
				<Border x:Name="LoyaltyBadge" Background="{StaticResource AccentOrange}" CornerRadius="12" Padding="12,5" Margin="0,0,14,0"
                            Visibility="Collapsed">
						<TextBlock x:Name="LoyaltyBadgeText" Foreground="White" FontSize="11" FontWeight="Bold"/>
					</Border>
					<Button Click="Exit_Click" Width="46" Height="46" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="32" Height="32"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="14">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280"/>
				<ColumnDefinition Width="12"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="12"/>
				<ColumnDefinition Width="150"/>
			</Grid.ColumnDefinitions>

			<!-- LEFT COLUMN - payment method / account shortcuts, matching the reference -->
			<Border Grid.Column="0" Background="White" CornerRadius="8" Padding="8"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1.5">
				<StackPanel VerticalAlignment="Top">
					<TextBlock Text="PAYMENT" Foreground="{StaticResource TealDark}" FontSize="13" FontWeight="Bold" Margin="2,2,0,8"/>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="4"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition/>
							<RowDefinition/>
						</Grid.RowDefinitions>

						<RadioButton Grid.Row="0" Grid.Column="0" Style="{StaticResource ColumnToggleBtn}"
                                 x:Name="CashMode" IsChecked="True" Checked="PaymentMode_Changed">
						<StackPanel>
							<Image Source="pack://application:,,,/Assets/cash.png" Width="40" Height="40" Margin="0,0,0,6" HorizontalAlignment="Center"/>
							<TextBlock Text="CASH" HorizontalAlignment="Center"/>
						</StackPanel>
					</RadioButton>
					<RadioButton Grid.Row="0" Grid.Column="2" Style="{StaticResource ColumnToggleBtn}"
                                 x:Name="MpesaMode" Checked="PaymentMode_Changed">
						<StackPanel>
							<Image Source="pack://application:,,,/Assets/mpesaa.png" Width="40" Height="40" Margin="0,0,0,6" HorizontalAlignment="Center"/>
							<TextBlock Text="M-PESA" HorizontalAlignment="Center"/>
						</StackPanel>
					</RadioButton>
					<RadioButton Grid.Row="1" Grid.Column="0" Style="{StaticResource ColumnToggleBtn}"
                                 x:Name="BankMode" Checked="PaymentMode_Changed">
						<StackPanel>
							<Image Source="pack://application:,,,/Assets/bank.png" Width="40" Height="40" Margin="0,0,0,6" HorizontalAlignment="Center"/>
							<TextBlock Text="BANK" HorizontalAlignment="Center"/>
						</StackPanel>
					</RadioButton>
					<RadioButton Grid.Row="1" Grid.Column="2" Style="{StaticResource ColumnToggleBtn}"
                                 x:Name="CreditMode" Checked="PaymentMode_Changed">
						<StackPanel>
							<Image Source="pack://application:,,,/Assets/credit.png" Width="40" Height="40" Margin="0,0,0,6" HorizontalAlignment="Center"/>
							<TextBlock Text="CREDIT" HorizontalAlignment="Center"/>
						</StackPanel>
					</RadioButton>
					</Grid>

					<Button x:Name="LoyaltyCardBtn" Style="{StaticResource SoftActionBtn}" Click="LoyaltyCard_Click"
                            Background="#E1F5EE" Foreground="#085041" BorderThickness="0">
						<StackPanel Orientation="Horizontal">
							<Image Source="pack://application:,,,/Assets/loyalty.png" Width="24" Height="24" Margin="0,0,8,0"/>
							<TextBlock Text="Loyalty Card" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>

			<!-- CENTER - Lines table, payment details, keypad + summary -->
			<Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1.5">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Border Grid.Row="0" Background="{StaticResource TealLight}" CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
						<TextBlock Text="LINES" Foreground="{StaticResource TealDark}" FontSize="16" FontWeight="Bold"/>
					</Border>

					<DataGrid Grid.Row="1" x:Name="CartGrid" AutoGenerateColumns="False" FontSize="17"
                              Background="White" Foreground="#1C1C1F" BorderThickness="0"
                              RowBackground="White" AlternatingRowBackground="#F5F8F8"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="32"
                              HorizontalGridLinesBrush="#E4EEEE"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CanUserAddRows="False" SelectionMode="Single"
                              AlternationCount="9999"
                              SelectionChanged="CartGrid_SelectionChanged"
                              CellEditEnding="CartGrid_CellEditEnding">
						<DataGrid.Resources>
							<!-- DataGridCell paints its own selected-state background using these
                                 system color keys internally - setting Background on the row alone
                                 via a trigger gets painted over by the cells unless these are also
                                 overridden here. -->
								<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#F3A123"/>
								<SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
								<SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F3A123"/>
							</DataGrid.Resources>
							<DataGrid.RowStyle>
								<Style TargetType="DataGridRow">
									<Setter Property="MinHeight" Value="48"/>
									<Setter Property="FontWeight" Value="SemiBold"/>
									<Style.Triggers>
										<!-- Orange the entire time a line is selected (ready to be
                                         edited via Remove/Change Qty/the keypad), plain again
                                         the moment it's deselected - one clear state instead
                                         of two, avoiding the earlier yellow-vs-orange confusion. -->
										<Trigger Property="IsSelected" Value="True">
											<Setter Property="Background" Value="{StaticResource AccentOrange}"/>
											<Setter Property="Foreground" Value="White"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</DataGrid.RowStyle>
						<DataGrid.RowHeaderTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource RowNumberConverter}}"
                                           Foreground="#8A8A94" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</DataTemplate>
						</DataGrid.RowHeaderTemplate>
						<DataGrid.Columns>
							<DataGridTextColumn Header="Item ID" Binding="{Binding ProductCode}" Width="90" IsReadOnly="True"/>
							<DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
							<DataGridTextColumn Header="Price" Binding="{Binding Rate, StringFormat=N2}" Width="90" IsReadOnly="True"/>
							<DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" Width="70"/>
							<DataGridTextColumn Header="Total" Binding="{Binding Amount, StringFormat=N2}" Width="100" IsReadOnly="True"/>
							<DataGridTemplateColumn Header="" Width="44" CanUserResize="False">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Button Style="{StaticResource RemoveRowBtn}" Click="RemoveLineButton_Click" Tag="{Binding}"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>

					<!-- KEYPAD (left) + SUMMARY (right) -->
					<Grid Grid.Row="2" Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="330"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Border Grid.Column="0" Background="{StaticResource ChromeBg}" CornerRadius="8" Padding="10">
							<StackPanel>
								<TextBlock Text="QUANTITY" Foreground="{StaticResource TealDark}" FontSize="13" FontWeight="Bold" Margin="2,0,0,4"/>
								<TextBox x:Name="QtyKeypadInput" Style="{StaticResource PanelInput}"
                                         TextAlignment="Right" FontSize="20" Height="46" Padding="10,8" Margin="0,0,0,8"
                                         GotFocus="KeypadTarget_GotFocus" KeyDown="QtyKeypadInput_KeyDown"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="56"/>
										<RowDefinition Height="56"/>
										<RowDefinition Height="56"/>
										<RowDefinition Height="56"/>
									</Grid.RowDefinitions>

									<Button Grid.Row="0" Grid.Column="0" Style="{StaticResource KeypadBtn}" Content="7" Click="KeypadDigit_Click"/>
									<Button Grid.Row="0" Grid.Column="1" Style="{StaticResource KeypadBtn}" Content="8" Click="KeypadDigit_Click"/>
									<Button Grid.Row="0" Grid.Column="2" Style="{StaticResource KeypadBtn}" Content="9" Click="KeypadDigit_Click"/>
									<Button Grid.Row="0" Grid.Column="3" Style="{StaticResource KeypadBtn}" Content="DEL" Click="KeypadBackspace_Click" FontSize="15"/>

									<Button Grid.Row="1" Grid.Column="0" Style="{StaticResource KeypadBtn}" Content="4" Click="KeypadDigit_Click"/>
									<Button Grid.Row="1" Grid.Column="1" Style="{StaticResource KeypadBtn}" Content="5" Click="KeypadDigit_Click"/>
									<Button Grid.Row="1" Grid.Column="2" Style="{StaticResource KeypadBtn}" Content="6" Click="KeypadDigit_Click"/>
									<Button Grid.Row="1" Grid.Column="3" Style="{StaticResource KeypadBtn}" Content="00" Click="KeypadDigit_Click" FontSize="20"/>

									<Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadBtn}" Content="1" Click="KeypadDigit_Click"/>
									<Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadBtn}" Content="2" Click="KeypadDigit_Click"/>
									<Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadBtn}" Content="3" Click="KeypadDigit_Click"/>
									<Button Grid.Row="2" Grid.Column="3" Style="{StaticResource KeypadBtn}" Content="C" Click="KeypadClear_Click" Foreground="#C0392B"/>

									<Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource KeypadBtn}" Content="0" Click="KeypadDigit_Click"/>
									<Button Grid.Row="3" Grid.Column="3" Style="{StaticResource KeypadBtn}" Content="OK" Click="ApplyQty_Click"
                                            Background="{StaticResource AccentOrange}" Foreground="White"/>
								</Grid>
							</StackPanel>
						</Border>

						<Grid Grid.Column="2">
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="10"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<Border Grid.Row="0" Background="{StaticResource ChromeBg}" CornerRadius="8" Padding="18,12">
								<StackPanel VerticalAlignment="Center">
									<Grid Margin="0,0,0,7">
										<TextBlock Text="Lines" Foreground="#5A6B72" FontSize="15" FontWeight="Bold"/>
										<TextBlock x:Name="LinesCountText" Text="0" Foreground="Black" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
									</Grid>
									<Grid Margin="0,0,0,7">
										<TextBlock Text="Total Items" Foreground="#5A6B72" FontSize="15" FontWeight="Bold"/>
										<TextBlock x:Name="ItemCountText" Text="0" Foreground="Black" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
									</Grid>
									<Grid Margin="0,0,0,7">
										<TextBlock Text="Discount %" Foreground="#5A6B72" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
											<TextBox x:Name="DiscountInput" Width="50" Background="White" Foreground="Black"
                                                     BorderBrush="{StaticResource ChromeBorder}" Padding="4" FontSize="15"
                                                     HorizontalContentAlignment="Center"
                                                     GotFocus="KeypadTarget_GotFocus"
                                                     TextChanged="DiscountInput_TextChanged"/>
											<TextBlock Text="%" Foreground="Black" FontSize="15" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
										</StackPanel>
									</Grid>
									<Grid Margin="0,0,0,7">
										<TextBlock Text="Discount Amount" Foreground="#5A6B72" FontSize="15" FontWeight="Bold"/>
										<TextBlock x:Name="DiscountAmountText" Text="0.00" Foreground="{StaticResource AccentOrange}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
									</Grid>
									<Grid Margin="0,0,0,7">
										<TextBlock Text="Subtotal" Foreground="#5A6B72" FontSize="15" FontWeight="Bold"/>
										<TextBlock x:Name="SubtotalText" Text="0.00" Foreground="Black" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
									</Grid>
									<Grid>
										<TextBlock Text="Tax (VAT)" Foreground="#5A6B72" FontSize="15" FontWeight="Bold"/>
										<TextBlock x:Name="VatBreakdownText" Text="0.00" Foreground="Black" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
									</Grid>
								</StackPanel>
							</Border>

							<!-- The prominent total, in its own dark card - this is the "so big"
                                 total. GrandTotalText is also what the bottom bar's amount-due
                                 display reads from via a binding, so both update together. -->
							<Border Grid.Row="2" Background="{StaticResource TealDark}" CornerRadius="8" Padding="18,14">
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="TOTAL DUE" Foreground="#9FE1CB" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
									<TextBlock x:Name="GrandTotalText" Text="0.00" Foreground="White"
                                               FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
						</Grid>
					</Grid>
				</Grid>
			</Border>

			<!-- RIGHT COLUMN - cart/transaction actions, matching the reference -->
			<Border Grid.Column="4" Background="White" CornerRadius="8" Padding="8"
                    BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1.5">
				<StackPanel VerticalAlignment="Top">
					<TextBlock Text="ACTIONS" Foreground="{StaticResource TealDark}" FontSize="13" FontWeight="Bold" Margin="2,2,0,8"/>

					<Button Style="{StaticResource SoftActionBtn}" Content="Remove" Background="#FCEBEB" Foreground="#C0392B" BorderThickness="0" Click="RemoveSelectedLine_Click"/>
					<Button Style="{StaticResource SoftActionBtn}" Content="Change Qty" Click="ChangeQty_Click"/>
					<Button Style="{StaticResource SoftActionBtn}" Content="Hold Sale" Click="HoldSale_Click"/>
					<Button Style="{StaticResource SoftActionBtn}" Content="Void Sale" Background="#FCEBEB" Foreground="#C0392B" BorderThickness="0" Click="ClearCart_Click"/>
					<Button Style="{StaticResource SoftActionBtn}" Content="New Sale" Click="NewSale_Click"/>
					<Button Style="{StaticResource SoftActionBtn}" Content="Sales History" Click="GetData_Click"/>
				</StackPanel>
			</Border>
		</Grid>

		<!-- BOTTOM BAR - payment details, a very big total, and pay -->
		<Border Grid.Row="2" Background="{StaticResource TealDark}" Padding="24,14">
			<Grid>
				<TextBlock x:Name="ErrorText" Foreground="#FFB4B4" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"
                           VerticalAlignment="Top" HorizontalAlignment="Left"/>

				<Grid HorizontalAlignment="Right" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="30"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="30"/>
						<ColumnDefinition Width="240"/>
					</Grid.ColumnDefinitions>

					<StackPanel x:Name="CashDetailsPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
						<StackPanel Margin="0,0,18,0">
							<TextBlock Text="RECEIVED" Foreground="#B9E4E0" FontSize="11" FontWeight="Bold"/>
							<TextBox x:Name="AmountReceivedInput" Style="{StaticResource PanelInput}"
                                     Width="140" FontSize="18" TextChanged="AmountReceived_TextChanged"
                                     KeyDown="AmountReceivedInput_KeyDown" GotFocus="KeypadTarget_GotFocus"/>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="CHANGE" Foreground="#B9E4E0" FontSize="11" FontWeight="Bold"/>
							<TextBlock x:Name="ChangeText" Text="0.00" Foreground="{StaticResource AccentOrange}"
                                       FontSize="22" FontWeight="Bold"/>
						</StackPanel>
					</StackPanel>

					<StackPanel x:Name="CreditDetailsPanel" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed">
						<TextBlock Text="CUSTOMER (buying on credit)" Foreground="#B9E4E0" FontSize="11" FontWeight="Bold"/>
						<ComboBox x:Name="CreditCustomerCombo"
                                  Background="White" Foreground="Black"
                                  BorderBrush="{StaticResource ChromeBorder}" Padding="8"
                                  DisplayMemberPath="Name" IsEditable="True" FontSize="14" Width="260" HorizontalAlignment="Left">
							<ComboBox.ItemContainerStyle>
								<Style TargetType="ComboBoxItem">
									<Setter Property="Background" Value="White"/>
									<Setter Property="Foreground" Value="Black"/>
								</Style>
							</ComboBox.ItemContainerStyle>
						</ComboBox>
					</StackPanel>

					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="AMOUNT DUE" Foreground="#B9E4E0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
						<TextBlock Text="{Binding Text, ElementName=GrandTotalText}" Foreground="{StaticResource AccentOrange}"
                                   FontSize="48" FontWeight="Bold" HorizontalAlignment="Right"/>
					</StackPanel>

					<Button Grid.Column="4" x:Name="PayButton" Content="PAY" Background="#34C759"
                            Style="{StaticResource ActionBtn}" Height="64" FontSize="22" Click="CompleteSale_Click"/>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</Window>
