<Window x:Class="Clidapos.Wpf.Views.HotelProfilePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Business Profile"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="440">
				<StackPanel>

					<!-- Sleek header - solid dark bar, title only, no watermark graphic. -->
					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="BUSINESS PROFILE" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<StackPanel Margin="20">

						<!-- LOGO - shown/hidden based on the "Show Logo on Receipt" setting below. -->
						<Grid x:Name="LogoPanel" Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0" Width="60" Height="60" Background="#F0F0F3"
                                    BorderBrush="#B0B0B8" BorderThickness="1.3" CornerRadius="6">
								<Image x:Name="LogoPreview" Stretch="Uniform" Margin="4"/>
							</Border>

							<StackPanel Grid.Column="2" VerticalAlignment="Center">
								<TextBlock x:Name="LogoStatusText" Text="No logo set" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,6"/>
								<StackPanel Orientation="Horizontal">
									<Button Content="Browse..." Click="BrowseLogo_Click" Style="{StaticResource PopupSmallBtn}"
                                            Width="80" Height="26" FontSize="10.5" Margin="0,0,6,0"/>
									<Button Content="Remove" Click="RemoveLogo_Click" Style="{StaticResource PopupSmallBtn}"
                                            Width="80" Height="26" FontSize="10.5" Background="#B23A3A"/>
								</StackPanel>
							</StackPanel>
						</Grid>

						<!-- Every field: label on the left, input on the right, same row. -->
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Business Name "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="NameInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Till / Paybill No" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="Address1Input" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Account Number" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="Address2Input" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Address" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="Address3Input" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Contact No "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="ContactInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Email "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="EmailInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Show Logo on Receipt" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" x:Name="ShowLogoInput" Style="{StaticResource PopupCombo}"
                                      SelectionChanged="ShowLogoInput_SelectionChanged">
								<ComboBoxItem Content="Y"/>
								<ComboBoxItem Content="N"/>
							</ComboBox>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="KRA PIN" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="TinInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<TextBlock Text="Receipt Footer Message" Style="{StaticResource PopupFieldLabel}" Margin="0,4,0,4"/>
						<TextBox x:Name="FooterInput" Style="{StaticResource PopupInputMultiline}"/>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button x:Name="SaveButton" Style="{StaticResource PopupIconButton}" Click="Save_Click" IsEnabled="False">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock x:Name="SaveButtonLabel" Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
