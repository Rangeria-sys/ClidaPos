<Window x:Class="Clidapos.Wpf.Views.EmailSettingListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Email Servers"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

	<Window.Resources>
		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="SearchInput" TargetType="TextBox">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#1E1E24"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderBrush" Value="#4A4A52"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="CaretBrush" Value="#F3A123"/>
			<Setter Property="Padding" Value="14,0,10,0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
								<Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GridHeaderLeft" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Foreground" Value="#F3A123"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="SeparatorBrush" Value="#3A3A42"/>
			<Setter Property="SeparatorVisibility" Value="Visible"/>
		</Style>

		<Style x:Key="GridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderLeft}">
			<Setter Property="HorizontalContentAlignment" Value="Right"/>
		</Style>

		<Style x:Key="CellTextLeft" TargetType="TextBlock">
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>

		<Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellTextLeft}">
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="TextAlignment" Value="Right"/>
		</Style>

		<Style x:Key="ListGridRow" TargetType="DataGridRow">
			<Setter Property="MinHeight" Value="40"/>
			<Setter Property="Background" Value="White"/>
			<Style.Triggers>
				<Trigger Property="AlternationIndex" Value="1">
					<Setter Property="Background" Value="#F7F7F9"/>
				</Trigger>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FDEFD9"/>
				</Trigger>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="#F3A123"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Background="White">
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
						Background="Transparent" BorderThickness="0" Cursor="Hand"
						Margin="15,0,0,0" ToolTip="Back">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
						   Width="42" Height="42"/>
				</Button>

				<TextBlock Grid.Column="1" Text="EMAIL SERVERS" Foreground="#F3A123" FontSize="16"
						   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
							Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
							BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
							   Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
							BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
							   Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="24,20,24,24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,0,0,4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Grid Grid.Column="0" Width="340" HorizontalAlignment="Left">
					<TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" Height="44"
                             TextChanged="SearchBox_TextChanged"/>
					<TextBlock Text="🔍  Search by server name or address..." Foreground="#9A9AA2" FontSize="13"
                               Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>

				<Button Grid.Column="1" Click="AddServer_Click"
                        Height="44" Width="170" HorizontalAlignment="Right"
                        Background="#34C759" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
					<TextBlock Text="+  Add Email Server"/>
				</Button>
			</Grid>

			<Border Grid.Row="1" Background="#EAF2FB" BorderBrush="#2D6CDF" BorderThickness="1" CornerRadius="6"
                    Padding="14,10" Margin="0,0,0,12">
				<TextBlock TextWrapping="Wrap">
					<Run Text="✏️ DOUBLE-CLICK A SERVER TO EDIT" FontWeight="Black" Foreground="#1E4FA8"/>
					<Run Text=" — opens it with Update and Delete available." Foreground="#1C1C1F"/>
				</TextBlock>
			</Border>

			<Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E4E4E8" BorderThickness="1">
				<Border.Effect>
					<DropShadowEffect Color="#000000" ShadowDepth="2" BlurRadius="10" Opacity="0.08"/>
				</Border.Effect>
				<DataGrid x:Name="ServerGrid" AutoGenerateColumns="False"
                          Background="White" Foreground="#1C1C1F" BorderThickness="0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDEDF0"
                          RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource GridHeaderLeft}"
                          RowStyle="{StaticResource ListGridRow}"
                          AlternationCount="2"
                          RowHeight="40" ColumnHeaderHeight="42" MinColumnWidth="60"
                          CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          FontSize="14"
                          MouseDoubleClick="ServerGrid_MouseDoubleClick">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Server Name" Binding="{Binding ServerName}" Width="*"
                                             ElementStyle="{StaticResource CellTextLeft}"/>
						<DataGridTextColumn Header="From Email" Binding="{Binding SMTPAddress}" Width="220"
                                             ElementStyle="{StaticResource CellTextLeft}"/>
						<DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"
                                             HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource CellTextRight}"/>
						<DataGridTextColumn Header="Default" Binding="{Binding IsDefault}" Width="80"
                                             HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource CellTextRight}"/>
						<DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="80"
                                             HeaderStyle="{StaticResource GridHeaderRight}" ElementStyle="{StaticResource CellTextRight}"/>
					</DataGrid.Columns>
				</DataGrid>
			</Border>
		</Grid>
	</Grid>
</Window>
