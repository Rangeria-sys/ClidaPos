<Window x:Class="Clidapos.Wpf.Views.SystemLogsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Logs"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F7">

    <Window.Resources>
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#178E86"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickRangeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0E5E5A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterPill" TargetType="ToggleButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0E5E5A"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#0E5E5A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3A123"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExportBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0E5E5A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Back_Click" ToolTip="Back" Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <TextBlock Text="System Logs" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Minimize_Click" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Exit_Click" ToolTip="Exit">
                        <TextBlock Text="✕" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,30" Width="1000">

                <!-- DATE RANGE + FILTERS CARD -->
                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="From" Foreground="#6B6B72" FontSize="13" Margin="0,0,0,4"/>
                                <DatePicker x:Name="FromDate" Width="150" Height="38"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="To" Foreground="#6B6B72" FontSize="13" Margin="0,0,0,4"/>
                                <DatePicker x:Name="ToDate" Width="150" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ToggleButton x:Name="TodayBtn" Content="Today" Style="{StaticResource QuickRangeToggle}" IsChecked="True" Click="Today_Click"/>
                                <ToggleButton x:Name="ThisWeekBtn" Content="This Week" Style="{StaticResource QuickRangeToggle}" Click="ThisWeek_Click"/>
                            </StackPanel>

                            <TextBox Grid.Column="6" x:Name="UserFilterBox" Height="38" Padding="12" FontSize="13" VerticalAlignment="Bottom"
                                     Background="#F5F5F7" BorderBrush="#D8D8DE" VerticalContentAlignment="Center"
                                     TextChanged="UserFilterBox_TextChanged" Tag="Filter by user…"/>
                        </Grid>

                        <Button Content="Run Report" Style="{StaticResource RunBtn}" HorizontalAlignment="Left" Margin="0,0,0,16" Click="RunReport_Click"/>

                        <Border Height="1" Background="#E4E4E8" Margin="0,0,0,16"/>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="FilterAllBtn" Content="All events" Style="{StaticResource FilterPill}" IsChecked="True" Click="FilterAll_Click"/>
                                <ToggleButton x:Name="FilterWorkBtn" Content="Work periods" Style="{StaticResource FilterPill}" Click="FilterWork_Click"/>
                                <ToggleButton x:Name="FilterSalesBtn" Content="Sales &amp; voids" Style="{StaticResource FilterPill}" Click="FilterSales_Click"/>
                                <ToggleButton x:Name="FilterSettingsBtn" Content="Settings" Style="{StaticResource FilterPill}" Click="FilterSettings_Click"/>
                                <ToggleButton x:Name="FilterLoginsBtn" Content="Logins (hidden)" Style="{StaticResource FilterPill}" Click="FilterLogins_Click"/>
                            </StackPanel>
                            <Button Content="Print" Style="{StaticResource ExportBtn}" HorizontalAlignment="Right" Click="Print_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ANOMALY BANNER -->
                <Border x:Name="AnomalyBanner" Background="#FCEAE6" CornerRadius="10" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Run x:Name="AnomalyCountRun" Foreground="#C0392B" FontWeight="Bold"/>
                        <Run Text=" — a counted-cash entry is far outside the normal range for this account. Reviewed it below." Foreground="#8A5A57"/>
                    </TextBlock>
                </Border>

                <!-- EVENTS LIST -->
                <Border Background="White" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock FontSize="14">
                                <Run x:Name="EventCountRun" Foreground="#1C1C1F" FontWeight="Bold"/>
                                <Run Text=" · " Foreground="#8A8A94"/>
                                <Run x:Name="HiddenLoginsRun" Foreground="#8A8A94"/>
                            </TextBlock>
                        </Grid>
                        <StackPanel x:Name="EventsList"/>
                        <TextBlock x:Name="EmptyText" Text="No events found for this range." Foreground="#8A8A94" FontSize="14"
                                   HorizontalAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed"/>
                        <Button x:Name="ShowLoginsBtn" Content="Show hidden logins for this range" Style="{StaticResource ExportBtn}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Click="ShowLogins_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
