<Window x:Class="Clidapos.Wpf.Views.BankAccountPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank Account"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="640" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<Style x:Key="PopupInput" TargetType="TextBox">
			<Setter Property="Background" Value="#F5F5F7"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>

		<Style x:Key="PopupCombo" TargetType="ComboBox">
			<Setter Property="Background" Value="#F5F5F7"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="IsEditable" Value="True"/>
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#6B6B72"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Margin" Value="0,0,0,3"/>
		</Style>

		<Style x:Key="IconActionButton" TargetType="Button">
			<Setter Property="Height" Value="48"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="B" Property="Opacity" Value="0.85"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="IconBtnText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Margin" Value="8,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
		<Border.Effect>
			<DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
		</Border.Effect>
		<StackPanel Margin="24">

			<Grid Margin="0,0,0,16">
				<TextBlock Text="BANK ACCOUNT" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
				<Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
					<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
				</Button>
			</Grid>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="Account No" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="AccountNoInput" Style="{StaticResource PopupInput}" Margin="0,0,0,10"/>

					<TextBlock Text="Account Name" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="AccountNameInput" Style="{StaticResource PopupInput}" Margin="0,0,0,10"/>

					<TextBlock Text="Account Type" Style="{StaticResource FieldLabel}"/>
					<ComboBox x:Name="AccountTypeInput" Style="{StaticResource PopupCombo}" Margin="0,0,0,10">
						<ComboBoxItem Content="Current"/>
						<ComboBoxItem Content="Savings"/>
					</ComboBox>

					<TextBlock Text="Opening Balance" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="BalanceInput" Style="{StaticResource PopupInput}" Text="0" Margin="0,0,0,10"/>

					<TextBlock Text="Active" Style="{StaticResource FieldLabel}"/>
					<ComboBox x:Name="ActiveInput" Style="{StaticResource PopupCombo}" Margin="0,0,0,10">
						<ComboBoxItem Content="Y"/>
						<ComboBoxItem Content="N"/>
					</ComboBox>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="Bank Name" Style="{StaticResource FieldLabel}"/>
					<ComboBox x:Name="BankNameInput" Style="{StaticResource PopupCombo}" Margin="0,0,0,10"/>

					<TextBlock Text="Branch Name" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="BranchNameInput" Style="{StaticResource PopupInput}" Margin="0,0,0,10"/>

					<TextBlock Text="Branch Address" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="BranchAddressInput" Style="{StaticResource PopupInput}" Margin="0,0,0,10"/>

					<TextBlock Text="Branch Contact No" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="BranchContactInput" Style="{StaticResource PopupInput}" Margin="0,0,0,10"/>

					<TextBlock Text="Swift Code" Style="{StaticResource FieldLabel}"/>
					<TextBox x:Name="SwiftCodeInput" Style="{StaticResource PopupInput}" Margin="0,0,0,10"/>
				</StackPanel>
			</Grid>

			<TextBlock Text="Opening Date" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
			<DatePicker x:Name="OpeningDateInput" Margin="0,0,0,14"/>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="8"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="8"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="8"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Style="{StaticResource IconActionButton}" Background="#6B6B72" Click="New_Click">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="➕" FontSize="15"/>
						<TextBlock Text="New" Style="{StaticResource IconBtnText}"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="2" Style="{StaticResource IconActionButton}" Background="#F3A123" Click="Save_Click">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="💾" FontSize="15"/>
						<TextBlock Text="Save" Style="{StaticResource IconBtnText}"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="4" Style="{StaticResource IconActionButton}" Background="#2D6CDF" Click="Update_Click">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="✎" FontSize="15"/>
						<TextBlock Text="Update" Style="{StaticResource IconBtnText}"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="6" Style="{StaticResource IconActionButton}" Background="#17A398" Click="GetData_Click">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="🔍" FontSize="15"/>
						<TextBlock Text="Get Data" Style="{StaticResource IconBtnText}"/>
					</StackPanel>
				</Button>
			</Grid>

			<TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
		</StackPanel>
	</Border>
</Window>