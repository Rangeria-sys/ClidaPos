<Window x:Class="Clidapos.Wpf.Views.BankAccountPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank Account"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="820">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="BANK ACCOUNT" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="20"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
										<Run Text="Account No "/>
										<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
									</TextBlock>
									<Grid Grid.Column="1">
										<TextBox x:Name="AccountNoInput" Style="{StaticResource PopupInputRequired}" Padding="10,0,36,0"/>
										<Button x:Name="RevealAccountNoBtn" Content="👁" Click="RevealAccountNo_Click"
                                                HorizontalAlignment="Right" Width="30" Height="30" Margin="0,0,4,0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"
                                                Visibility="Collapsed"/>
									</Grid>
								</Grid>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
										<Run Text="Account Name "/>
										<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
									</TextBlock>
									<TextBox Grid.Column="1" x:Name="AccountNameInput" Style="{StaticResource PopupInputRequired}"/>
								</Grid>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Account Type" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
									<ComboBox Grid.Column="1" x:Name="AccountTypeInput" Style="{StaticResource PopupCombo}">
										<ComboBoxItem Content="Current"/>
										<ComboBoxItem Content="Savings"/>
									</ComboBox>
								</Grid>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Opening Balance" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" x:Name="BalanceInput" Style="{StaticResource PopupInput}" Text="0"/>
								</Grid>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Active" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
									<ComboBox Grid.Column="1" x:Name="ActiveInput" Style="{StaticResource PopupCombo}">
										<ComboBoxItem Content="Y"/>
										<ComboBoxItem Content="N"/>
									</ComboBox>
								</Grid>

							</StackPanel>

							<StackPanel Grid.Column="2">

								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
										<Run Text="Bank Name "/>
										<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
									</TextBlock>
									<ComboBox Grid.Column="1" x:Name="BankNameInput" Style="{StaticResource PopupCombo}" IsEditable="True"/>
								</Grid>
								<TextBlock Text="Type a name to add a new bank, or pick an existing one." Foreground="#8A8A92" FontSize="11" Margin="110,-2,0,10"/>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
										<Run Text="Branch Name "/>
										<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
									</TextBlock>
									<TextBox Grid.Column="1" x:Name="BranchNameInput" Style="{StaticResource PopupInputRequired}"/>
								</Grid>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Branch Address" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" x:Name="BranchAddressInput" Style="{StaticResource PopupInput}"/>
								</Grid>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Branch Contact No" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" x:Name="BranchContactInput" Style="{StaticResource PopupInput}"/>
								</Grid>

								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Swift Code" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
									<TextBox Grid.Column="1" x:Name="SwiftCodeInput" Style="{StaticResource PopupInput}"/>
								</Grid>

							</StackPanel>
						</Grid>

						<Grid Margin="0,4,0,16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="110"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Opening Date" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<DatePicker Grid.Column="1" x:Name="OpeningDateInput"/>
						</Grid>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button x:Name="NewBtn" Style="{StaticResource PopupIconButton}" Click="New_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/new.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="New" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="SaveBtn" Style="{StaticResource PopupIconButton}" Click="Save_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="UpdateBtn" Style="{StaticResource PopupIconButton}" Click="Update_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/edit.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Update" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="DeleteBtn" Style="{StaticResource PopupIconButton}" Click="Delete_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/delete.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Delete" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="GetData_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/get.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Get Data" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
