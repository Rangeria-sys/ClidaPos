<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ================= CARD / TITLE ================= -->

	<Style x:Key="PopupCard" TargetType="Border">
		<Setter Property="Background" Value="White"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="BorderBrush" Value="#F3A123"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Warm amber-to-orange gradient banner across the top of the card - the
         main "colorful and appealing" upgrade. Corners match the card's own
         rounding on top, square on the bottom where it meets the white body. -->
	<Style x:Key="PopupHeaderBar" TargetType="Border">
		<Setter Property="CornerRadius" Value="11,11,0,0"/>
		<Setter Property="Padding" Value="24,18"/>
		<Setter Property="ClipToBounds" Value="True"/>
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="#FF9B4A" Offset="0"/>
					<GradientStop Color="#F3A123" Offset="0.45"/>
					<GradientStop Color="#D8591F" Offset="1"/>
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.2"/>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="PopupBody" TargetType="StackPanel">
		<Setter Property="Margin" Value="24"/>
	</Style>

	<Style x:Key="PopupTitle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontWeight" Value="Black"/>
		<Setter Property="FontSize" Value="22"/>
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="3" Opacity="0.3"/>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="PopupFieldLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="#1E1E24"/>
		<Setter Property="FontFamily" Value="Segoe UI Semibold"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Margin" Value="0,10,0,4"/>
	</Style>

	<Style x:Key="PopupRequiredMark" TargetType="Run">
		<Setter Property="Foreground" Value="#D93838"/>
	</Style>

	<!-- ================= INPUTS ================= -->

	<!-- Light-grey field on the white card, dark bold text, amber focus ring. -->
	<Style x:Key="PopupInput" TargetType="TextBox">
		<Setter Property="Background" Value="#F0F0F3"/>
		<Setter Property="Foreground" Value="#1C1C1F"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="BorderBrush" Value="#B0B0B8"/>
		<Setter Property="CaretBrush" Value="#F3A123"/>
		<Setter Property="Padding" Value="10,9"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="BorderThickness" Value="1.3"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
						<Border.Effect>
							<DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="2" Opacity="0.12"/>
						</Border.Effect>
						<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="#8A8A92"/>
						</Trigger>
						<Trigger Property="IsFocused" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
							<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Same as PopupInput but taller and word-wrapping, for Address/Remarks. -->
	<!-- Same as PopupInput but with a soft yellow tint, marking a field as
         required (used together with the red asterisk on the label). -->
	<Style x:Key="PopupInputRequired" TargetType="TextBox" BasedOn="{StaticResource PopupInput}">
		<Setter Property="Background" Value="#FFF3C4"/>
		<Setter Property="BorderBrush" Value="#E0B84D"/>
	</Style>

	<Style x:Key="PopupInputMultiline" TargetType="TextBox" BasedOn="{StaticResource PopupInput}">
		<Setter Property="Height" Value="60"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
		<Setter Property="AcceptsReturn" Value="True"/>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		<Setter Property="VerticalContentAlignment" Value="Top"/>
		<Setter Property="Padding" Value="10,8"/>
	</Style>

	<!-- Same look as PopupInput but for ComboBox (Category/Unit style pickers).
         Default ComboBox chrome would render a plain white box with unstyled
         text - this keeps it consistent with the rest of the card. -->
	<Style x:Key="PopupCombo" TargetType="ComboBox">
		<Setter Property="Background" Value="#F0F0F3"/>
		<Setter Property="Foreground" Value="#1C1C1F"/>
		<Setter Property="BorderBrush" Value="#B0B0B8"/>
		<Setter Property="BorderThickness" Value="1.3"/>
		<Setter Property="Padding" Value="10,9"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="ComboBoxItem">
					<Setter Property="Background" Value="White"/>
					<Setter Property="Foreground" Value="#1C1C1F"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Padding" Value="10,7"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ComboBoxItem">
								<Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
									<ContentPresenter/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsHighlighted" Value="True">
										<Setter TargetName="ItemBd" Property="Background" Value="#F3A123"/>
										<Setter Property="Foreground" Value="Black"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>

						<TextBox x:Name="PART_EditableTextBox"
                                 Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="#F3A123" BorderThickness="0" Focusable="True"
                                 Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                 HorizontalAlignment="Left" Visibility="Collapsed"/>

						<ContentPresenter x:Name="ContentSite"
                                 Content="{TemplateBinding SelectionBoxItem}"
                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                 Margin="{TemplateBinding Padding}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>

						<ToggleButton Background="Transparent" BorderThickness="0" ClickMode="Press"
                                 IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
							<ToggleButton.Template>
								<ControlTemplate TargetType="ToggleButton">
									<Border Background="Transparent">
										<Path Data="M0,0 L8,0 L4,6 Z" Fill="#F3A123" HorizontalAlignment="Right" Margin="0,0,12,0"/>
									</Border>
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>

						<Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
							<Border Background="White" BorderBrush="#F3A123" BorderThickness="1" CornerRadius="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220"
                                    Margin="0,2,0,0">
								<Border.Effect>
									<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
								</Border.Effect>
								<ScrollViewer Margin="2" SnapsToDevicePixels="True">
									<ItemsPresenter/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEditable" Value="True">
							<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
							<Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="#8A8A92"/>
						</Trigger>
						<Trigger Property="IsDropDownOpen" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
							<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ================= FLOATING ICON BUTTONS ================= -->
	<!-- Dark chip, colored circle badge, white stroked icon path - the column
         of buttons that floats beside the white card. -->

	<Style x:Key="PopupIconBadge" TargetType="Ellipse">
		<Setter Property="Width" Value="34"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="4" Opacity="0.4"/>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="PopupIconPath" TargetType="Path">
		<Setter Property="Stroke" Value="White"/>
		<Setter Property="StrokeThickness" Value="2"/>
		<Setter Property="StrokeStartLineCap" Value="Round"/>
		<Setter Property="StrokeEndLineCap" Value="Round"/>
		<Setter Property="StrokeLineJoin" Value="Round"/>
	</Style>

	<Style x:Key="PopupIconButton" TargetType="Button">
		<Setter Property="Width" Value="104"/>
		<Setter Property="Height" Value="82"/>
		<Setter Property="Margin" Value="0,0,0,10"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            BorderBrush="#E4E4E8" BorderThickness="1">
						<Border.Effect>
							<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="8" Opacity="0.25"/>
						</Border.Effect>
						<ContentPresenter/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
							<Setter Property="Cursor" Value="Arrow"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="PopupIconLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="#1C1C1F"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="0,5,0,0"/>
	</Style>

	<!-- Small utility buttons - e.g. "Browse..." / "Remove" next to the logo
         preview on the Profile popup. -->
	<Style x:Key="PopupSmallBtn" TargetType="Button">
		<Setter Property="Height" Value="32"/>
		<Setter Property="Background" Value="#6B6B72"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="PopupErrorText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="#D93838"/>
		<Setter Property="FontFamily" Value="Segoe UI Semibold"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Margin" Value="0,12,0,0"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
	</Style>

</ResourceDictionary>
