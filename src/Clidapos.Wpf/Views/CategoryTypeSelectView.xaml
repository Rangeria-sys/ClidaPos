<Window x:Class="Clidapos.Wpf.Views.CategoryTypeSelectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Category Setup"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" Background="#28282F" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Base" Property="Background" Value="#33333C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Foreground" Value="#F3A123"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="SectionPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="0,20,0,14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppOverlay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E24">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="CLIDA POS - CATEGORY SETUP" Foreground="#F3A123" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="WelcomeText" Foreground="#CCCCCC" FontSize="13"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <Button Click="BackToOffice_Click" Style="{StaticResource RoundTopButton}"
                            Margin="0,0,10,0" ToolTip="Back to Back Office">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FFD98F" Offset="0"/>
                                                <GradientStop Color="#F3A123" Offset="0.5"/>
                                                <GradientStop Color="#B5741A" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="⌂" FontSize="18" FontWeight="Bold" Foreground="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="Minimize_Click" Style="{StaticResource RoundTopButton}" Margin="0,0,10,0"
                            ToolTip="Minimize">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FFE9A6" Offset="0"/>
                                                <GradientStop Color="#E8B830" Offset="0.4"/>
                                                <GradientStop Color="#B8860B" Offset="0.85"/>
                                                <GradientStop Color="#8A6408" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="—" FontSize="16" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="Exit_Click" Style="{StaticResource RoundTopButton}" ToolTip="Exit">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FF7B8C" Offset="0"/>
                                                <GradientStop Color="#DC143C" Offset="0.5"/>
                                                <GradientStop Color="#8F0C25" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="White" StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,10,30,20">

                <Border Style="{StaticResource SectionPill}" Background="#4A7FE8">
                    <TextBlock Text="CATEGORY SETUP" Style="{StaticResource SectionPillText}"/>
                </Border>

                <WrapPanel HorizontalAlignment="Center">

                    <Button Style="{StaticResource TileButton}" Click="ItemCategory_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁" Style="{StaticResource TileIcon}"/>
                            <TextBlock Text="Item Category" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TileButton}" Click="UnitCategory_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚖" Style="{StaticResource TileIcon}"/>
                            <TextBlock Text="Unit Category" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TileButton}" Click="ExpenseCategory_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="💵" Style="{StaticResource TileIcon}"/>
                            <TextBlock Text="Expense Category" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
    