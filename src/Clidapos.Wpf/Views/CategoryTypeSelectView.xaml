<Window x:Class="Clidapos.Wpf.Views.CategoryTypeSelectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Category Setup"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" Background="#28282F" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Base" Property="Background" Value="#33333C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="SectionPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="0,20,0,14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppOverlay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BackToOffice_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
                    <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CLIDA POS - CATEGORY SETUP" Foreground="#F3A123" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="WelcomeText" Foreground="#CCCCCC" FontSize="13"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>

                    <Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
                        <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border Style="{StaticResource SectionPill}" Background="#4A7FE8">
                    <TextBlock Text="CATEGORY SETUP" Style="{StaticResource SectionPillText}"/>
                </Border>

                <WrapPanel HorizontalAlignment="Center">

                    <Button Style="{StaticResource TileButton}" Click="ItemCategory_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/itemcategory.png" Width="72" Height="72"/>
                            <TextBlock Text="Item Category" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TileButton}" Click="UnitCategory_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/unitcategory.png" Width="72" Height="72"/>
                            <TextBlock Text="Unit Category" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TileButton}" Click="ExpenseCategory_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/expensecategory.png" Width="72" Height="72"/>
                            <TextBlock Text="Expense Category" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TileButton}" Click="WarehouseType_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/warehousecategory.png" Width="72" Height="72"/>
                            <TextBlock Text="Warehouse Type" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>

            </StackPanel>
        </Grid>
    </Grid>
</Window>