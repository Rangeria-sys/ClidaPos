<Window x:Class="Clidapos.Wpf.Views.PurchaseReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Report"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F7">

    <Window.Resources>
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#178E86"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickRangeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0E5E5A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RunBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3A123"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExportBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0E5E5A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Back_Click" ToolTip="Back" Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <TextBlock Text="Purchase Report" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Minimize_Click" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Exit_Click" ToolTip="Exit">
                        <TextBlock Text="✕" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,30" Width="1000">

                <!-- DATE RANGE CARD -->
                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="DATE RANGE" Style="{StaticResource CardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="From" Foreground="#6B6B72" FontSize="13" Margin="0,0,0,4"/>
                                <DatePicker x:Name="FromDate" Width="150" Height="38"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="To" Foreground="#6B6B72" FontSize="13" Margin="0,0,0,4"/>
                                <DatePicker x:Name="ToDate" Width="150" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ToggleButton x:Name="ThisWeekBtn" Content="This Week" Style="{StaticResource QuickRangeToggle}" Click="ThisWeek_Click"/>
                                <ToggleButton x:Name="ThisMonthBtn" Content="This Month" Style="{StaticResource QuickRangeToggle}" IsChecked="True" Click="ThisMonth_Click"/>
                                <ToggleButton x:Name="ThisYearBtn" Content="This Year" Style="{StaticResource QuickRangeToggle}" Click="ThisYear_Click"/>
                                <Button Content="Run Report" Style="{StaticResource RunBtn}" Margin="8,0,0,0" Click="RunReport_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#E4E4E8" Margin="0,16,0,14"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Print" Style="{StaticResource ExportBtn}" Margin="0,0,0,0" Click="Print_Click"/>
                            <Button Content="Download PDF" Style="{StaticResource ExportBtn}" Click="DownloadPdf_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TOTAL SPENT + OUTSTANDING PAYABLES -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0E5E5A" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="TOTAL SPENT" Foreground="#9FE1CB" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TotalSpentText" Foreground="White" FontSize="36" FontWeight="Bold"/>
                            <TextBlock x:Name="VsLastText" Foreground="#9FE1CB" FontSize="13" Margin="0,6,0,0"/>
                            <Border Height="1" Background="#1E7A75" Margin="0,16,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Orders" Foreground="#9FE1CB" FontSize="13"/>
                                    <TextBlock x:Name="OrderCountText" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Items received" Foreground="#9FE1CB" FontSize="13"/>
                                    <TextBlock x:Name="ItemsReceivedText" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PayablesCard" Grid.Column="2" Background="#FCEAE6" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="OUTSTANDING PAYABLES" Foreground="#C0392B" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="PayablesText" Foreground="#C0392B" FontSize="36" FontWeight="Bold"/>
                            <TextBlock x:Name="PayablesDetailText" Foreground="#8A5A57" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- BY SUPPLIER -->
                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="BY SUPPLIER" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Supplier" Foreground="#8A8A94" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Orders" Foreground="#8A8A94" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="Avg order" Foreground="#8A8A94" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="Last order" Foreground="#8A8A94" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="Total" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="1" Background="#E4E4E8" Margin="0,0,0,8"/>
                        <StackPanel x:Name="SupplierList"/>
                    </StackPanel>
                </Border>

                <!-- TOP PURCHASED ITEMS -->
                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="TOP PURCHASED ITEMS" Style="{StaticResource CardTitle}"/>
                        <StackPanel x:Name="TopItemsList"/>
                    </StackPanel>
                </Border>

                <!-- PURCHASES TABLE -->
                <Border Background="White" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <TextBlock Text="PURCHASES" Style="{StaticResource CardTitle}"/>
                        <Border Background="#FAFAFB" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" Foreground="#8A8A94" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Invoice No" Foreground="#8A8A94" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Supplier" Foreground="#8A8A94" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Status" Foreground="#8A8A94" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Total" Foreground="#8A8A94" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PurchasesList"/>
                        <TextBlock x:Name="EmptyText" Text="No purchases found for this date range."
                                   Foreground="#8A8A94" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
