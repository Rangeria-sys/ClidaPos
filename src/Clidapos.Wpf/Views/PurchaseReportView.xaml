<Window x:Class="Clidapos.Wpf.Views.PurchaseReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Purchase Report"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

	<Window.Resources>
		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="DateBox" TargetType="DatePicker">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="8"/>
		</Style>

		<Style x:Key="QuickRangeBtn" TargetType="Button">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="Margin" Value="0,0,8,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#E4E4E8"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RunBtn" TargetType="Button">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Background" Value="#F3A123"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#D98F1C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="CardBorder" TargetType="Border">
			<Setter Property="Background" Value="#FAFAFB"/>
			<Setter Property="BorderBrush" Value="#E4E4E8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="20"/>
		</Style>

		<Style x:Key="CardTitle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#8A8A92"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>

		<Style x:Key="RowLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#4A4A50"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="RowValue" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="Foreground" Value="#4A4A50"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
				</Button>

				<TextBlock Grid.Column="1" Text="PURCHASE REPORT" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel x:Name="ReportContent" HorizontalAlignment="Center" Margin="0,24,0,30" Width="700">

				<!-- DATE RANGE -->
				<Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
					<StackPanel>
						<TextBlock Text="DATE RANGE" Style="{StaticResource CardTitle}"/>
						<Grid Margin="0,6,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="16"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="From" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,3"/>
								<DatePicker x:Name="FromDate" Style="{StaticResource DateBox}"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="To" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,3"/>
								<DatePicker x:Name="ToDate" Style="{StaticResource DateBox}"/>
							</StackPanel>
						</Grid>

						<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
							<Button Content="This Week" Style="{StaticResource QuickRangeBtn}" Click="ThisWeek_Click"/>
							<Button Content="This Month" Style="{StaticResource QuickRangeBtn}" Click="ThisMonth_Click"/>
							<Button Content="This Year" Style="{StaticResource QuickRangeBtn}" Click="ThisYear_Click"/>
							<Button Content="Run Report" Style="{StaticResource RunBtn}" Click="RunReport_Click"/>
							<Button x:Name="PrintButton" Content="🖨 Print" Style="{StaticResource QuickRangeBtn}"
                                    Margin="8,0,0,0" Click="Print_Click"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<TextBlock x:Name="EmptyText" Text="No purchases found for this date range."
                           Foreground="#8A8A92" FontSize="14" HorizontalAlignment="Center"
                           Margin="0,20,0,0" Visibility="Collapsed"/>

				<!-- RESULTS -->
				<StackPanel x:Name="ResultsPanel" Visibility="Collapsed">

					<Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
						<StackPanel>
							<TextBlock Text="TOTAL SPENT" Style="{StaticResource CardTitle}"/>
							<TextBlock x:Name="GrandTotalText" Text="0.00" Foreground="#B23A3A"
                                       FontSize="42" FontWeight="Bold"/>

							<Border Height="1" Background="#E4E4E8" Margin="0,16,0,14"/>

							<Grid Margin="0,0,0,8">
								<TextBlock Text="Purchase orders" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="PurchaseCountText" Style="{StaticResource RowValue}"/>
							</Grid>
							<Grid>
								<TextBlock Text="Items received" Style="{StaticResource RowLabel}"/>
								<TextBlock x:Name="ItemCountText" Style="{StaticResource RowValue}"/>
							</Grid>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
						<StackPanel>
							<TextBlock Text="BY SUPPLIER" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
							<DataGrid x:Name="SupplierGrid" AutoGenerateColumns="False"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                      FontSize="13" Foreground="#1C1C1F">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
									<DataGridTextColumn Header="Orders" Binding="{Binding PurchaseCount, StringFormat=N0}" Width="90"/>
									<DataGridTextColumn Header="Total" Binding="{Binding TotalValue, StringFormat=N2}" Width="140"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource CardBorder}">
						<StackPanel>
							<TextBlock Text="PURCHASES" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
							<DataGrid x:Name="PurchaseGrid" AutoGenerateColumns="False"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                      FontSize="13" Foreground="#1C1C1F">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="120"/>
									<DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" Width="140"/>
									<DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
									<DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</Border>

				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>