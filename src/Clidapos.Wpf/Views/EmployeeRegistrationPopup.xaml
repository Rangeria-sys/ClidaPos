<Window x:Class="Clidapos.Wpf.Views.EmployeeRegistrationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Registration"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="460">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="EMPLOYEE REGISTRATION" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<!-- PHOTO - optional -->
						<Grid Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="12"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0" Width="60" Height="60" Background="#F0F0F3"
                                    BorderBrush="#B0B0B8" BorderThickness="1.3" CornerRadius="6">
								<Image x:Name="PhotoPreview" Stretch="Uniform" Margin="4"/>
							</Border>

							<StackPanel Grid.Column="2" VerticalAlignment="Center">
								<TextBlock x:Name="PhotoStatusText" Text="No photo set (optional)" Foreground="#8A8A92" FontSize="11" Margin="0,0,0,6"/>
								<StackPanel Orientation="Horizontal">
									<Button Content="Browse..." Click="BrowsePhoto_Click" Style="{StaticResource PopupSmallBtn}"
                                            Width="80" Height="26" FontSize="10.5" Margin="0,0,6,0"/>
									<Button Content="Remove" Click="RemovePhoto_Click" Style="{StaticResource PopupSmallBtn}"
                                            Width="80" Height="26" FontSize="10.5" Background="#B23A3A"/>
								</StackPanel>
							</StackPanel>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Employee ID" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="EmployeeIdInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="National ID "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="NationalIdInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Full Name "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="NameInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Address" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="AddressInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="City" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="CityInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Contact No "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="ContactInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Email "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="EmailInput" Style="{StaticResource PopupInputRequired}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Joining Date" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<DatePicker Grid.Column="1" x:Name="JoiningDateInput"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Active" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" x:Name="ActiveInput" Style="{StaticResource PopupCombo}">
								<ComboBoxItem Content="Y"/>
								<ComboBoxItem Content="N"/>
							</ComboBox>
						</Grid>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button x:Name="NewBtn" Style="{StaticResource PopupIconButton}" Click="New_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/new.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="New" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="SaveBtn" Style="{StaticResource PopupIconButton}" Click="Save_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="UpdateBtn" Style="{StaticResource PopupIconButton}" Click="Update_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/edit.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Update" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="DeleteBtn" Style="{StaticResource PopupIconButton}" Click="Delete_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/delete.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Delete" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="GetData_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/get.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Get Data" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
