<Window x:Class="Clidapos.Wpf.Views.ItemsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Items &amp; Ingredients"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

	<Window.Resources>
		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="FormLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#C8C8CE"/>
			<Setter Property="FontFamily" Value="Segoe UI Semibold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="0,10,0,4"/>
		</Style>

		<!-- Dark input box with a clean amber focus ring (instead of the default
             OS blue) so it matches the rest of the app's accent color. -->
		<Style x:Key="FormInput" TargetType="TextBox">
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#3A3A42"/>
			<Setter Property="CaretBrush" Value="#F3A123"/>
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A64"/>
							</Trigger>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Dark ComboBox to match FormInput - the default ComboBox chrome ignores
             Background and renders a plain white box with unreadable black-on-dark
             text, which is the bug this replaces. Supports IsEditable="True". -->
		<Style x:Key="FormCombo" TargetType="ComboBox">
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#3A3A42"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="ItemContainerStyle">
				<Setter.Value>
					<Style TargetType="ComboBoxItem">
						<Setter Property="Background" Value="#1E1E24"/>
						<Setter Property="Foreground" Value="White"/>
						<Setter Property="Padding" Value="10,7"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ComboBoxItem">
									<Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
										<ContentPresenter/>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsHighlighted" Value="True">
											<Setter TargetName="ItemBd" Property="Background" Value="#F3A123"/>
											<Setter Property="Foreground" Value="Black"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>

							<TextBox x:Name="PART_EditableTextBox"
                                     Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#F3A123" BorderThickness="0" Focusable="True"
                                     Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                     HorizontalAlignment="Left" Visibility="Collapsed"/>

							<ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>

							<ToggleButton Background="Transparent" BorderThickness="0" ClickMode="Press"
                                     IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="Transparent">
											<Path Data="M0,0 L8,0 L4,6 Z" Fill="#F3A123" HorizontalAlignment="Right" Margin="0,0,12,0"/>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
								<Border Background="#1E1E24" BorderBrush="#F3A123" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220"
                                        Margin="0,2,0,0">
									<ScrollViewer Margin="2" SnapsToDevicePixels="True">
										<ItemsPresenter/>
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsEditable" Value="True">
								<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
								<Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A64"/>
							</Trigger>
							<Trigger Property="IsDropDownOpen" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RequiredMark" TargetType="Run">
			<Setter Property="Foreground" Value="#E85D5D"/>
		</Style>

		<!-- Icon badges - same colored-circle + white-stroke-path pattern already
             used for the Kitchen Display tile on Front Office, reused here so the
             CRUD buttons get real scalable icons instead of text glyphs. -->
		<Style x:Key="IconBadge" TargetType="Ellipse">
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="4" Opacity="0.4"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="IconPath" TargetType="Path">
			<Setter Property="Stroke" Value="White"/>
			<Setter Property="StrokeThickness" Value="2"/>
			<Setter Property="StrokeStartLineCap" Value="Round"/>
			<Setter Property="StrokeEndLineCap" Value="Round"/>
			<Setter Property="StrokeLineJoin" Value="Round"/>
		</Style>

		<Style x:Key="IconActionButton" TargetType="Button">
			<Setter Property="Width" Value="96"/>
			<Setter Property="Height" Value="72"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="#1E1E24"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="#3A3A42" BorderThickness="1">
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#F3A123"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="IconLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontFamily" Value="Segoe UI Semibold"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,5,0,0"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#1E1E24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Click="BackToOffice_Click" Width="56" Height="56"
						Background="Transparent" BorderThickness="0" Cursor="Hand"
						Margin="15,0,0,0" ToolTip="Back">
					<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
						   Width="42" Height="42"/>
				</Button>

				<TextBlock Grid.Column="1" Text="ITEMS &amp; INGREDIENTS REGISTRY" Foreground="#F3A123" FontSize="16"
						   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
							Margin="0,0,15,0">

					<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
							BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
						<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
							   Width="42" Height="42"/>
					</Button>

					<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
							BorderThickness="0" Cursor="Hand" ToolTip="Exit">
						<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
							   Width="42" Height="42"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Background="{StaticResource AppOverlay}">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20">

					<Border Background="#1A1A1F" CornerRadius="10" Padding="24" Width="400"
                            BorderBrush="#2C2C34" BorderThickness="1">
						<Border.Effect>
							<DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
						</Border.Effect>
						<StackPanel>
							<TextBlock x:Name="FormTitle" Text="New Item" Foreground="#F3A123"
                                       FontFamily="Segoe UI" FontWeight="Black" FontSize="20" Margin="0,0,0,4"/>

							<TextBlock Text="Product Code" Style="{StaticResource FormLabel}"/>
							<TextBox x:Name="CodeInput" Style="{StaticResource FormInput}"/>

							<TextBlock Style="{StaticResource FormLabel}">
								<Run Text="Product Name "/>
								<Run Text="*" Style="{StaticResource RequiredMark}"/>
							</TextBlock>
							<TextBox x:Name="NameInput" Style="{StaticResource FormInput}"/>

							<TextBlock Style="{StaticResource FormLabel}">
								<Run Text="Category "/>
								<Run Text="*" Style="{StaticResource RequiredMark}"/>
							</TextBlock>
							<ComboBox x:Name="CategoryInput" Style="{StaticResource FormCombo}" IsEditable="True"/>

							<TextBlock Style="{StaticResource FormLabel}">
								<Run Text="Unit "/>
								<Run Text="*" Style="{StaticResource RequiredMark}"/>
							</TextBlock>
							<ComboBox x:Name="UnitInput" Style="{StaticResource FormCombo}" IsEditable="True"/>

							<TextBlock Style="{StaticResource FormLabel}">
								<Run Text="Selling Price "/>
								<Run Text="*" Style="{StaticResource RequiredMark}"/>
							</TextBlock>
							<TextBox x:Name="PriceInput" Style="{StaticResource FormInput}"/>

							<TextBlock Style="{StaticResource FormLabel}">
								<Run Text="Buying Price "/>
								<Run Text="*" Style="{StaticResource RequiredMark}"/>
							</TextBlock>
							<TextBox x:Name="BuyingPriceInput" Style="{StaticResource FormInput}"/>

							<TextBlock Text="Quantity" Style="{StaticResource FormLabel}"/>
							<TextBox x:Name="QuantityInput" Style="{StaticResource FormInput}"/>

							<TextBlock Style="{StaticResource FormLabel}">
								<Run Text="Reorder Point "/>
								<Run Text="*" Style="{StaticResource RequiredMark}"/>
							</TextBlock>
							<TextBox x:Name="ReorderInput" Style="{StaticResource FormInput}"/>

							<TextBlock Text="Supplier" Style="{StaticResource FormLabel}"/>
							<TextBox x:Name="SupplierInput" Style="{StaticResource FormInput}"/>

							<TextBlock x:Name="ErrorText" Foreground="#E85D5D" FontFamily="Segoe UI Semibold"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
						</StackPanel>
					</Border>

					<StackPanel Margin="20,0,0,0" VerticalAlignment="Center">

					<Button Style="{StaticResource IconActionButton}" Click="NewItem_Click">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<Grid Width="34" Height="34">
								<Ellipse Style="{StaticResource IconBadge}" Fill="#28A745"/>
								<Viewbox Width="20" Height="20">
									<Canvas Width="24" Height="24">
										<Path Data="M12,4 L12,20 M4,12 L20,12" Style="{StaticResource IconPath}"/>
									</Canvas>
								</Viewbox>
							</Grid>
							<TextBlock Text="New" Style="{StaticResource IconLabel}"/>
						</StackPanel>
					</Button>

					<Button Style="{StaticResource IconActionButton}" Click="Save_Click">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<Grid Width="34" Height="34">
								<Ellipse Style="{StaticResource IconBadge}" Fill="#2D6CDF"/>
								<Viewbox Width="20" Height="20">
									<Canvas Width="24" Height="24">
										<Path Data="M4,13 L10,19 L20,6" Style="{StaticResource IconPath}"/>
									</Canvas>
								</Viewbox>
							</Grid>
							<TextBlock Text="Save" Style="{StaticResource IconLabel}"/>
						</StackPanel>
					</Button>

					<Button Style="{StaticResource IconActionButton}" Click="Save_Click">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<Grid Width="34" Height="34">
								<Ellipse Style="{StaticResource IconBadge}" Fill="#F3A123"/>
								<Viewbox Width="20" Height="20">
									<Canvas Width="24" Height="24">
										<Path Data="M4,20 L4,16 L16,4 L20,8 L8,20 Z M14,6 L18,10" Style="{StaticResource IconPath}"/>
									</Canvas>
								</Viewbox>
							</Grid>
							<TextBlock Text="Update" Style="{StaticResource IconLabel}"/>
						</StackPanel>
					</Button>

					<Button Style="{StaticResource IconActionButton}" Click="Delete_Click">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<Grid Width="34" Height="34">
								<Ellipse Style="{StaticResource IconBadge}" Fill="#DC143C"/>
								<Viewbox Width="20" Height="20">
									<Canvas Width="24" Height="24">
										<Path Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L8,20 L16,20 L17,7" Style="{StaticResource IconPath}"/>
									</Canvas>
								</Viewbox>
							</Grid>
							<TextBlock Text="Delete" Style="{StaticResource IconLabel}"/>
						</StackPanel>
					</Button>

					<Button Style="{StaticResource IconActionButton}" Click="GetData_Click">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<Grid Width="34" Height="34">
								<Ellipse Style="{StaticResource IconBadge}" Fill="#7C4DCE"/>
								<Viewbox Width="20" Height="20">
									<Canvas Width="24" Height="24">
										<Path Data="M11,4 A7,7 0 1 0 11.01,4 M16,16 L21,21" Style="{StaticResource IconPath}"/>
									</Canvas>
								</Viewbox>
							</Grid>
							<TextBlock Text="Get Data" Style="{StaticResource IconLabel}"/>
						</StackPanel>
					</Button>

				</StackPanel>

			</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>
