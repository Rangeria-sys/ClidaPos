<Window x:Class="Clidapos.Wpf.Views.PayrollPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run Payroll"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="460">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="RUN PAYROLL" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<Border Background="#FFF3D6" BorderBrush="#F3A123" BorderThickness="1" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,16">
							<TextBlock TextWrapping="Wrap">
								<Run Text="💰 PAYMENT FORM" FontWeight="Black" Foreground="#8A5A00"/>
								<Run Text=" — filling this in and pressing Run Payroll creates a real, saved payment record." Foreground="#1C1C1F"/>
							</TextBlock>
						</Border>

						<Border Background="#F0F0F3" BorderBrush="#D8D8DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
							<StackPanel>
								<TextBlock Text="EMPLOYEE" Foreground="#8A8A92" FontSize="11" FontWeight="Bold"/>
								<TextBlock x:Name="SelectedEmployeeText" Foreground="#1C1C1F" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
							</StackPanel>
						</Border>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Pay Period" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" x:Name="MonthInput" Style="{StaticResource PopupInput}"/>
							<TextBox Grid.Column="3" x:Name="YearInput" Style="{StaticResource PopupInput}"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Amount to Pay "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="GrossInput" Style="{StaticResource PopupInputRequired}"
                                     TextChanged="Recompute_Changed"/>
						</Grid>

						<CheckBox x:Name="DeductionsCheck" Content="Apply Deductions? (NSSF / SHA / Housing Levy / PAYE)"
                                  FontSize="13" FontWeight="Bold" Foreground="#1C1C1F"
                                  Checked="DeductionsCheck_Changed" Unchecked="DeductionsCheck_Changed" Margin="0,0,0,4"/>
						<TextBlock Text="Leave unchecked to pay this amount directly with no deductions - common for small businesses that don't run statutory deductions."
                                   Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

						<StackPanel x:Name="DeductionsPanel" Visibility="Collapsed">

							<Border Background="#F7F7F9" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
								<StackPanel>

									<Grid Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="70"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="90"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="NSSF %" VerticalAlignment="Center" Foreground="#1C1C1F" FontWeight="SemiBold" FontSize="13"/>
										<TextBox Grid.Column="2" x:Name="NssfPerInput" Style="{StaticResource PopupInput}" Text="6" TextChanged="Recompute_Changed"/>
										<TextBlock Grid.Column="4" x:Name="NssfAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F" FontWeight="Bold"/>
									</Grid>

									<Grid Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="70"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="90"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="SHA %" VerticalAlignment="Center" Foreground="#1C1C1F" FontWeight="SemiBold" FontSize="13"/>
										<TextBox Grid.Column="2" x:Name="ShaPerInput" Style="{StaticResource PopupInput}" Text="2.75" TextChanged="Recompute_Changed"/>
										<TextBlock Grid.Column="4" x:Name="ShaAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F" FontWeight="Bold"/>
									</Grid>

									<Grid Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="70"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="90"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="Housing Levy %" VerticalAlignment="Center" Foreground="#1C1C1F" FontWeight="SemiBold" FontSize="13"/>
										<TextBox Grid.Column="2" x:Name="HousingPerInput" Style="{StaticResource PopupInput}" Text="1.5" TextChanged="Recompute_Changed"/>
										<TextBlock Grid.Column="4" x:Name="HousingAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F" FontWeight="Bold"/>
									</Grid>

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="70"/>
											<ColumnDefinition Width="10"/>
											<ColumnDefinition Width="90"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="PAYE %" VerticalAlignment="Center" Foreground="#1C1C1F" FontWeight="SemiBold" FontSize="13"/>
										<TextBox Grid.Column="2" x:Name="PayePerInput" Style="{StaticResource PopupInput}" Text="10" TextChanged="Recompute_Changed"/>
										<TextBlock Grid.Column="4" x:Name="PayeAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F" FontWeight="Bold"/>
								</Grid>

							</StackPanel>
						</Border>

						</StackPanel>

						<Border Background="#1A1A1F" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
							<Grid>
								<TextBlock Text="NET PAY" Foreground="#B8B8C0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
								<TextBlock x:Name="NetPayText" Text="0.00" Foreground="#34C759" FontSize="22" FontWeight="Black"
                                           HorizontalAlignment="Right"/>
							</Grid>
						</Border>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button x:Name="SaveTileBtn" Style="{StaticResource PopupIconButton}" Click="Save_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Run Payroll" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="UpdateTileBtn" Style="{StaticResource PopupIconButton}" Click="Update_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/edit.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Update" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="DeleteTileBtn" Style="{StaticResource PopupIconButton}" Click="Delete_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/delete.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Delete" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="GetData_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/get.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Get Data" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
