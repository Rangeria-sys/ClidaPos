<Window x:Class="Clidapos.Wpf.Views.PayrollPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run Payroll"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="520" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtnText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="RUN PAYROLL" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Width="30" Height="30" Background="Transparent" Foreground="#888888"
                        FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="Search Employee" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource PopupInput}"
                     TextChanged="SearchBox_TextChanged" Margin="0,0,0,4"/>
            <ListBox x:Name="ResultsList" MaxHeight="120" Margin="0,0,0,10"
                     SelectionChanged="ResultsList_SelectionChanged"
                     DisplayMemberPath="EmployeeName" BorderBrush="#D8D8DE"/>

            <TextBlock x:Name="SelectedEmployeeText" FontWeight="Bold" Foreground="#1C1C1F"
                       FontSize="14" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Month" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MonthInput" Style="{StaticResource PopupInput}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="YearInput" Style="{StaticResource PopupInput}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Gross Salary" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="GrossInput" Style="{StaticResource PopupInput}"
                     TextChanged="Recompute_Changed" Margin="0,0,0,12"/>

            <TextBlock Text="Deduction rates below are simple flat percentages you can adjust - verify against current KRA / NSSF / SHA published rates."
                       Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NSSF %" VerticalAlignment="Center" Foreground="#1C1C1F"/>
                <TextBox Grid.Column="2" x:Name="NssfPerInput" Style="{StaticResource PopupInput}" Text="6" TextChanged="Recompute_Changed"/>
                <TextBlock Grid.Column="4" x:Name="NssfAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SHA %" VerticalAlignment="Center" Foreground="#1C1C1F"/>
                <TextBox Grid.Column="2" x:Name="ShaPerInput" Style="{StaticResource PopupInput}" Text="2.75" TextChanged="Recompute_Changed"/>
                <TextBlock Grid.Column="4" x:Name="ShaAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Housing Levy %" VerticalAlignment="Center" Foreground="#1C1C1F"/>
                <TextBox Grid.Column="2" x:Name="HousingPerInput" Style="{StaticResource PopupInput}" Text="1.5" TextChanged="Recompute_Changed"/>
                <TextBlock Grid.Column="4" x:Name="HousingAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PAYE %" VerticalAlignment="Center" Foreground="#1C1C1F"/>
                <TextBox Grid.Column="2" x:Name="PayePerInput" Style="{StaticResource PopupInput}" Text="10" TextChanged="Recompute_Changed"/>
                <TextBlock Grid.Column="4" x:Name="PayeAmountText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#1C1C1F"/>
            </Grid>

            <Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <TextBlock Text="NET PAY" Foreground="#8A8A92" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="NetPayText" Text="0.00" FontSize="22" FontWeight="Bold"
                               Foreground="#1C1C1F" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <Button Style="{StaticResource IconActionButton}" Background="#F3A123" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="16"/>
                    <TextBlock Text="Save Payroll Run" Style="{StaticResource IconBtnText}"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>