<Window x:Class="Clidapos.Wpf.Views.ExpenseCategoryPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expense Category"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="480" Height="580"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PopupBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="EXPENSE CATEGORY" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Width="30" Height="30" Background="Transparent" Foreground="#888888"
                        FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="Expense Type Name" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <TextBox Grid.Row="2" x:Name="NameInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

            <WrapPanel Grid.Row="3" Margin="0,0,0,12">
                <Button Content="New" Click="New_Click" Style="{StaticResource PopupBtn}" Background="#6B6B72"/>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource PopupBtn}" Background="#F3A123"/>
                <Button Content="Update" Click="Update_Click" Style="{StaticResource PopupBtn}" Background="#2D6CDF"/>
                <Button Content="Delete" Click="Delete_Click" Style="{StaticResource PopupBtn}" Background="#DC143C"/>
                <Button Content="Get Data" Click="GetData_Click" Style="{StaticResource PopupBtn}" Background="#17A398"/>
            </WrapPanel>

            <Border Grid.Row="4" Background="#F5F5F7" CornerRadius="8" Padding="4">
                <ListBox x:Name="ItemList" SelectionChanged="ItemList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Foreground="#1C1C1F" FontSize="14"/>
            </Border>

            <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>