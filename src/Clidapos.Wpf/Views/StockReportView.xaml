<Window x:Class="Clidapos.Wpf.Views.StockReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Stock Report"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="QuickRangeBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E4E4E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFB"/>
            <Setter Property="BorderBrush" Value="#E4E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A92"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4A4A50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="Foreground" Value="#4A4A50"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E24">
            <Grid>
                <TextBlock Text="STOCK REPORT" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <Button Click="Back_Click" Style="{StaticResource RoundTopButton}"
                            Margin="0,0,10,0" ToolTip="Back">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FFD98F" Offset="0"/>
                                                <GradientStop Color="#F3A123" Offset="0.5"/>
                                                <GradientStop Color="#B5741A" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="⌂" FontSize="18" FontWeight="Bold" Foreground="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="Minimize_Click" Style="{StaticResource RoundTopButton}" Margin="0,0,10,0"
                            ToolTip="Minimize">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FFE9A6" Offset="0"/>
                                                <GradientStop Color="#E8B830" Offset="0.4"/>
                                                <GradientStop Color="#B8860B" Offset="0.85"/>
                                                <GradientStop Color="#8A6408" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="—" FontSize="16" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="Exit_Click" Style="{StaticResource RoundTopButton}" ToolTip="Exit">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FF7B8C" Offset="0"/>
                                                <GradientStop Color="#DC143C" Offset="0.5"/>
                                                <GradientStop Color="#8F0C25" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="White" StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReportContent" HorizontalAlignment="Center" Margin="0,24,0,30" Width="700">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                    <Button x:Name="PrintButton" Content="🖨 Print" Style="{StaticResource QuickRangeBtn}" Click="Print_Click"/>
                </StackPanel>

                <!-- SUMMARY -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="INVENTORY VALUE (AT RETAIL PRICE)" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="TotalValueText" Text="0.00" Foreground="#1B8A3D"
                                   FontSize="42" FontWeight="Bold"/>

                        <Border Height="1" Background="#E4E4E8" Margin="0,16,0,14"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Distinct products" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="ProductCountText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Total units on hand" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="TotalUnitsText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Low stock (10 units or fewer)" Foreground="#B23A3A" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LowStockCountText" Style="{StaticResource RowValue}" Foreground="#B23A3A"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BY CATEGORY -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="BY CATEGORY" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="CategoryGrid" AutoGenerateColumns="False"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                  FontSize="13" Foreground="#1C1C1F">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Products" Binding="{Binding ProductCount, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="Units" Binding="{Binding TotalQty, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding TotalValue, StringFormat=N2}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- LOW STOCK -->
                <Border x:Name="LowStockCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="LOW STOCK (10 UNITS OR FEWER)" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="LowStockGrid" AutoGenerateColumns="False"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#F5F5F7"
                                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                                  FontSize="13" Foreground="#1C1C1F">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
                                <DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse}" Width="140"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=N2}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>