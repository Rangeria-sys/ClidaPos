<Window x:Class="Clidapos.Wpf.Views.DayEndView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Period"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F5F7">

    <Window.Resources>
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#178E86"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="KeypadBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0E5E5A"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D3DEDE"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0E5E5A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Back_Click" ToolTip="Back" Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="CLOSE PERIOD" Foreground="#9FE1CB" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Minimize_Click" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="28" Height="28"/>
                    </Button>
                    <Button Style="{StaticResource HeaderIconBtn}" Click="Close_Click" ToolTip="Close">
                        <TextBlock Text="✕" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <StackPanel Grid.Column="0">

                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="TAKINGS THIS PERIOD" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TakingsText" Text="KSh 0.00" Foreground="#0E5E5A" FontSize="40" FontWeight="Bold"/>
                        <Border Height="1" Background="#E4E4E8" Margin="0,16,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bills" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="BillCountText" Foreground="#1C1C1F" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Items" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="ItemCountText" Foreground="#1C1C1F" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Avg sale" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="AverageText" Foreground="#1C1C1F" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CASH DRAWER" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Opening float" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="OpeningCashText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Cash sales this period" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="CashSalesText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Border Height="1" Background="#E4E4E8" Margin="0,0,0,14"/>
                        <Grid>
                            <TextBlock Text="Expected in drawer" Foreground="#1C1C1F" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="ExpectedCashText" Foreground="#0E5E5A" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="#0E5E5A" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="COUNTED CASH — REQUIRED" Foreground="#0E5E5A" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Count every note and coin in the drawer, then enter the total below before closing."
                                   Foreground="#6B6B72" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KSh" Foreground="#8A8A94" FontSize="26" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="CountedCashText" Text=""
                                     Background="White" Foreground="#1C1C1F" FontSize="26" FontWeight="Bold"
                                     BorderBrush="#D3DEDE" BorderThickness="1" Padding="12" HorizontalContentAlignment="Right"
                                     PreviewTextInput="CountedCashText_PreviewTextInput"
                                     PreviewKeyDown="CountedCashText_PreviewKeyDown"/>
                        </Grid>
                        <TextBlock Text="(leave blank to enter 0)" Foreground="#8A8A94" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT COLUMN -->
            <StackPanel Grid.Column="2">

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ENTER AMOUNT" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource KeypadBtn}" Content="7" Click="Digit_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource KeypadBtn}" Content="8" Click="Digit_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource KeypadBtn}" Content="9" Click="Digit_Click"/>

                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource KeypadBtn}" Content="4" Click="Digit_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource KeypadBtn}" Content="5" Click="Digit_Click"/>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource KeypadBtn}" Content="6" Click="Digit_Click"/>

                            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadBtn}" Content="1" Click="Digit_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadBtn}" Content="2" Click="Digit_Click"/>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadBtn}" Content="3" Click="Digit_Click"/>

                            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource KeypadBtn}" Content="DEL" FontSize="16" Click="Backspace_Click" Foreground="#C0392B"/>
                            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadBtn}" Content="0" Click="Digit_Click"/>
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadBtn}" Content="." Click="Digit_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="VarianceCard" Background="#FCF3E3" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="VARIANCE" Foreground="#B8860B" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="VarianceText" Text="Enter counted cash" Foreground="#B8860B" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="ConfirmButton" Content="Confirm &amp; Close Period" Height="58" FontSize="16" FontWeight="Bold"
                        Foreground="White" Background="#34C759" BorderThickness="0" Click="ConfirmClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Blank counts as 0.00 - the drawer count is still required." Foreground="#8A8A94" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
