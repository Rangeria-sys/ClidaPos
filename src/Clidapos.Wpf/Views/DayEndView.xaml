<Window x:Class="Clidapos.Wpf.Views.DayEndView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Day End"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppOverlay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E24">
            <Grid>
                <TextBlock Text="DAY END SUMMARY" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,15,0">
                    <Button Click="Back_Click" Style="{StaticResource RoundTopButton}"
                            Margin="0,0,10,0" ToolTip="Back to Gateway">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FFD98F" Offset="0"/>
                                                <GradientStop Color="#F3A123" Offset="0.5"/>
                                                <GradientStop Color="#B5741A" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="⌂" FontSize="18" FontWeight="Bold" Foreground="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
					<Button Click="Minimize_Click" Style="{StaticResource RoundTopButton}" Margin="0,0,10,0"
												ToolTip="Minimize">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Ellipse>
										<Ellipse.Fill>
											<RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
												<GradientStop Color="#FFE9A6" Offset="0"/>
												<GradientStop Color="#E8B830" Offset="0.4"/>
												<GradientStop Color="#B8860B" Offset="0.85"/>
												<GradientStop Color="#8A6408" Offset="1"/>
											</RadialGradientBrush>
										</Ellipse.Fill>
										<Ellipse.Effect>
											<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
										</Ellipse.Effect>
									</Ellipse>
									<TextBlock Text="—" FontSize="16" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
							</ControlTemplate>
						</Button.Template>
					</Button>
                    <Button Click="Exit_Click" Style="{StaticResource RoundTopButton}" ToolTip="Exit">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="#FF7B8C" Offset="0"/>
                                                <GradientStop Color="#DC143C" Offset="0.5"/>
                                                <GradientStop Color="#8F0C25" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="White" StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,24" Width="620">

                <TextBlock x:Name="StoreText" Foreground="#F3A123" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="PeriodText" Foreground="#CCCCCC" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="#888888" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>

                <Border Background="#1A1A1F" CornerRadius="12" Padding="24" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="TAKINGS" Foreground="#888888" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="GrandTotalText" Text="0.00" Foreground="#34C759"
                                   FontSize="46" FontWeight="Bold"/>

                        <Border Height="1" Background="#3A3A42" Margin="0,16,0,16"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Sales (bills)" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="BillCountText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Items sold" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="ItemCountText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Average sale" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="AverageText" Style="{StaticResource RowValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1F" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="BY PAYMENT METHOD" Foreground="#888888" FontSize="12"
                                   FontWeight="Bold" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Cash — expected in drawer" Foreground="#34C759" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="CashText" Style="{StaticResource RowValue}" Foreground="#34C759"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="M-Pesa" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="MpesaText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Card" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="CardText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid x:Name="OtherRow" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="Other" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="OtherText" Style="{StaticResource RowValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1F" CornerRadius="12" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="TAX" Foreground="#888888" FontSize="12" FontWeight="Bold"
                                   Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Net of VAT" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="TaxableText" Style="{StaticResource RowValue}"/>
                        </Grid>
                        <Grid>
                            <TextBlock x:Name="VatLabel" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="VatText" Style="{StaticResource RowValue}" Foreground="#F3A123"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="TopItemsCard" Background="#1A1A1F" CornerRadius="12" Padding="24"
                        Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="TOP SELLERS" Foreground="#888888" FontSize="12"
                                   FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="TopItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Qty, StringFormat=N0}" Foreground="#F3A123"
                                                       FontSize="14" FontWeight="Bold" Width="40"/>
                                            <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="14"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Value, StringFormat=N2}" Foreground="White"
                                                   FontSize="14" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button x:Name="ClosePeriodButton" Content="CLOSE THIS PERIOD" Background="#DC143C"
                        Style="{StaticResource ActionBtn}" Margin="0,20,0,0" Click="ClosePeriod_Click"/>

                <Button Content="BACK TO GATEWAY" Background="#3A3A42"
                        Style="{StaticResource ActionBtn}" Margin="0,10,0,0" Click="Back_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>