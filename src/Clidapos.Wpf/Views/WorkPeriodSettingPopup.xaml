<Window x:Class="Clidapos.Wpf.Views.WorkPeriodSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Period Setting" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Width="420" SizeToContent="Height"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PopupCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,16">
                <TextBlock Text="WORK PERIOD SETTING" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" Width="30" Height="30"
                        Background="Transparent" Foreground="#888888" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="These are defaults only - the actual Start/End Work Period buttons on the Front Office still control each day's real open/close."
                       Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Default Start Time (HH:mm)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StartTimeInput" Style="{StaticResource PopupInput}" Tag="e.g. 08:00"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Default End Time (HH:mm)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="EndTimeInput" Style="{StaticResource PopupInput}" Tag="e.g. 20:00"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Auto-Close Enabled" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="AutoCloseInput" Style="{StaticResource PopupCombo}" Margin="0,0,0,12">
                <ComboBoxItem Content="Y"/>
                <ComboBoxItem Content="N"/>
            </ComboBox>

            <TextBlock Text="Reminder (minutes before close)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ReminderInput" Style="{StaticResource PopupInput}" Margin="0,0,0,16"/>

            <Button Content="💾  Save Settings" Click="Save_Click" Style="{StaticResource ActionBtn}" Background="#F3A123"/>
            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>