<Window x:Class="Clidapos.Wpf.Views.GatewayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Gateway"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

	<Window.Resources>
		<Style x:Key="GatewayTile" TargetType="Button">
			<Setter Property="Width" Value="320"/>
			<Setter Property="Height" Value="320"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="44"/>
			<Setter Property="Height" Value="44"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource AppOverlay}">

		<Button Click="Back_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="56" Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                Margin="15,10,0,0" ToolTip="Back to Login">
			<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="42" Height="42"/>
		</Button>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,20,0">
			<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
				<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="42" Height="42"/>
			</Button>
			<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" ToolTip="Exit">
				<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform" Width="42" Height="42"/>
			</Button>
		</StackPanel>

		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
			<TextBlock x:Name="TimeText" Foreground="#DC143C" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
			<TextBlock x:Name="DateText" Foreground="#DDDDDD" FontSize="14" HorizontalAlignment="Center"/>
		</StackPanel>

		<StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,74,0,0">
			<TextBlock x:Name="StoreNameText" Foreground="#DC143C" FontSize="20" FontWeight="Bold"/>
			<TextBlock x:Name="WelcomeText" Foreground="#DDDDDD" FontSize="14"/>
			<Border x:Name="ModeBadge" Background="#F3A123" CornerRadius="4" Padding="8,3"
                    HorizontalAlignment="Left" Margin="0,6,0,0">
				<TextBlock x:Name="ModeText" Foreground="Black" FontSize="11" FontWeight="Bold"/>
			</Border>
		</StackPanel>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Button x:Name="BackOfficeButton" Style="{StaticResource GatewayTile}"
                    Margin="0,0,30,0" Click="BackOffice_Click">
				<Grid>
					<Border CornerRadius="16" ClipToBounds="True" Background="White">
						<Image Source="pack://application:,,,/Assets/back.png" Stretch="UniformToFill"/>
					</Border>
					<Border CornerRadius="16" BorderBrush="#DDDDDD" BorderThickness="1"/>
					<Border Background="#F3A123" CornerRadius="8" Padding="18,10" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
						<Border.Effect>
							<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="6" Opacity="0.5"/>
						</Border.Effect>
						<TextBlock Text="BACK OFFICE" Foreground="Black" FontSize="24" FontWeight="ExtraBold"/>
					</Border>
				</Grid>
			</Button>

			<Button x:Name="FrontOfficeButton" Style="{StaticResource GatewayTile}"
                    Click="FrontOffice_Click">
				<Grid>
					<Border CornerRadius="16" ClipToBounds="True" Background="White">
						<Image Source="pack://application:,,,/Assets/front.png" Stretch="UniformToFill"/>
					</Border>
					<Border CornerRadius="16" BorderBrush="#DDDDDD" BorderThickness="1"/>
					<Border Background="#F3A123" CornerRadius="8" Padding="18,10" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
						<Border.Effect>
							<DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="6" Opacity="0.5"/>
						</Border.Effect>
						<TextBlock Text="FRONT OFFICE" Foreground="Black" FontSize="24" FontWeight="ExtraBold"/>
					</Border>
				</Grid>
			</Button>
		</StackPanel>
	</Grid>
</Window>