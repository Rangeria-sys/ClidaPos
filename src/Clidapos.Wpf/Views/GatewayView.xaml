<Window x:Class="Clidapos.Wpf.Views.GatewayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Gateway"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <Style x:Key="GatewayTile" TargetType="Button">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Height" Value="320"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="pack://application:,,,/Assets/gateway.jpeg" Stretch="UniformToFill"/>
        <Rectangle Fill="#B0FFFFFF"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,20,0">
            <Button Click="Minimize_Click" Style="{StaticResource RoundTopButton}" Margin="0,0,10,0"
                    ToolTip="Minimize">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                        <GradientStop Color="#FFE9A6" Offset="0"/>
                                        <GradientStop Color="#E8B830" Offset="0.4"/>
                                        <GradientStop Color="#B8860B" Offset="0.85"/>
                                        <GradientStop Color="#8A6408" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="—" FontSize="18" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Click="Exit_Click" Style="{StaticResource RoundTopButton}" ToolTip="Exit">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                        <GradientStop Color="#FF7B8C" Offset="0"/>
                                        <GradientStop Color="#DC143C" Offset="0.5"/>
                                        <GradientStop Color="#8F0C25" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="White" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            <TextBlock x:Name="TimeText" Foreground="#DC143C" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="DateText" Foreground="#444444" FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,10,0,0">
            <TextBlock Text="CLIDA POS SYSTEM" Foreground="#DC143C" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="WelcomeText" Foreground="#444444" FontSize="14"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BackOfficeButton" Style="{StaticResource GatewayTile}"
                        Margin="0,0,30,0" Click="BackOffice_Click">
                    <Grid>
                        <Border CornerRadius="16" ClipToBounds="True" Background="White">
                            <Image Source="pack://application:,,,/Assets/back.png" Stretch="UniformToFill"/>
                        </Border>
                        <Border CornerRadius="16" BorderBrush="#DDDDDD" BorderThickness="1"/>
                        <Border Background="#F3A123" CornerRadius="8" Padding="18,10" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="6" Opacity="0.5"/>
                            </Border.Effect>
                            <TextBlock Text="BACK OFFICE" Foreground="Black" FontSize="24" FontWeight="ExtraBold"/>
                        </Border>
                    </Grid>
                </Button>

                <Button x:Name="FrontOfficeButton" Style="{StaticResource GatewayTile}"
                        Click="FrontOffice_Click">
                    <Grid>
                        <Border CornerRadius="16" ClipToBounds="True" Background="White">
                            <Image Source="pack://application:,,,/Assets/front.png" Stretch="UniformToFill"/>
                        </Border>
                        <Border CornerRadius="16" BorderBrush="#DDDDDD" BorderThickness="1"/>
                        <Border Background="#F3A123" CornerRadius="8" Padding="18,10" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="6" Opacity="0.5"/>
                            </Border.Effect>
                            <TextBlock Text="FRONT OFFICE" Foreground="Black" FontSize="24" FontWeight="ExtraBold"/>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>

            <Button x:Name="StartPeriodButton" Content="START PERIOD" Background="#F3A123"
                    Foreground="Black" FontWeight="Bold" FontSize="18" Padding="30,14"
                    Margin="0,40,0,0" HorizontalAlignment="Center" Click="StartPeriod_Click"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>