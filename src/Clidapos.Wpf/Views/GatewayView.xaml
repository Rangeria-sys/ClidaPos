<Window x:Class="Clidapos.Wpf.Views.GatewayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Gateway"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
	<Window.Resources>
		<!-- Each tile sets its own Background - the template just displays whatever
             color is given, and dims slightly on hover so it works for any color. -->
		<Style x:Key="GatewayTile" TargetType="Button">
			<Setter Property="Width" Value="400"/>
			<Setter Property="Height" Value="360"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="20">
							<Border.Effect>
								<DropShadowEffect Color="Black" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
							</Border.Effect>
							<ContentPresenter/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="B" Property="Opacity" Value="0.88"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- A normal soft drop shadow (offset + blur, not a zero-offset glow) - reads as
             a clean shadow rather than a hazy outline ring. -->
		<Style x:Key="StylishBoldText" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Segoe UI Black"/>
			<Setter Property="FontWeight" Value="ExtraBold"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="Black" Direction="315" ShadowDepth="2" BlurRadius="4" Opacity="0.65"/>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Dark, semi-transparent backing panel so header text stays readable no
             matter what part of the busy photo sits behind it - more reliable than
             any text effect. -->
		<Style x:Key="HeaderPanel" TargetType="Border">
			<Setter Property="Background" Value="#A6141414"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="16,10"/>
		</Style>

		<Style x:Key="GatewayTileLabel" TargetType="TextBlock" BasedOn="{StaticResource StylishBoldText}">
			<Setter Property="FontSize" Value="30"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,20,0,0"/>
		</Style>

		<Style x:Key="RoundTopButton" TargetType="Button">
			<Setter Property="Width" Value="44"/>
			<Setter Property="Height" Value="44"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Resources>
	<Grid Background="{StaticResource AppOverlay}">

		<Button Click="Back_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="56" Height="56" Background="Transparent" BorderThickness="0" Cursor="Hand"
                Margin="15,10,0,0" ToolTip="Back to Login">
			<Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform" Width="42" Height="42"/>
		</Button>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,20,0">
			<Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
				<Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform" Width="42" Height="42"/>
			</Button>
			<Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" ToolTip="Exit">
				<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform" Width="42" Height="42"/>
			</Button>
		</StackPanel>

		<Border Style="{StaticResource HeaderPanel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
			<StackPanel>
				<TextBlock x:Name="TimeText" Style="{StaticResource StylishBoldText}" FontSize="38"
                           HorizontalAlignment="Center"/>
				<TextBlock x:Name="DateText" Style="{StaticResource StylishBoldText}" FontFamily="Segoe UI Semibold"
                           FontSize="17" HorizontalAlignment="Center" Margin="0,2,0,0"/>
			</StackPanel>
		</Border>

		<Border Style="{StaticResource HeaderPanel}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,74,0,0">
			<StackPanel>
				<TextBlock x:Name="StoreNameText" Style="{StaticResource StylishBoldText}" FontSize="26"/>
				<TextBlock x:Name="WelcomeText" Foreground="#E8E8E8" FontFamily="Segoe UI Semibold" FontSize="15"/>
				<Border x:Name="ModeBadge" Background="#F3A123" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Left" Margin="0,8,0,0">
					<TextBlock x:Name="ModeText" Foreground="Black" FontFamily="Segoe UI Black" FontSize="12" FontWeight="Bold"/>
				</Border>
			</StackPanel>
		</Border>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Button x:Name="BackOfficeButton" Style="{StaticResource GatewayTile}"
                    Background="#219653" Margin="0,0,30,0" Click="BackOffice_Click">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<Image Source="pack://application:,,,/Assets/back.png" Width="210" Height="210" Stretch="Uniform"/>
					<TextBlock Text="BACK OFFICE" Style="{StaticResource GatewayTileLabel}"/>
				</StackPanel>
			</Button>

			<Button x:Name="FrontOfficeButton" Style="{StaticResource GatewayTile}"
                    Background="#1B4F91" Click="FrontOffice_Click">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<Image Source="pack://application:,,,/Assets/front.png" Width="210" Height="210" Stretch="Uniform"/>
					<TextBlock Text="FRONT OFFICE" Style="{StaticResource GatewayTileLabel}"/>
				</StackPanel>
			</Button>
		</StackPanel>
	</Grid>
</Window>