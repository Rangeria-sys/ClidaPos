<Window x:Class="Clidapos.Wpf.Views.JournalEntryListPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All Journal Entries"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="680" Height="520"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="Foreground" Value="#4A4A50"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
		<Border.Effect>
			<DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
		</Border.Effect>
		<Grid Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,0,0,16">
				<TextBlock Text="ALL JOURNAL ENTRIES" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
				<Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
					<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
				</Button>
			</Grid>

			<DataGrid Grid.Row="1" x:Name="EntryGrid" AutoGenerateColumns="False"
                      Background="White" BorderThickness="1" BorderBrush="#E4E4E8"
                      RowBackground="White" AlternatingRowBackground="#FAFAFB"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      IsReadOnly="True" SelectionMode="Single" Foreground="#1C1C1F" FontSize="12">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="110"/>
					<DataGridTextColumn Header="Debit Account" Binding="{Binding DebitAccount}" Width="*"/>
					<DataGridTextColumn Header="Credit Account" Binding="{Binding CreditAccount}" Width="*"/>
					<DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
					<DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>
	</Border>
</Window>