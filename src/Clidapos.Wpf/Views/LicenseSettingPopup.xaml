<Window x:Class="Clidapos.Wpf.Views.LicenseSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Activation" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Width="440" SizeToContent="Height"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B72"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,16">
                <TextBlock Text="LICENSE ACTIVATION" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
                </Button>
            </Grid>

            <Border Background="#FAFAFB" BorderBrush="#E4E4E8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="STATUS" Foreground="#8A8A92" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="ExpiryText" FontSize="12" Foreground="#6B6B72"/>
                </StackPanel>
            </Border>

            <TextBlock Text="License Key" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="LicenseKeyInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NotesInput" Style="{StaticResource PopupInput}" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Activate" Click="Activate_Click" Style="{StaticResource ActionBtn}" Background="#F3A123"/>
                <Button Grid.Column="2" Content="Deactivate" Click="Deactivate_Click" Style="{StaticResource ActionBtn}" Background="#6B6B72"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>