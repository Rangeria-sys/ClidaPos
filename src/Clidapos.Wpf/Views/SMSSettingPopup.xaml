<Window x:Class="Clidapos.Wpf.Views.SMSSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMS Gateway"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="480">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="SMS GATEWAY" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<TextBlock Style="{StaticResource PopupFieldLabel}" TextWrapping="Wrap" Margin="0,0,0,4">
							<Run Text="API URL "/>
							<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							<LineBreak/>
							<Run Text="Must include {phone} and {message} placeholders, e.g. https://api.provider.co.ke/send?apikey=XXX&amp;to={phone}&amp;message={message}" Foreground="#8A8A92" FontSize="11"/>
						</TextBlock>
						<TextBox x:Name="APIURLInput" Style="{StaticResource PopupInputRequired}" Margin="0,0,0,4"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>
						<TextBlock Text="Stored encrypted (your API key is embedded in this URL) - only the last 4 characters ever show. Clear and retype the full URL to change it."
                                   Foreground="#8A8A92" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Default" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" x:Name="IsDefaultInput" Style="{StaticResource PopupCombo}">
								<ComboBoxItem Content="Y"/>
								<ComboBoxItem Content="N"/>
							</ComboBox>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Enabled" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1" x:Name="IsEnabledInput" Style="{StaticResource PopupCombo}">
								<ComboBoxItem Content="Y"/>
								<ComboBoxItem Content="N"/>
							</ComboBox>
						</Grid>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button x:Name="NewBtn" Style="{StaticResource PopupIconButton}" Click="New_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/new.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="New" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="SaveBtn" Style="{StaticResource PopupIconButton}" Click="Save_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="UpdateBtn" Style="{StaticResource PopupIconButton}" Click="Update_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/edit.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Update" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button x:Name="DeleteBtn" Style="{StaticResource PopupIconButton}" Click="Delete_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/delete.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Delete" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="GetData_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/get.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Get Data" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
