<Window x:Class="Clidapos.Wpf.Views.ProfileSettingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Setting"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="440" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<Style x:Key="PopupInput" TargetType="TextBox">
			<Setter Property="Background" Value="#F5F5F7"/>
			<Setter Property="Foreground" Value="#1C1C1F"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style x:Key="ReadOnlyBox" TargetType="Border">
			<Setter Property="Background" Value="#F0F0F2"/>
			<Setter Property="BorderBrush" Value="#D8D8DE"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="10"/>
		</Style>

		<Style x:Key="IconActionButton" TargetType="Button">
			<Setter Property="Height" Value="52"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="B" Property="Opacity" Value="0.85"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="IconBtnText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Margin" Value="10,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
		<Border.Effect>
			<DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
		</Border.Effect>
		<StackPanel Margin="24">

			<Grid Margin="0,0,0,16">
				<TextBlock Text="MY PROFILE" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
				<Button Click="Close_Click" HorizontalAlignment="Right"
                        Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
					<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                           Width="28" Height="28"/>
				</Button>
			</Grid>

			<TextBlock Text="User ID" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<Border Style="{StaticResource ReadOnlyBox}" Margin="0,0,0,12">
				<TextBlock x:Name="UserIdText" FontSize="14" Foreground="#1C1C1F"/>
			</Border>

			<TextBlock Text="User Type" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<Border Style="{StaticResource ReadOnlyBox}" Margin="0,0,0,12">
				<TextBlock x:Name="UserTypeText" FontSize="14" Foreground="#1C1C1F"/>
			</Border>

			<TextBlock Text="Name" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="NameInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="PIN / Password" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="PasswordInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="Contact No" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="ContactInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="Email" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="EmailInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="SSN" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="SsnInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="Payroll Type" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="PayrollTypeInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="Card No" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="CardNoInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="Auto Logout" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<TextBox x:Name="AutoLogoutInput" Style="{StaticResource PopupInput}" Margin="0,0,0,12"/>

			<TextBlock Text="Joining Date" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
			<Border Style="{StaticResource ReadOnlyBox}" Margin="0,0,0,16">
				<TextBlock x:Name="JoiningDateText" FontSize="14" Foreground="#1C1C1F"/>
			</Border>

			<Button Style="{StaticResource IconActionButton}" Background="#F3A123" Click="Save_Click" Margin="0">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="💾" FontSize="18"/>
					<TextBlock Text="Save Changes" Style="{StaticResource IconBtnText}"/>
				</StackPanel>
			</Button>

			<TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
		</StackPanel>
	</Border>
</Window>