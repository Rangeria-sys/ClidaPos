<Window x:Class="Clidapos.Wpf.Views.StockAdjustmentListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clidapos - Pick a Product to Adjust"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <Style x:Key="RoundTopButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SearchInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F3A123"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#F3A123"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppOverlay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="Back_Click" Width="56" Height="56"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Margin="15,0,0,0" ToolTip="Back">
                    <Image Source="pack://application:,,,/Assets/back-arrow.png" Stretch="Uniform"
                           Width="42" Height="42"/>
                </Button>

                <TextBlock Grid.Column="1" Text="PICK A PRODUCT TO ADJUST" Foreground="#F3A123" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <Button Click="Minimize_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="Minimize">
                        <Image Source="pack://application:,,,/Assets/minimize.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>

                    <Button Click="Exit_Click" Width="56" Height="56" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Exit">
                        <Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                               Width="42" Height="42"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Style="{StaticResource SearchInput}"
                     Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"
                     Tag="Search by product name, code, or category..."/>

            <TextBlock Grid.Row="1" Text="Click a product to adjust its stock."
                       Foreground="#999999" FontSize="12" Margin="2,0,0,12"/>

            <Border Grid.Row="2" Background="#1A1A1F" CornerRadius="8" Padding="16">
                <DataGrid x:Name="StockGrid" AutoGenerateColumns="False"
                          Background="#1A1A1F" Foreground="White" BorderThickness="0"
                          RowBackground="#1A1A1F" AlternatingRowBackground="#22222A"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          IsReadOnly="True" SelectionMode="Single"
                          MouseDoubleClick="StockGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="120"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                        <DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse}" Width="180"/>
                        <DataGridTextColumn Header="Qty On Hand" Binding="{Binding Qty, StringFormat=N2}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>