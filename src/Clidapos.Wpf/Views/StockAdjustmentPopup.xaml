<Window x:Class="Clidapos.Wpf.Views.StockAdjustmentPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="440" SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PopupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PopupCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#1C1C1F"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ResultsList" TargetType="ListBox">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxHeight" Value="130"/>
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F2"/>
            <Setter Property="BorderBrush" Value="#D8D8DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtnText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#F3A123" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="24">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="STOCK ADJUSTMENT" FontSize="18" FontWeight="Bold" Foreground="#1C1C1F"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Width="30" Height="30" Background="Transparent" Foreground="#888888"
                        FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="Product" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource PopupInput}"
                     TextChanged="SearchBox_TextChanged" Margin="0,0,0,4"/>
            <ListBox x:Name="ResultsList" Style="{StaticResource ResultsList}"
                     SelectionChanged="ResultsList_SelectionChanged" Margin="0,0,0,4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ProductName}" FontSize="14" Padding="4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SelectedProductText" Foreground="#127C6B" FontSize="13" FontWeight="Bold"
                       Margin="0,0,0,14" TextWrapping="Wrap"/>

            <TextBlock Text="Current Quantity" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <Border Style="{StaticResource ReadOnlyBox}" Margin="0,0,0,14">
                <TextBlock x:Name="CurrentQtyText" Text="—" FontSize="16" FontWeight="Bold" Foreground="#1C1C1F"/>
            </Border>

            <TextBlock Text="Adjustment Type" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="TypeCombo" Style="{StaticResource PopupCombo}"
                      SelectionChanged="Recompute_Changed" Margin="0,0,0,14">
                <ComboBoxItem Content="Increase"/>
                <ComboBoxItem Content="Decrease"/>
            </ComboBox>

            <TextBlock Text="Adjust Quantity" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="QtyInput" Style="{StaticResource PopupInput}"
                     TextChanged="Recompute_Changed" Margin="0,0,0,14"/>

            <TextBlock Text="Final Quantity" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <Border Style="{StaticResource ReadOnlyBox}" Margin="0,0,0,14">
                <TextBlock x:Name="FinalQtyText" Text="—" FontSize="16" FontWeight="Bold" Foreground="#F3A123"/>
            </Border>

            <TextBlock Text="Reason" Foreground="#6B6B72" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="ReasonInput" Style="{StaticResource PopupInput}" Margin="0,0,0,16"/>

            <Button Style="{StaticResource IconActionButton}" Background="#F3A123" Click="Save_Click" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="18"/>
                    <TextBlock Text="Save Adjustment" Style="{StaticResource IconBtnText}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource IconActionButton}" Background="#17A398" Click="GetData_Click" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="18"/>
                    <TextBlock Text="Get Data" Style="{StaticResource IconBtnText}"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="ErrorText" Foreground="#D93838" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>