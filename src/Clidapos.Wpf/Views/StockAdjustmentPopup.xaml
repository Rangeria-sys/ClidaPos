<Window x:Class="Clidapos.Wpf.Views.StockAdjustmentPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#96000000"
        AllowsTransparency="True"
        ShowInTaskbar="False">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Styles/PopupStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="ResultsList" TargetType="ListBox">
				<Setter Property="Background" Value="#F5F5F7"/>
				<Setter Property="BorderBrush" Value="#D8D8DE"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="MaxHeight" Value="130"/>
			</Style>

			<Style x:Key="ReadOnlyBox" TargetType="Border">
				<Setter Property="Background" Value="#F0F0F3"/>
				<Setter Property="BorderBrush" Value="#D8D8DE"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="CornerRadius" Value="6"/>
				<Setter Property="Padding" Value="10,9"/>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="Transparent" MouseDown="Backdrop_MouseDown">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

			<Border Style="{StaticResource PopupCard}" Width="420">
				<StackPanel>

					<Border Style="{StaticResource PopupHeaderBar}" Background="#1A1A1F" Padding="18,14">
						<Grid>
							<TextBlock Text="STOCK ADJUSTMENT" Style="{StaticResource PopupTitle}" FontSize="17"/>
							<Button Click="Close_Click" HorizontalAlignment="Right"
                                    Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<Image Source="pack://application:,,,/Assets/exit_button.png" Stretch="Uniform"
                                       Width="26" Height="26"/>
							</Button>
						</Grid>
					</Border>

					<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
					<StackPanel Margin="20">

						<TextBlock Text="Product" Style="{StaticResource PopupFieldLabel}" Margin="0,0,0,4"/>
						<TextBox x:Name="SearchBox" Style="{StaticResource PopupInput}"
                                 TextChanged="SearchBox_TextChanged" Margin="0,0,0,4"/>
						<ListBox x:Name="ResultsList" Style="{StaticResource ResultsList}"
                                 SelectionChanged="ResultsList_SelectionChanged" Margin="0,0,0,4">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding ProductName}" FontSize="14" Padding="4"/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock x:Name="SelectedProductText" Foreground="#127C6B" FontSize="13" FontWeight="Bold"
                                   Margin="0,0,0,14" TextWrapping="Wrap"/>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Current Quantity" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<Border Grid.Column="1" Style="{StaticResource ReadOnlyBox}">
								<TextBlock x:Name="CurrentQtyText" Text="—" FontSize="14" FontWeight="Bold" Foreground="#1C1C1F"/>
							</Border>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Adjustment Type "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<ComboBox Grid.Column="1" x:Name="TypeCombo" Style="{StaticResource PopupCombo}"
                                      SelectionChanged="Recompute_Changed">
								<ComboBoxItem Content="Increase"/>
								<ComboBoxItem Content="Decrease"/>
							</ComboBox>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center">
								<Run Text="Adjust Quantity "/>
								<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
							</TextBlock>
							<TextBox Grid.Column="1" x:Name="QtyInput" Style="{StaticResource PopupInputRequired}"
                                     TextChanged="Recompute_Changed"/>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Final Quantity" Style="{StaticResource PopupFieldLabel}" Margin="0" VerticalAlignment="Center"/>
							<Border Grid.Column="1" Style="{StaticResource ReadOnlyBox}">
								<TextBlock x:Name="FinalQtyText" Text="—" FontSize="14" FontWeight="Bold" Foreground="#F3A123"/>
							</Border>
						</Grid>

						<TextBlock Style="{StaticResource PopupFieldLabel}" Margin="0,4,0,4">
							<Run Text="Reason "/>
							<Run Text="*" Style="{StaticResource PopupRequiredMark}"/>
						</TextBlock>
						<TextBox x:Name="ReasonInput" Style="{StaticResource PopupInputRequired}"/>

						<TextBlock x:Name="ErrorText" Style="{StaticResource PopupErrorText}"/>
					</StackPanel>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<StackPanel Margin="16,0,0,0" VerticalAlignment="Center">

				<Button Style="{StaticResource PopupIconButton}" Click="Save_Click">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/save.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Save" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource PopupIconButton}" Click="GetData_Click" Margin="0">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Image Source="pack://application:,,,/Assets/get.png" Width="34" Height="34" Stretch="Uniform"/>
						<TextBlock Text="Get Data" Style="{StaticResource PopupIconLabel}"/>
					</StackPanel>
				</Button>

			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
