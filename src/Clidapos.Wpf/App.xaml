<Application x:Class="Clidapos.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Clidapos.Wpf"
             StartupUri="Views/LoginView.xaml">
	<Application.Resources>
		<ImageBrush x:Key="AppBackground"
                    ImageSource="pack://application:,,,/Assets/gateway.jpeg"
                    Stretch="UniformToFill"/>
		<!-- Transparent so the photo's original colors show through with no dark wash. -->
		<SolidColorBrush x:Key="AppOverlay" Color="Transparent"/>

		<!-- Applies to every Window in the app automatically, since this has
             no x:Key - fixes the taskbar/Task Manager icon, which is a
             separate WPF setting from the ApplicationIcon in the .csproj
             (that one only controls the icon embedded in the .exe file
             itself, which is why File Explorer already showed it correctly
             while the running window's icon did not). -->
		<Style TargetType="Window">
			<Setter Property="Icon" Value="pack://application:,,,/Assets/app.ico"/>
		</Style>
	</Application.Resources>
</Application>